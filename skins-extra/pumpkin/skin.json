{
  "format": 1,
  "id": "pumpkin",
  "name": "Pumpkin Night",
  "author": "Radial Taskbar",
  "version": "1.0",
  "license": "Font Metamorphous: SIL Open Font License, see OFL.txt",
  "about": "A carved pumpkin by candlelight, gravestones, bats and fog under a big moon",
  "tags": ["season", "spooky", "night"],
  "preview": "preview.jpg",
  "style": {"shape": "orb", "material": "solid", "base": "#1A1030", "accent": "#FF8A1E", "accent2": "#8A5AE0", "text": "#FFE9C8", "border": "#6A4A9A", "opacity": 0.97, "corner": 10, "font": "Metamorphous", "open": "bloom", "speed": 1, "hoverGrow": 3, "iconZoom": 1.12, "glow": 0.5, "tilt": 0.5, "pointer": false, "burst": false, "shadow": 0.65, "dim": 0.46},
  "wheel": {"hub": 104, "thickness": 92, "gap": 5, "ringgap": 10, "rim": 34, "icon": 40, "crowd": 1.5, "area": 1.14, "hubkeep": 0.5},
  "colors": {"lit": "#FFD24A", "pale": "#FFE9C8"},
  "fonts": {"title": {"file": "Metamorphous-Regular.ttf", "family": "Metamorphous"}},
  "images": {
    "bat": {"file": "bat.png", "cols": 2},
    "face": {"file": "face.jpg", "light": true},
    "fog": "fog.png",
    "ghost": "ghost.png",
    "glow": {"file": "glow.jpg", "light": true},
    "halo": {"file": "halo.jpg", "light": true},
    "little": "little.png",
    "night": {"file": "night.jpg", "mask": "night-mask.png"},
    "pumpkin": {"file": "pumpkin.jpg", "mask": "pumpkin-mask.png"},
    "stones": {"file": "stones.jpg", "mask": "stones-mask.png", "cols": 3},
    "warm": {"file": "warm.jpg", "light": true}
  },
  "back": [
    {"shape": "circle", "x": 0.0, "y": 0.025, "size": 1.08, "fill": {"type": "radial", "stops": [[0, "black/70"], [0.86, "black/60"], [1, "black/0"]]}, "opacity": "sat(open)*0.95"},
    {"image": "night", "size": 1, "intro": {"time": 0.3, "ease": "out", "scale": 0.88}},
    {"image": "warm", "size": 1.1, "opacity": "0.35*(0.80+0.14*noise(time*6)+0.08*noise(time*17))"},
    {"image": "fog", "size": [0.95, 0.4], "x": "0.10*sin(time*0.25)", "y": 0.5, "opacity": "0.50"},
    {"image": "fog", "size": [0.9, 0.36], "x": "-0.12*sin(time*0.2+1)", "y": 0.66, "opacity": "0.55", "scale": ["-1", "1"]},
    {"image": "bat", "size": [0.1, 0.06], "angle": "time*13+10", "radius": "0.66+0.06*sin(time*1.3+10)", "y": "0.02*sin(time*5+10)", "frame": "floor(time*9+10)%2", "rotate": "10*sin(time*2+10)", "opacity": "smooth(0.3,0.6,time)"},
    {"image": "bat", "size": [0.075, 0.045], "angle": "time*13+34", "radius": "0.74+0.06*sin(time*1.3+34)", "y": "0.02*sin(time*5+34)", "frame": "floor(time*9+34)%2", "rotate": "10*sin(time*2+34)", "opacity": "smooth(0.3,0.6,time)"},
    {"image": "bat", "size": [0.085, 0.051000000000000004], "angle": "time*-10+200", "radius": "0.82+0.06*sin(time*1.3+200)", "y": "0.02*sin(time*5+200)", "frame": "floor(time*9+200)%2", "rotate": "10*sin(time*2+200)", "opacity": "smooth(0.3,0.6,time)"}
  ],
  "ring": [
    {"shape": "arc", "in": "px", "from": 0, "r": "ringout+5", "to": 360, "stroke": "#8A5AE0/40", "width": 1.4}
  ],
  "slot": {
    "intro": {"time": 0.36, "ease": "out", "delay": 0.08, "scale": 0.9, "y": 0.7, "stagger": 0.025, "order": "random"},
    "under": [
      {"image": "halo", "size": 1.9, "opacity": "0.50*hot+launch*1.5", "tint": "#7CFF9A"},
      {"image": "ghost", "size": [0.95, 1.14], "y": "-0.30-0.55*outback(sat(hot))-1.2*launch", "x": "0.06*sin(time*3+seed*6)", "opacity": "sat(hot*1.5)*0.92", "when": "hot>0.01"},
      {"image": "stones", "size": "1.16*(1+0.02*hot-0.03*press)", "frame": "(i+ring)%3", "rotate": "5*(seed-0.5)+1.5*sin(time*14)*launch", "detail": 1.04}
    ],
    "icon": {"size": 0.92, "y": 0.05, "zoom": 1.12, "shadow": {"y": 2, "blur": 3, "color": "black/65"}},
    "over": [
      {"image": "little", "size": 0.34, "x": -0.62, "y": 0.74, "when": "running", "opacity": "active ? 1 : 0.85"},
      {"image": "glow", "size": 0.8, "x": -0.62, "y": 0.76, "when": "active", "opacity": "0.6*(0.80+0.14*noise(time*6)+0.08*noise(time*17))"},
      {"image": "fog", "size": [1.3, 0.5], "y": 0.82, "x": "0.1*sin(time*0.6+seed*6)", "opacity": 0.35},
      {"shape": "circle", "x": 0.62, "y": -0.62, "size": 0.25, "fill": "#1A1030", "when": "numbers && number<10 && !kid", "stroke": "#FF8A1E", "width": 1.2},
      {"text": "{number}", "x": 0.62, "y": -0.63, "em": 0.3, "color": "pale", "font": "title", "weight": 700, "when": "numbers && number<10 && !kid"},
      {"shape": "poly", "points": [[-0.12, -0.838], [0, -0.94], [0.12, -0.838]], "stroke": "lit", "width": 2.2, "caps": true, "when": "group"}
    ],
    "marks": false,
    "chevron": false,
    "badge": false
  },
  "over": [
    {"shape": "circle", "x": 0.0, "y": 0.07, "size": 1.2, "fill": {"type": "radial", "stops": [[0, "black/70"], [0.8, "black/60"], [1, "black/0"]]}, "opacity": "sat(open)*0.95", "in": "hub"},
    {"image": "glow", "size": 0.5, "in": "hub", "angle": "sel", "radius": 1.02, "opacity": "on*(0.80+0.14*noise(time*6)+0.08*noise(time*17))"}
  ],
  "hub": [
    {"image": "glow", "size": 1.7, "opacity": "0.30*(0.80+0.14*noise(time*6)+0.08*noise(time*17))"},
    {"image": "pumpkin", "size": 1.06, "rotate": "2*sin(time*0.8)", "intro": {"time": 0.4, "ease": "back", "scale": 0.3, "rotate": -30}},
    {"image": "face", "size": 0.98, "rotate": "2*sin(time*0.8)", "opacity": "0.85*(0.80+0.14*noise(time*6)+0.08*noise(time*17))"},
    {"shape": "rect", "y": 0.075, "size": [0.74, 0.215], "corner": 10, "fill": "#170802/82", "stroke": "#FFB03A/70", "width": 1.4, "glow": 4, "glowcolor": "#FF7A14"},
    {"text": "{title}", "y": 0.035, "box": [1.38, 0.4], "px": 14, "color": "lit", "font": "title", "weight": 400, "wrap": true, "shadow": {"x": 0, "y": 0, "blur": 6, "color": "#FF6A0A"}},
    {"text": "{sub}", "y": 0.225, "box": [1.311, 0.2], "px": 9, "color": "#FFB84A", "font": "title", "weight": 400, "shadow": {"x": 0, "y": 0, "blur": 6, "color": "#FF6A0A"}},
    {"text": "{hh}:{mm}", "y": 0.035, "box": [1.38, 0.55], "px": 25, "color": "lit", "font": "title", "weight": 400, "opacity": "idle", "shadow": {"x": 0, "y": 0, "blur": 6, "color": "#FF6A0A"}},
    {"text": "{date}", "y": 0.225, "box": [1.311, 0.2], "px": 10, "color": "#FFB84A", "font": "title", "weight": 400, "opacity": "idle", "shadow": {"x": 0, "y": 0, "blur": 6, "color": "#FF6A0A"}}
  ],
  "pinbutton": {"in": "hub", "x": -0.8, "y": 0.7, "size": 10},
  "settingsbutton": {"in": "hub", "x": 0.8, "y": 0.7, "size": 10},
  "draw": {"clock": false, "shadow": false, "text": "#FFE9C8"},
  "tabs": {"inset": 40, "text": "#FFE9C8", "fill": "#000000/35", "on": "#8A5AE0"},
  "panel": {"fill": {"type": "linear", "stops": [[0, "#2E1A50"], [1, "#140A26"]]}, "stroke": "#FF8A1E", "width": 2.4, "corner": 12, "text": "pale"},
  "tag": {"fill": {"type": "linear", "stops": [[0, "#2E1A50"], [1, "#140A26"]]}, "stroke": "#FF8A1E", "width": 1.6, "corner": 9, "text": "pale"},
  "tile": {"fill": {"type": "linear", "stops": [[0, "#6A6C82"], [1, "#3E3F4C"]]}, "stroke": "#1A1030", "width": 2.4, "corner": 16, "text": "pale"},
  "particles": [
    {"color": "#FF9A3A", "light": true, "rate": 2, "max": 16, "area": "hub", "life": [1.2, 2.2], "size": [1.5, 3], "speed": [10, 30], "dir": [-30, 30], "gravity": -30, "sway": 10, "swayhz": 1, "fadein": 0.2, "fadeout": 0.5}
  ],
  "onlaunch": [
    {"image": "bat", "count": 16, "area": "slot", "life": [0.6, 1.2], "size": [14, 30], "speed": [140, 460], "outward": true, "dir": [-120, 120], "gravity": -80, "drag": 1.2, "sway": 20, "swayhz": 3, "fadein": 0, "fadeout": 0.4},
    {"color": "#FF8A1E", "light": true, "count": 20, "area": "slot", "life": [0.3, 0.7], "size": [2, 4], "speed": [80, 320], "outward": true, "dir": [-120, 120], "gravity": -80, "drag": 2, "fadein": 0, "fadeout": 0.6}
  ],
  "sounds": {"open": "open.wav", "move": "move.wav", "launch": "launch.wav", "close": "close.wav"}
}
