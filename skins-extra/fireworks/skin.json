  "slot": {
    "intro": {"time": 0.36, "ease": "out", "delay": 0.05, "scale": 0.1, "y": 1.4, "stagger": 0.02, "order": "random"},
    "under": [
      {"image": "halo", "size": 1.8, "opacity": "0.35*hot+launch*2", "tint": "#FFD27A"},
      {"image": "sparkler", "size": "1.55+0.10*noise(time*9)", "rotate": "time*50+120*rnd(floor(time*16))", "opacity": "sat(hot)*(0.75+0.35*noise(time*22+i))"},
      {"image": "slot", "size": "1.04*(1+0.04*hot-0.03*press)", "detail": 1.06}
    ],
    "icon": {"size": 1.04, "zoom": 1.16, "shadow": {"y": 2, "blur": 3, "color": "black/60"}},
    "over": [
      {"image": "burst1", "size": "0.4+3.2*outcubic(sat(launch*1.4))", "tint": "#FFD27A", "opacity": "launch*(1.2-launch)*3", "when": "launch>0.01"},
      {"image": "burst3", "size": "0.3+2.4*outcubic(sat(launch*1.4))", "tint": "#FF6AB0", "opacity": "launch*(1.2-launch)*3", "when": "launch>0.01"},
      {"shape": "circle", "y": 0.92, "size": 0.15, "fill": "#FFD27A", "when": "running", "opacity": "active ? 1 : 0.75", "glow": 4, "glowcolor": "#FFFFFF"},
      {"shape": "circle", "y": 0.92, "size": 0.0825, "fill": "#FFFFFF", "when": "running", "opacity": "active ? 1 : 0.35+0.35*wave(time*0.5+seed)"},
      {"shape": "circle", "x": 0.7, "y": -0.7, "size": 0.25, "fill": "#0A0E2E", "when": "numbers && number<10 && !kid", "stroke": "#C99A45", "width": 1.2},
      {"text": "{number}", "x": 0.7, "y": -0.71, "em": 0.3, "color": "pale", "font": "title", "weight": 700, "when": "numbers && number<10 && !kid"},
      {"shape": "poly", "points": [[-0.12, -0.838], [0, -0.94], [0.12, -0.838]], "stroke": "gold", "width": 2.2, "caps": true, "when": "group"}
    ],
    "marks": false,
    "chevron": false,
    "badge": false
