#include <windows.h>

1 ICON "../res/app.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "../res/app.manifest"
100 RCDATA "RadialTaskbar.exe"
101 RCDATA "skins.pak"
102 RCDATA "Uninstall.exe"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Radial Taskbar Setup"
      VALUE "FileVersion", "1.0.0"
      VALUE "InternalName", "RadialTaskbarSetup"
      VALUE "OriginalFilename", "RadialTaskbar-Setup.exe"
      VALUE "ProductName", "Radial Taskbar"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
