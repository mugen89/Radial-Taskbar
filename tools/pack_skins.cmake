# Packs skins/<id>/ into <out>/pak/<id>.rskin and everything together into <out>/skins.pak.
file(REMOVE_RECURSE "${OUT}/pak")
file(MAKE_DIRECTORY "${OUT}/pak")
file(GLOB dirs LIST_DIRECTORIES true "${SRC}/skins/*")
foreach(d ${dirs})
  if(EXISTS "${d}/skin.json")
    get_filename_component(id "${d}" NAME)
    execute_process(COMMAND "${EXE}" --pack-skin "${d}" "${OUT}/pak/${id}.rskin" RESULT_VARIABLE rc)
    if(NOT rc EQUAL 0)
      message(FATAL_ERROR "packing ${id} failed (${rc})")
    endif()
  endif()
endforeach()
file(COPY "${SRC}/SKINS.md" DESTINATION "${OUT}/pak")
execute_process(COMMAND "${EXE}" --pack-skin "${OUT}/pak" "${OUT}/skins.pak" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "packing the skins failed (${rc})")
endif()
