{
  "format": 1,
  "id": "aperture",
  "name": "Aperture",
  "author": "Radial Taskbar",
  "version": "1.0",
  "about": "The front of a camera lens: coated glass for every app, numbers on the barrel, an iris that opens around the name",
  "tags": ["photo", "dark", "precise"],
  "preview": "preview.jpg",
  "style": {"shape": "orb", "material": "solid", "base": "#0E0E12", "accent": "#E0E0E8", "accent2": "#B48CFF", "text": "#F4F4F8", "border": "#E0E0E8", "opacity": 0.98, "corner": 14, "font": "Bahnschrift", "open": "zoom", "speed": 0.85, "hoverGrow": 3, "iconZoom": 1.12, "glow": 0, "tilt": 0.3, "pointer": false, "burst": false, "shadow": 0.5, "dim": 0.5},
  "wheel": {"hub": 90, "thickness": 92, "gap": 5, "ringgap": 10, "rim": 32, "icon": 42, "crowd": 1.45, "area": 1.1, "hubkeep": 0.76},
  "colors": {"text": "#F4F4F8", "sub": "#B8B8C4"},
  "fonts": {"title": "Bahnschrift, Segoe UI"},
  "images": {
    "barrel": {"file": "barrel.jpg", "mask": "barrel-mask.png"},
    "elements": {"file": "elements.png", "cols": 2},
    "halo": {"file": "halo.jpg", "light": true},
    "index": "index.png",
    "iris": "iris.png",
    "well": {"file": "well.jpg", "mask": "well-mask.png"}
  },
  "back": [
    {"shape": "circle", "x": 0.0, "y": 0.03, "size": 1.08, "fill": {"type": "radial", "stops": [[0, "black/70"], [0.86, "black/60"], [1, "black/0"]]}, "opacity": "sat(open)*0.95"},
    {"image": "barrel", "size": 1.0, "rotate": "(1-open)*-40", "intro": {"time": 0.45, "ease": "out", "scale": 0.92}}
  ],
  "slot": {
    "intro": {"time": 0.42, "ease": "back", "delay": 0.06, "scale": 0.3, "stagger": 0.02, "order": "both"},
    "under": [
      {"image": "halo", "size": 1.6, "opacity": "hot*0.5", "when": "hot>0.02", "scale": "(1.6*hot)/1.6"},
      {"image": "elements", "size": "1.0*(1+0.05*hot-0.04*press)", "frame": "hot>0.5 ? 1 : 0"}
    ],
    "icon": {"size": 0.6, "zoom": 1.16, "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/50"}},
    "over": [
      {"shape": "circle", "y": 0.92, "size": 0.15, "fill": "#E0E0E8", "when": "running", "opacity": "active ? 1 : 0.75", "glow": 4, "glowcolor": "#B48CFF"},
      {"shape": "circle", "y": 0.92, "size": 0.0825, "fill": "#B48CFF", "when": "running", "opacity": "active ? 1 : 0.35+0.35*wave(time*0.5+seed)"},
      {"shape": "circle", "x": 0.64, "y": -0.64, "size": 0.25, "fill": "#E0E0E8", "when": "numbers && number<10 && !kid"},
      {"text": "{number}", "x": 0.64, "y": -0.65, "em": 0.3, "color": "#0E0E12", "font": "title", "weight": 700, "when": "numbers && number<10 && !kid"},
      {"shape": "poly", "points": [[-0.12, -0.6980000000000001], [0, -0.8], [0.12, -0.6980000000000001]], "stroke": "#F4F4F8", "width": 2.2, "caps": true, "when": "group"}
    ],
    "marks": false,
    "chevron": false,
    "badge": false
  },
  "over": [
    {"image": "index", "size": [0.05, 0.075], "in": "hub", "angle": "sel", "radius": 1.1, "rotate": "sel", "opacity": "on"}
  ],
  "hub": [
    {"image": "well", "size": 1.0, "intro": {"time": 0.4, "ease": "back", "scale": 0.6}},
    {"text": "{title}", "y": -0.05, "box": [1.26, 0.6], "px": 17, "color": "text", "font": "title", "weight": 700, "wrap": true, "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/70"}},
    {"text": "{sub}", "y": 0.28, "box": [1.1969999999999998, 0.2], "px": 11.5, "color": "sub", "font": "title", "weight": 700, "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/70"}},
    {"text": "{hh}:{mm}", "y": -0.08, "box": [1.26, 0.55], "px": 31, "color": "text", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/70"}},
    {"text": "{date}", "y": 0.21, "box": [1.1969999999999998, 0.2], "px": 12, "color": "sub", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/70"}}
  ],
  "front": [
    {"image": "iris", "size": "1.0+1.8*sat(open)", "in": "hub", "rotate": "sat(open)*70", "opacity": "1-sat(open*1.15)"}
  ],
  "draw": {"clock": false, "shadow": false, "text": "text"},
  "tabs": {"inset": 13, "text": "text", "fill": "#F4F4F8/14", "on": "#E0E0E8/85"},
  "panel": {"fill": {"type": "linear", "stops": [[0, "#1E1E24"], [1, "#0E0E12"]]}, "stroke": "#5A5A66", "width": 3, "corner": 14, "text": "text"},
  "tag": {"fill": {"type": "linear", "stops": [[0, "#1E1E24"], [1, "#0E0E12"]]}, "stroke": "#5A5A66", "width": 2, "corner": 13, "text": "text"},
  "tile": {"fill": {"type": "linear", "stops": [[0, "#E8E8EE"], [1, "#C8C8D0"]]}, "stroke": "#5A5A66", "width": 2.4, "corner": 12, "text": "#0E0E12"},
  "onlaunch": [
    {"color": "#FFFFFF", "count": 1, "area": "slot", "life": [0.18, 0.18], "size": [80, 80], "grow": 1.4, "speed": [0, 0], "opacity": 0.5, "fadein": 0, "fadeout": 1}
  ],
  "sounds": {"open": "open.wav", "move": "move.wav", "launch": "launch.wav", "close": "close.wav"}
}
