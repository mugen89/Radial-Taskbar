{
  "format": 1,
  "id": "runestone",
  "name": "Runestone",
  "author": "Radial Taskbar",
  "version": "1.0",
  "license": "Artwork: same as the program. Lettering: Metamorphous, SIL Open Font License (OFL.txt)",
  "about": "A broken stone disc from an old ruin, held together by iron, torchlight and what was carved into it",
  "tags": ["fantasy", "stone", "runes", "magic"],

  "style": {
    "shape": "orb", "material": "solid", "base": "#1B2022", "accent": "#14E6C6", "accent2": "#FF9A2E", "text": "#EAF3EE", "border": "#7E8A86",
    "opacity": 0.97, "corner": 8, "font": "title", "open": "bloom", "speed": 1, "hoverGrow": 4, "iconZoom": 1.10, "glow": 0.5,
    "tilt": 0.5, "pointer": false, "burst": false, "shadow": 0.7, "dim": 0.40
  },
  "wheel": { "hub": 98, "thickness": 90, "gap": 5, "ringgap": 52, "rim": 48, "icon": 44, "crowd": 1.46, "area": [1.38, 1.14, 1.38, 1.14], "hubkeep": 0.76 },
  "colors": { "bone": "#E9DFC8", "ink": "#1A1712", "magic": "#14E6C6", "pale": "#E6FFF8", "deep": "#03100F" },
  "fonts": { "title": { "file": "Metamorphous-Regular.ttf", "family": "Palatino Linotype, Georgia" }, "glyphs": "Segoe Fluent Icons, Segoe MDL2 Assets" },

  "images": {
    "piece0": { "file": "piece0.jpg", "mask": "piece0-mask.png" },
    "piece1": { "file": "piece1.jpg", "mask": "piece1-mask.png" },
    "piece2": { "file": "piece2.jpg", "mask": "piece2-mask.png" },
    "piece3": { "file": "piece3.jpg", "mask": "piece3-mask.png" },
    "piece4": { "file": "piece4.jpg", "mask": "piece4-mask.png" },
    "hoop": { "file": "hoop.jpg", "mask": "hoop-mask.png" },
    "outer": { "file": "outer.jpg", "mask": "outer-mask.png" },
    "cracklight": { "file": "cracklight.jpg", "light": true },
    "runes": { "file": "runes.jpg", "cols": 8, "rows": 3, "light": true },
    "boss": { "file": "boss.jpg", "mask": "boss-mask.png", "cols": 2, "rows": 2 },
    "bosslight": { "file": "bosslight.jpg", "cols": 2, "rows": 2, "light": true },
    "halo": { "file": "halo.jpg", "light": true },
    "coal": "coal.png",
    "coal_on": "coal_on.png",
    "glow": { "file": "glow.jpg", "light": true },
    "knot": "knot.png",
    "stud": "stud.png",
    "basin": { "file": "basin.jpg", "mask": "basin-mask.png" },
    "dial": { "file": "dial.jpg", "mask": "dial-mask.png" },
    "diallight": { "file": "diallight.jpg", "light": true },
    "dialshade": "dialshade.png",
    "swirl1": { "file": "swirl1.jpg", "light": true },
    "swirl2": { "file": "swirl2.jpg", "light": true },
    "torch": { "file": "torch.jpg", "mask": "torch-mask.png", "cols": 2, "keep": true },
    "flame": { "file": "flame.jpg", "mask": "flame-mask.png", "cols": 4, "rows": 4, "keep": true },
    "firelight": { "file": "firelight.jpg", "light": true, "keep": true },
    "spark": { "file": "spark.png", "light": true },
    "cinder": { "file": "cinder.png", "light": true, "keep": true },
    "dust": "dust.png",
    "chip": "chip.png",
    "slab": "slab.jpg",
    "tablet": { "file": "tablet.jpg", "mask": "tablet-mask.png" },
    "lintel": { "file": "lintel.jpg", "mask": "lintel-mask.png" }
  },

  // torches on both sides, in iron brackets
  "back": [
    { "shape": "circle", "y": 0.035, "size": 1.12, "fill": { "type": "radial", "stops": [[0, "black/80"], [0.86, "black/70"], [1, "black/0"]] }, "opacity": "open" },
    { "image": "firelight", "in": "px", "x": "-(radius+22)", "y": -52, "size": 190, "opacity": "smooth(0.3,0.5,max(time,1-motion))*(0.34+0.16*noise(time*6))" },
    { "image": "firelight", "in": "px", "x": "radius+22", "y": -52, "size": 190, "opacity": "smooth(0.3,0.5,max(time,1-motion))*(0.34+0.16*noise(time*6+40))" },
    { "image": "torch", "in": "px", "frame": 0, "x": "-(radius+20)", "y": 22, "size": 62, "depth": 0.35, "intro": { "delay": 0.10, "time": 0.30, "ease": "back", "x": 46, "rotate": -20 } },
    { "image": "torch", "in": "px", "frame": 1, "x": "radius+20", "y": 22, "size": 62, "depth": 0.35, "intro": { "delay": 0.13, "time": 0.30, "ease": "back", "x": -46, "rotate": 20 } },
    { "image": "flame", "in": "px", "fps": 15, "x": "-(radius+24)", "y": -22, "size": 50, "pivot": [0.5, 0.95], "depth": 0.35, "scale": ["1", "0.9+0.2*noise(time*5)"], "intro": { "delay": 0.28, "time": 0.20, "ease": "back", "scale": 0.1 } },
    { "image": "flame", "in": "px", "fps": 15, "frame": 7, "x": "radius+24", "y": -22, "size": 50, "pivot": [0.5, 0.95], "depth": 0.35, "scale": ["-1", "0.9+0.2*noise(time*5+40)"], "intro": { "delay": 0.32, "time": 0.20, "ease": "back", "scale": 0.1 } }
  ],

  "ring": [
    { "shape": "circle", "x": 0.012, "y": 0.030, "size": 1.075, "fill": { "type": "radial", "stops": [[0, "black/85"], [0.90, "black/75"], [1, "black/0"]] }, "opacity": "smooth(0.1,0.9,open)" },
    { "image": "outer", "size": 1, "when": "ring>0", "intro": { "time": 0.40, "ease": "quint", "scale": 0.80, "rotate": -38 } },
    { "image": "piece0", "when": "ring<1", "x": -0.23, "y": -0.50, "size": [0.71, 0.50], "intro": { "time": 0.44, "ease": "quint", "x": -0.10, "y": -0.34, "rotate": -9 } },
    { "image": "piece1", "when": "ring<1", "x": 0.50, "y": -0.39, "size": [0.50, 0.51], "intro": { "delay": 0.02, "time": 0.44, "ease": "quint", "x": 0.30, "y": -0.22, "rotate": 11 } },
    { "image": "piece2", "when": "ring<1", "x": 0.50, "y": 0.39, "size": [0.50, 0.51], "intro": { "delay": 0.04, "time": 0.44, "ease": "quint", "x": 0.30, "y": 0.26, "rotate": -10 } },
    { "image": "piece3", "when": "ring<1", "x": -0.21, "y": 0.50, "size": [0.63, 0.50], "intro": { "delay": 0.03, "time": 0.44, "ease": "quint", "x": -0.14, "y": 0.34, "rotate": 10 } },
    { "image": "piece4", "when": "ring<1", "x": -0.50, "y": 0.06, "size": [0.50, 0.54], "intro": { "delay": 0.05, "time": 0.44, "ease": "quint", "x": -0.34, "y": 0.02, "rotate": -8 } },
    { "image": "cracklight", "when": "ring<1", "size": 1, "opacity": "motion*(smooth(0.10,0.24,time)*(1-smooth(0.30,0.85,time)))*1.2+0.08*wave(time*0.16)+1.2*sat(launch*5)" },
    { "image": "hoop", "when": "ring<1", "size": 1, "intro": { "delay": 0.14, "time": 0.30, "ease": "bounce", "scale": 1.30, "rotate": 24 } },
    { "image": "runes", "when": "ring<1", "frame": "j", "copies": 24, "angle": "j*15", "radius": 0.8505, "size": 0.062, "turns": true,
      "opacity": "0.10+0.14*noise(time*0.8+j*1.7)+0.95*on*exp(0-pow(abs(wrap(j*15-sel))/30,2))+motion*1.1*exp(0-pow(abs(time-0.16-j*0.010)/0.07,2))+1.2*sat(launch*6)" },
    { "image": "runes", "when": "ring>0", "frame": "j*5", "copies": 38, "angle": "j*360/38", "radius": 0.904, "size": 0.0398, "turns": true,
      "opacity": "0.10+0.14*noise(time*0.8+j*1.3)+0.95*on*exp(0-pow(abs(wrap(j*360/38-sel))/24,2))+motion*1.1*exp(0-pow(abs(time-0.16-j*0.0065)/0.07,2))+1.2*sat(launch*6)" }
  ],

  "slot": {
    "intro": { "delay": 0.08, "time": 0.28, "ease": "back", "scale": 0.1, "rotate": -80, "stagger": 0.013, "order": "ring" },
    "under": [
      { "shape": "circle", "x": "0.05+0.06*hot", "y": "0.08+0.10*hot", "size": 1.12, "fill": { "type": "radial", "stops": [[0, "black/85"], [0.80, "black/72"], [1, "black/0"]] } },
      { "image": "halo", "size": 1.8, "opacity": "0.85*hot+0.9*launch" },
      { "image": "boss", "frame": "floor(seed*3.999)", "size": 0.98, "scale": "1+0.05*hot-0.06*press", "detail": 1.08 },
      { "image": "bosslight", "frame": "floor(seed*3.999)", "size": 0.98, "scale": "1+0.05*hot-0.06*press", "detail": 1.08,
        "opacity": "hot*(0.88+0.12*noise(time*8+i*3))+0.20*near*(1-hot)+motion*0.9*exp(0-pow(abs(time-0.27-i/n*0.14)/0.07,2))+1.6*launch" }
    ],
    "icon": { "size": 0.92, "zoom": 1.10, "shadow": { "x": 1, "y": 2, "blur": 3, "color": "black/75" } },
    "over": [
      { "image": "coal", "copies": "running*min(windows,3)", "x": "(j-(m-1)/2)*0.24", "y": "0.82-0.03*(m>2)*(j!=1)", "size": 0.18 },
      { "image": "coal_on", "copies": "running*min(windows,3)", "x": "(j-(m-1)/2)*0.24", "y": "0.82-0.03*(m>2)*(j!=1)", "size": 0.18, "opacity": "active ? 0.88+0.12*noise(time*7) : 0.45+0.25*noise(time*1.8+seed*9+j*4)" },
      { "image": "glow", "copies": "running*min(windows,3)", "x": "(j-(m-1)/2)*0.24", "y": 0.82, "size": 0.48, "opacity": "active ? 0.75+0.25*noise(time*7) : 0.22" },
      { "image": "knot", "angle": "a", "radius": 0.86, "size": 0.25, "when": "group" },
      { "shape": "circle", "x": 0.70, "y": -0.70, "size": 0.23, "fill": { "type": "radial", "from": [-0.3, -0.4], "radius": 1.5, "stops": [[0, "#F6EEDB"], [1, "#A8997A"]] }, "stroke": "#2A241A", "width": 1.4, "when": "numbers && number<10 && !kid" },
      { "text": "{number}", "x": 0.70, "y": -0.71, "em": 0.27, "color": "ink", "font": "title", "when": "numbers && number<10 && !kid" }
    ],
    "marks": false, "chevron": false, "badge": false
  },

  "fan": [
    { "shape": "ring", "inner": "ringin-7", "outer": "ringout+9", "from": "a-span/2-3", "to": "a+span/2+3", "corner": 18, "x": 2, "y": 5, "fill": "black/55", "opacity": "in" },
    { "shape": "ring", "inner": "ringin-7", "outer": "ringout+7", "from": "a-span/2-3", "to": "a+span/2+3", "corner": 18, "fill": { "image": "slab", "tile": true, "zoom": 100 }, "stroke": { "type": "linear", "from": [-0.7, -0.7], "to": [0.7, 0.7], "stops": [[0, "#8C9092"], [0.5, "#3A3E40"], [1, "#16181A"]] }, "width": 2.4 },
    { "shape": "ring", "inner": "ringin-2", "outer": "ringout+2", "from": "a-span/2-1.6", "to": "a+span/2+1.6", "corner": 14, "fill": "none", "stroke": "#0A0C0D/80", "width": 2 }
  ],

  "over": [
    { "image": "firelight", "in": "px", "x": "-(radius*0.86)", "y": -40, "size": "radius*0.9", "opacity": "smooth(0.3,0.5,max(time,1-motion))*(0.20+0.10*noise(time*6))" },
    { "image": "firelight", "in": "px", "x": "radius*0.86", "y": -40, "size": "radius*0.9", "opacity": "smooth(0.3,0.5,max(time,1-motion))*(0.20+0.10*noise(time*6+40))" },
    { "shape": "circle", "in": "hub", "x": 0.03, "y": 0.06, "size": 1.24, "fill": { "type": "radial", "stops": [[0, "black/85"], [0.84, "black/70"], [1, "black/0"]] }, "opacity": "open" },
    { "image": "basin", "in": "hub", "size": 1.12, "intro": { "time": 0.36, "ease": "out", "scale": 0.6, "rotate": 90 } }
  ],

  "hub": [
    { "image": "swirl2", "size": 0.77, "rotate": "time*-11", "scale": "1+0.02*sin(time*0.9)", "depth": -0.3, "opacity": "0.75+0.15*on+0.8*sat(launch*5)", "intro": { "delay": 0.14, "time": 0.4, "ease": "out", "scale": 0.3, "rotate": 160 } },
    { "image": "swirl1", "size": 0.77, "rotate": "time*17", "depth": -0.15, "opacity": "0.65+0.20*noise(time*1.1)+0.8*sat(launch*5)", "intro": { "delay": 0.14, "time": 0.4, "ease": "out", "scale": 0.3, "rotate": -200 } },
    { "shape": "circle", "size": 0.80, "fill": { "type": "radial", "stops": [[0, "deep/92"], [0.5, "deep/78"], [0.82, "deep/20"], [1, "deep/0"]] }, "opacity": "0.78+0.18*(1-idle)" },
    { "image": "dial", "size": 1.20, "rotate": "sel", "intro": { "time": 0.42, "ease": "out", "scale": 0.7, "rotate": -220 } },
    { "image": "dialshade", "size": 1.20, "opacity": "open" },
    { "image": "diallight", "size": 1.20, "rotate": "sel", "opacity": "smooth(0.2,0.5,max(time,1-motion))*(0.50+0.30*on+0.20*noise(time*2.2))+sat(launch*5)", "intro": { "time": 0.42, "ease": "out", "scale": 0.7, "rotate": -220 } },
    { "text": "{time}", "y": -0.06, "px": 25, "font": "title", "color": "pale", "opacity": "idle", "shadow": { "x": 0, "y": 0, "blur": 5, "color": "magic/80" } },
    { "text": "{date}", "y": 0.20, "px": 10.5, "font": "title", "color": "pale/75", "opacity": "idle" },
    { "text": "{title}", "y": -0.05, "box": [1.14, 0.56], "px": 17, "font": "title", "color": "pale", "wrap": true, "depth": 0.15, "shadow": { "x": 0, "y": 0, "blur": 5, "color": "magic/85" } },
    { "text": "{sub}", "y": 0.34, "box": [0.96, 0.16], "px": 10.5, "font": "title", "color": "#9FE8DA", "depth": 0.15 }
  ],

  "draw": { "clock": false, "shadow": false, "fan": false },
  "tabs": { "inset": 14, "text": "#CFEDE6", "fill": "#0C2E2C/70", "on": "#178F80" },

  "pinbutton": { "in": "hub", "x": -0.18, "y": 0.58, "size": 13, "layers": [
    { "image": "stud", "size": 0.96, "scale": "1+0.08*hot" },
    { "text": "", "px": 12, "font": "glyphs", "color": "pale", "opacity": "0.75+0.25*hot" } ] },
  "settingsbutton": { "in": "hub", "x": 0.18, "y": 0.58, "size": 13, "layers": [
    { "image": "stud", "size": 0.96, "scale": "1+0.08*hot" },
    { "text": "", "px": 12, "font": "glyphs", "color": "pale", "opacity": "0.75+0.25*hot" } ] },

  "panel": { "fill": { "image": "slab", "tile": true, "zoom": 1.25 }, "stroke": { "type": "linear", "from": [-0.6, -1], "to": [0.6, 1], "stops": [[0, "#9A9D9C"], [0.5, "#4A4E50"], [1, "#1C1F21"]] }, "width": 3, "corner": 9, "text": "bone" },
  "tag": { "image": "lintel", "cut": [60, 34, 60, 34], "scale": 0.46, "pad": [6, 5, 6, 5], "text": "pale" },
  "tile": { "image": "tablet", "cut": 46, "scale": 0.42, "pad": 2, "text": "bone" },

  "particles": [
    { "image": "cinder", "light": true, "rate": "3", "max": 16, "area": "rim", "life": [1.4, 2.6], "size": [2.5, 5], "speed": [8, 26], "dir": [-25, 25], "gravity": -26, "drag": 0.5, "sway": 16, "swayhz": 0.7, "fadein": 0.2, "fadeout": 0.6, "opacity": 0.9 },
    { "image": "spark", "light": true, "rate": "on*14", "max": 24, "area": "slot", "life": [0.6, 1.2], "size": [3, 7], "speed": [10, 40], "dir": [-30, 30], "gravity": -60, "drag": 0.8, "sway": 14, "swayhz": 1.1, "fadein": 0.15, "fadeout": 0.6 }
  ],
  "onopen": [
    { "image": "dust", "count": 26, "area": "rim", "outward": true, "life": [0.35, 0.8], "size": [14, 34], "grow": 2.2, "speed": [10, 80], "dir": [-60, 60], "drag": 3, "spin": [-60, 60], "opacity": 0.55, "fadein": 0.2, "fadeout": 0.7 },
    { "image": "chip", "count": 10, "area": "rim", "outward": true, "life": [0.4, 0.7], "size": [4, 9], "speed": [40, 160], "dir": [-50, 50], "gravity": 420, "spin": [-400, 400], "fadein": 0, "fadeout": 0.4 }
  ],
  "onhover": [
    { "image": "spark", "light": true, "count": 7, "area": "slot", "life": [0.4, 0.9], "size": [3, 7], "speed": [20, 70], "dir": [-40, 40], "gravity": -70, "drag": 1.5, "fadein": 0.1, "fadeout": 0.6 }
  ],
  "onlaunch": [
    { "image": "spark", "light": true, "count": 46, "area": "slot", "outward": true, "life": [0.25, 0.7], "size": [4, 11], "speed": [80, 420], "dir": [-80, 80], "drag": 3, "gravity": -40, "fadein": 0.02, "fadeout": 0.6 },
    { "image": "chip", "count": 8, "area": "slot", "outward": true, "life": [0.35, 0.6], "size": [4, 8], "speed": [60, 220], "dir": [-50, 50], "gravity": 600, "spin": [-500, 500], "fadein": 0, "fadeout": 0.4 }
  ],
  "sounds": { "open": "open.wav", "move": "move.wav", "launch": "launch.wav", "close": "close.wav" }
}
