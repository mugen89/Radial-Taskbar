{
  "format": 1,
  "id": "folk",
  "name": "Folk Pattern",
  "author": "Radial Taskbar",
  "version": "1.0",
  "about": "Red, black and white Balkan cross-stitch in bands and rosettes, inside a carved wooden frame",
  "tags": ["folk", "red", "craft"],
  "preview": "preview.jpg",
  "style": {"shape": "orb", "material": "solid", "base": "#F4EEE2", "accent": "#B8202A", "accent2": "#1A1A1A", "text": "#1A1A1A", "border": "#B8202A", "opacity": 0.98, "corner": 14, "font": "Constantia", "open": "unfold", "speed": 0.9, "hoverGrow": 3, "iconZoom": 1.12, "glow": 0, "tilt": 0.25, "pointer": false, "burst": false, "shadow": 0.5, "dim": 0.25},
  "wheel": {"hub": 90, "thickness": 92, "gap": 5, "ringgap": 10, "rim": 32, "icon": 42, "crowd": 1.45, "area": 1.1, "hubkeep": 0.76},
  "colors": {"text": "#1A1A1A", "sub": "#5A2A22"},
  "fonts": {"title": "Constantia, Georgia"},
  "images": {
    "centre": {"file": "centre.jpg", "mask": "centre-mask.png"},
    "cloth": {"file": "cloth.jpg", "mask": "cloth-mask.png"},
    "halo": {"file": "halo.jpg", "light": true},
    "motif": "motif.png",
    "rosettes": {"file": "rosettes.png", "cols": 2}
  },
  "back": [
    {"shape": "circle", "x": 0.0, "y": 0.03, "size": 1.08, "fill": {"type": "radial", "stops": [[0, "black/50"], [0.86, "black/43"], [1, "black/0"]]}, "opacity": "sat(open)*0.95"},
    {"image": "cloth", "size": 1.0, "intro": {"time": 0.45, "ease": "out", "scale": 0.94}}
  ],
  "slot": {
    "intro": {"time": 0.42, "ease": "back", "delay": 0.06, "scale": 0.3, "stagger": 0.02, "order": "both"},
    "under": [
      {"image": "halo", "size": 1.5, "opacity": "hot*0.5", "when": "hot>0.02", "scale": "(1.5*hot)/1.5"},
      {"shape": "circle", "x": 0.0, "y": 0.05, "size": 0.96, "fill": {"type": "radial", "stops": [[0, "black/35"], [0.86, "black/30"], [1, "black/0"]]}, "opacity": "sat(open)*0.95"},
      {"image": "rosettes", "size": "1.0*(1+0.04*hot-0.03*press)", "frame": "(i+ring)%2", "rotate": "hot*45"}
    ],
    "icon": {"size": 0.48, "zoom": 1.16, "shadow": {"x": 0, "y": 1, "blur": 2, "color": "#1A1A1A/35"}},
    "over": [
      {"shape": "circle", "y": 0.92, "size": 0.15, "fill": "#B8202A", "when": "running", "opacity": "active ? 1 : 0.75", "glow": 4, "glowcolor": "#1A1A1A"},
      {"shape": "circle", "y": 0.92, "size": 0.0825, "fill": "#1A1A1A", "when": "running", "opacity": "active ? 1 : 0.35+0.35*wave(time*0.5+seed)"},
      {"shape": "circle", "x": 0.64, "y": -0.64, "size": 0.25, "fill": "#B8202A", "when": "numbers && number<10 && !kid"},
      {"text": "{number}", "x": 0.64, "y": -0.65, "em": 0.3, "color": "#F8F4EC", "font": "title", "weight": 700, "when": "numbers && number<10 && !kid"},
      {"shape": "poly", "points": [[-0.12, -0.6980000000000001], [0, -0.8], [0.12, -0.6980000000000001]], "stroke": "#1A1A1A", "width": 2.2, "caps": true, "when": "group"}
    ],
    "marks": false,
    "chevron": false,
    "badge": false
  },
  "over": [
    {"image": "motif", "size": 0.0876, "in": "hub", "angle": "sel", "radius": 1.1, "opacity": "on", "scale": "(0.08*(1+0.1*sin(time*4)))/0.0876"}
  ],
  "hub": [
    {"image": "centre", "size": 1.0, "intro": {"time": 0.45, "ease": "back", "scale": 0.7}},
    {"text": "{title}", "y": -0.05, "box": [1.26, 0.6], "px": 17, "color": "text", "font": "title", "weight": 700, "wrap": true, "shadow": {"x": 0, "y": 0, "blur": 2, "color": "#F8F4EC"}},
    {"text": "{sub}", "y": 0.28, "box": [1.1969999999999998, 0.2], "px": 11.5, "color": "sub", "font": "title", "weight": 700, "shadow": {"x": 0, "y": 0, "blur": 2, "color": "#F8F4EC"}},
    {"text": "{hh}:{mm}", "y": -0.08, "box": [1.26, 0.55], "px": 31, "color": "text", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 0, "blur": 2, "color": "#F8F4EC"}},
    {"text": "{date}", "y": 0.21, "box": [1.1969999999999998, 0.2], "px": 12, "color": "sub", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 0, "blur": 2, "color": "#F8F4EC"}}
  ],
  "draw": {"clock": false, "shadow": false, "text": "text"},
  "tabs": {"inset": 13, "text": "#1A1A1A", "fill": "#00000010", "on": "#B8202A/85"},
  "panel": {"fill": {"type": "linear", "stops": [[0, "#F8F4EC"], [1, "#E8DECC"]]}, "stroke": "#B8202A", "width": 3, "corner": 14, "text": "#1A1A1A"},
  "tag": {"fill": {"type": "linear", "stops": [[0, "#F8F4EC"], [1, "#E8DECC"]]}, "stroke": "#B8202A", "width": 2, "corner": 13, "text": "#1A1A1A"},
  "tile": {"fill": {"type": "linear", "stops": [[0, "#F8F4EC"], [1, "#E8DECC"]]}, "stroke": "#9A6A3A", "width": 2.4, "corner": 12, "text": "#1A1A1A"},
  "onlaunch": [
    {"image": "motif", "count": 14, "area": "slot", "life": [0.5, 1.0], "size": [5, 9], "speed": [60, 220], "outward": true, "dir": [-90, 90], "drag": 1.8, "spin": [-200, 200], "fadein": 0, "fadeout": 0.5}
  ],
  "sounds": {"open": "open.wav", "move": "move.wav", "launch": "launch.wav", "close": "close.wav"}
}
