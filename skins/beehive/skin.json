{
  "format": 1,
  "id": "beehive",
  "name": "Beehive",
  "author": "Radial Taskbar",
  "version": "1.0",
  "about": "Wax comb full of honey: apps sit in honey-filled cells and a bee walks to your choice",
  "tags": ["nature", "warm", "golden"],
  "preview": "preview.jpg",
  "style": {"shape": "hex", "material": "solid", "base": "#3A2408", "accent": "#F2A81E", "accent2": "#FFE08A", "text": "#3A2408", "border": "#F2A81E", "opacity": 0.98, "corner": 14, "font": "Constantia", "open": "bloom", "speed": 1, "hoverGrow": 3, "iconZoom": 1.12, "glow": 0, "tilt": 0.3, "pointer": false, "burst": false, "shadow": 0.5, "dim": 0.32},
  "wheel": {"hub": 90, "thickness": 92, "gap": 5, "ringgap": 10, "rim": 32, "icon": 42, "crowd": 1.45, "area": 1.1, "hubkeep": 0.76},
  "colors": {"text": "#3A2408", "sub": "#6A4A18"},
  "fonts": {"title": "Constantia, Georgia"},
  "images": {
    "bee": "bee.png",
    "cells": {"file": "cells.png", "cols": 2},
    "comb": {"file": "comb.jpg", "mask": "comb-mask.png"},
    "drop": "drop.png",
    "halo": {"file": "halo.jpg", "light": true},
    "pool": {"file": "pool.jpg", "mask": "pool-mask.png"}
  },
  "back": [
    {"shape": "circle", "x": 0.0, "y": 0.03, "size": 1.08, "fill": {"type": "radial", "stops": [[0, "black/60"], [0.86, "black/51"], [1, "black/0"]]}, "opacity": "sat(open)*0.95"},
    {"image": "comb", "size": 1.0, "intro": {"time": 0.4, "ease": "out", "scale": 0.92}}
  ],
  "slot": {
    "intro": {"time": 0.42, "ease": "back", "delay": 0.06, "scale": 0.3, "stagger": 0.02, "order": "both"},
    "under": [
      {"image": "halo", "size": 1.6, "opacity": "hot*0.6", "when": "hot>0.02", "scale": "(1.6*hot)/1.6"},
      {"image": "cells", "size": "1.06*(1+0.05*hot-0.04*press)", "frame": "hot>0.5 ? 1 : 0"}
    ],
    "icon": {"size": 0.56, "zoom": 1.18, "shadow": {"x": 0, "y": 1, "blur": 2, "color": "#3A2408/50"}},
    "over": [
      {"shape": "circle", "y": 0.92, "size": 0.15, "fill": "#F2A81E", "when": "running", "opacity": "active ? 1 : 0.75", "glow": 4, "glowcolor": "#FFE08A"},
      {"shape": "circle", "y": 0.92, "size": 0.0825, "fill": "#FFE08A", "when": "running", "opacity": "active ? 1 : 0.35+0.35*wave(time*0.5+seed)"},
      {"shape": "circle", "x": 0.64, "y": -0.64, "size": 0.25, "fill": "#3A2408", "when": "numbers && number<10 && !kid"},
      {"text": "{number}", "x": 0.64, "y": -0.65, "em": 0.3, "color": "#FFE08A", "font": "title", "weight": 700, "when": "numbers && number<10 && !kid"},
      {"shape": "poly", "points": [[-0.12, -0.6980000000000001], [0, -0.8], [0.12, -0.6980000000000001]], "stroke": "#3A2408", "width": 2.2, "caps": true, "when": "group"}
    ],
    "marks": false,
    "chevron": false,
    "badge": false
  },
  "over": [
    {"image": "bee", "size": [0.11, 0.11], "in": "hub", "angle": "sel", "radius": "1.12+0.02*sin(time*9)", "rotate": "sel+6*sin(time*20)", "opacity": "on"}
  ],
  "hub": [
    {"shape": "circle", "x": 0.0, "y": 0.05, "size": 1.0, "fill": {"type": "radial", "stops": [[0, "black/40"], [0.86, "black/34"], [1, "black/0"]]}, "opacity": "sat(open)*0.95"},
    {"image": "pool", "size": 1.04, "intro": {"time": 0.45, "ease": "back", "scale": 0.6}},
    {"text": "{title}", "y": -0.05, "box": [1.26, 0.6], "px": 17, "color": "text", "font": "title", "weight": 700, "wrap": true, "shadow": {"x": 0, "y": 0, "blur": 3, "color": "#FFE08A"}},
    {"text": "{sub}", "y": 0.28, "box": [1.1969999999999998, 0.2], "px": 11.5, "color": "sub", "font": "title", "weight": 700, "shadow": {"x": 0, "y": 0, "blur": 3, "color": "#FFE08A"}},
    {"text": "{hh}:{mm}", "y": -0.08, "box": [1.26, 0.55], "px": 31, "color": "text", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 0, "blur": 3, "color": "#FFE08A"}},
    {"text": "{date}", "y": 0.21, "box": [1.1969999999999998, 0.2], "px": 12, "color": "sub", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 0, "blur": 3, "color": "#FFE08A"}}
  ],
  "draw": {"clock": false, "shadow": false, "text": "text"},
  "tabs": {"inset": 13, "text": "#FFF2C8", "fill": "#00000022", "on": "#F2A81E/85"},
  "panel": {"fill": {"type": "linear", "stops": [[0, "#5A3A10"], [1, "#3A2408"]]}, "stroke": "#F2A81E", "width": 3, "corner": 14, "text": "#FFF2C8"},
  "tag": {"fill": {"type": "linear", "stops": [[0, "#5A3A10"], [1, "#3A2408"]]}, "stroke": "#F2A81E", "width": 2, "corner": 13, "text": "#FFF2C8"},
  "tile": {"fill": {"type": "linear", "stops": [[0, "#FFF2C8"], [1, "#F2D88A"]]}, "stroke": "#B8801A", "width": 2.4, "corner": 12, "text": "#3A2408"},
  "onhover": [
    {"image": "bee", "count": 1, "area": "slot", "life": [0.8, 1.2], "size": [10, 12], "speed": [60, 120], "outward": true, "dir": [-60, 60], "sway": 40, "swayhz": 3, "fadein": 0.1, "fadeout": 0.4}
  ],
  "onlaunch": [
    {"image": "drop", "count": 10, "area": "slot", "life": [0.6, 1.0], "size": [5, 9], "speed": [40, 140], "outward": true, "dir": [-50, 50], "gravity": 900, "fadein": 0, "fadeout": 0.3}
  ],
  "sounds": {"open": "open.wav", "move": "move.wav", "launch": "launch.wav", "close": "close.wav"},
  "screen": {"effect": "fireflies", "color": "#F2C84A", "color2": "#FFF2B0", "density": 0.5, "speed": 0.6, "size": 0.7}
}
