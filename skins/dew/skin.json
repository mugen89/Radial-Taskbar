{
  "format": 1,
  "id": "dew",
  "name": "Morning Dew",
  "author": "Radial Taskbar",
  "version": "1.0",
  "about": "A web strung with dew in soft morning light; every app is a clear drop that magnifies it",
  "tags": ["nature", "fresh", "light"],
  "preview": "preview.jpg",
  "style": {"shape": "orb", "material": "solid", "base": "#1E3A22", "accent": "#BFE8C8", "accent2": "#FFF6C8", "text": "#1E3A22", "border": "#BFE8C8", "opacity": 0.98, "corner": 14, "font": "Candara", "open": "bloom", "speed": 0.9, "hoverGrow": 3, "iconZoom": 1.12, "glow": 0, "tilt": 0.3, "pointer": false, "burst": false, "shadow": 0.5, "dim": 0.25},
  "wheel": {"hub": 90, "thickness": 92, "gap": 5, "ringgap": 10, "rim": 32, "icon": 42, "crowd": 1.45, "area": 1.1, "hubkeep": 0.76},
  "colors": {"text": "#1E3A22", "sub": "#3A5A3E"},
  "fonts": {"title": "Candara, Segoe UI"},
  "images": {
    "bigdrop": {"file": "bigdrop.jpg", "mask": "bigdrop-mask.png"},
    "drops": {"file": "drops.png", "cols": 2},
    "glint": "glint.png",
    "halo": {"file": "halo.jpg", "light": true},
    "morning": {"file": "morning.jpg", "mask": "morning-mask.png"}
  },
  "back": [
    {"shape": "circle", "x": 0.0, "y": 0.02, "size": 1.06, "fill": {"type": "radial", "stops": [[0, "black/45"], [0.86, "black/38"], [1, "black/0"]]}, "opacity": "sat(open)*0.95"},
    {"image": "morning", "size": 1.0, "intro": {"time": 0.5, "ease": "out", "scale": 0.92}}
  ],
  "slot": {
    "intro": {"time": 0.42, "ease": "back", "delay": 0.06, "scale": 0.3, "stagger": 0.02, "order": "both"},
    "under": [
      {"image": "halo", "size": 1.5, "opacity": "hot*0.5", "when": "hot>0.02", "scale": "(1.5*hot)/1.5"},
      {"shape": "circle", "x": 0.0, "y": 0.1, "size": 0.92, "fill": {"type": "radial", "stops": [[0, "black/40"], [0.86, "black/34"], [1, "black/0"]]}, "opacity": "sat(open)*0.95"}
    ],
    "icon": {"size": 0.58, "zoom": 1.32, "shadow": {"x": 0, "y": 2, "blur": 4, "color": "#1E3A22/45"}},
    "over": [
      {"image": "drops", "size": "1.0*(1+0.05*hot-0.04*press)", "frame": "hot>0.5 ? 1 : 0"},
      {"shape": "circle", "y": 0.92, "size": 0.15, "fill": "#BFE8C8", "when": "running", "opacity": "active ? 1 : 0.75", "glow": 4, "glowcolor": "#FFF6C8"},
      {"shape": "circle", "y": 0.92, "size": 0.0825, "fill": "#FFF6C8", "when": "running", "opacity": "active ? 1 : 0.35+0.35*wave(time*0.5+seed)"},
      {"shape": "circle", "x": 0.64, "y": -0.64, "size": 0.25, "fill": "#1E3A22", "when": "numbers && number<10 && !kid"},
      {"text": "{number}", "x": 0.64, "y": -0.65, "em": 0.3, "color": "#F4FAEE", "font": "title", "weight": 700, "when": "numbers && number<10 && !kid"},
      {"shape": "poly", "points": [[-0.12, -0.6980000000000001], [0, -0.8], [0.12, -0.6980000000000001]], "stroke": "#1E3A22", "width": 2.2, "caps": true, "when": "group"}
    ],
    "marks": false,
    "chevron": false,
    "badge": false
  },
  "over": [
    {"image": "glint", "size": 0.128, "in": "hub", "angle": "sel", "radius": 1.1, "opacity": "on", "scale": "(0.10*(1+0.3*sin(time*4)))/0.128"}
  ],
  "hub": [
    {"image": "bigdrop", "size": 1.0, "intro": {"time": 0.5, "ease": "back", "scale": 0.6}},
    {"text": "{title}", "y": -0.05, "box": [1.26, 0.6], "px": 17, "color": "text", "font": "title", "weight": 700, "wrap": true, "shadow": {"x": 0, "y": 0, "blur": 3, "color": "#F4FAEE"}},
    {"text": "{sub}", "y": 0.28, "box": [1.1969999999999998, 0.2], "px": 11.5, "color": "sub", "font": "title", "weight": 700, "shadow": {"x": 0, "y": 0, "blur": 3, "color": "#F4FAEE"}},
    {"text": "{hh}:{mm}", "y": -0.08, "box": [1.26, 0.55], "px": 31, "color": "text", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 0, "blur": 3, "color": "#F4FAEE"}},
    {"text": "{date}", "y": 0.21, "box": [1.1969999999999998, 0.2], "px": 12, "color": "sub", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 0, "blur": 3, "color": "#F4FAEE"}}
  ],
  "draw": {"clock": false, "shadow": false, "text": "text"},
  "tabs": {"inset": 13, "text": "#1E3A22", "fill": "#FFFFFF/40", "on": "#7AA86A/85"},
  "panel": {"fill": {"type": "linear", "stops": [[0, "#EEF6E4"], [1, "#D4E6C4"]]}, "stroke": "#7AA86A", "width": 3, "corner": 14, "text": "#1E3A22"},
  "tag": {"fill": {"type": "linear", "stops": [[0, "#EEF6E4"], [1, "#D4E6C4"]]}, "stroke": "#7AA86A", "width": 2, "corner": 13, "text": "#1E3A22"},
  "tile": {"fill": {"type": "linear", "stops": [[0, "#F4FAEE"], [1, "#DCEACC"]]}, "stroke": "#7AA86A", "width": 2.4, "corner": 12, "text": "#1E3A22"},
  "onlaunch": [
    {"image": "glint", "count": 18, "area": "slot", "life": [0.4, 0.8], "size": [4, 9], "speed": [60, 220], "outward": true, "dir": [-90, 90], "gravity": 300, "fadein": 0, "fadeout": 0.5}
  ],
  "sounds": {"open": "open.wav", "move": "move.wav", "launch": "launch.wav", "close": "close.wav"}
}
