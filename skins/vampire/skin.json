{
  "format": 1,
  "id": "vampire",
  "name": "Vampire",
  "author": "Radial Taskbar",
  "version": "1.0",
  "about": "Crimson velvet under black wrought iron; apps rest on garnets set in silver while bats cross the dark",
  "tags": ["gothic", "dark", "red"],
  "preview": "preview.jpg",
  "style": {"shape": "orb", "material": "solid", "base": "#1A0508", "accent": "#B3122A", "accent2": "#E6C9CC", "text": "#EFE0E2", "border": "#B3122A", "opacity": 0.98, "corner": 14, "font": "Cinzel", "open": "fade", "speed": 0.9, "hoverGrow": 3, "iconZoom": 1.12, "glow": 0, "tilt": 0.3, "pointer": false, "burst": false, "shadow": 0.5, "dim": 0.55},
  "wheel": {"hub": 90, "thickness": 92, "gap": 5, "ringgap": 10, "rim": 32, "icon": 42, "crowd": 1.45, "area": 1.1, "hubkeep": 0.76},
  "colors": {"text": "#EFE0E2", "sub": "#C9A5AA"},
  "fonts": {"title": {"file": "Cinzel[wght].ttf", "family": "Cinzel"}},
  "images": {
    "drop": "drop.png",
    "gems": {"file": "gems.png", "cols": 4},
    "halo": {"file": "halo.jpg", "light": true},
    "locket": {"file": "locket.jpg", "mask": "locket-mask.png"},
    "velvet": {"file": "velvet.jpg", "mask": "velvet-mask.png"}
  },
  "back": [
    {"shape": "circle", "x": 0.0, "y": 0.03, "size": 1.1, "fill": {"type": "radial", "stops": [[0, "black/70"], [0.86, "black/60"], [1, "black/0"]]}, "opacity": "sat(open)*0.95"},
    {"image": "velvet", "size": 1.0, "intro": {"time": 0.42, "ease": "out", "scale": 0.92}}
  ],
  "slot": {
    "intro": {"time": 0.42, "ease": "back", "delay": 0.06, "scale": 0.3, "stagger": 0.02, "order": "both"},
    "under": [
      {"image": "halo", "size": 1.6, "opacity": "hot*0.6", "when": "hot>0.02", "scale": "(1.6*hot)/1.6"},
      {"image": "gems", "size": "1.0*(1+0.05*hot-0.04*press)", "frame": "(i+ring)%4"}
    ],
    "icon": {"size": 0.62, "zoom": 1.16, "shadow": {"x": 0, "y": 2, "blur": 3, "color": "black/60"}},
    "over": [
      {"shape": "circle", "y": 0.92, "size": 0.15, "fill": "#B3122A", "when": "running", "opacity": "active ? 1 : 0.75", "glow": 4, "glowcolor": "#E6C9CC"},
      {"shape": "circle", "y": 0.92, "size": 0.0825, "fill": "#E6C9CC", "when": "running", "opacity": "active ? 1 : 0.35+0.35*wave(time*0.5+seed)"},
      {"shape": "circle", "x": 0.64, "y": -0.64, "size": 0.25, "fill": "#C9CCD2", "when": "numbers && number<10 && !kid"},
      {"text": "{number}", "x": 0.64, "y": -0.65, "em": 0.3, "color": "#1A0508", "font": "title", "weight": 700, "when": "numbers && number<10 && !kid"},
      {"shape": "poly", "points": [[-0.12, -0.6980000000000001], [0, -0.8], [0.12, -0.6980000000000001]], "stroke": "#EFE0E2", "width": 2.2, "caps": true, "when": "group"}
    ],
    "marks": false,
    "chevron": false,
    "badge": false
  },
  "over": [
    {"image": "drop", "size": [0.08, 0.12], "in": "hub", "angle": "sel", "radius": 1.1, "rotate": "sel", "opacity": "on"}
  ],
  "hub": [
    {"image": "locket", "size": 1.0, "intro": {"time": 0.4, "ease": "back", "scale": 0.6}},
    {"text": "{title}", "y": -0.05, "box": [1.26, 0.6], "px": 16, "color": "text", "font": "title", "weight": 700, "wrap": true, "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/80"}},
    {"text": "{sub}", "y": 0.28, "box": [1.178, 0.2], "px": 11.5, "color": "sub", "font": "title", "weight": 700, "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/80"}},
    {"text": "{hh}:{mm}", "y": -0.08, "box": [1.24, 0.55], "px": 30, "color": "text", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/80"}},
    {"text": "{date}", "y": 0.21, "box": [1.178, 0.2], "px": 12, "color": "sub", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/80"}}
  ],
  "draw": {"clock": false, "shadow": false, "text": "text"},
  "tabs": {"inset": 13, "text": "text", "fill": "#EFE0E2/14", "on": "#B3122A/85"},
  "panel": {"fill": {"type": "linear", "stops": [[0, "#2A0A10"], [1, "#140306"]]}, "stroke": "#8C8F96", "width": 3, "corner": 14, "text": "text"},
  "tag": {"fill": {"type": "linear", "stops": [[0, "#2A0A10"], [1, "#140306"]]}, "stroke": "#8C8F96", "width": 2, "corner": 13, "text": "text"},
  "tile": {"fill": {"type": "linear", "stops": [[0, "#3A0A14"], [1, "#22060C"]]}, "stroke": "#8C8F96", "width": 2.4, "corner": 12, "text": "#EFE0E2"},
  "onhover": [
    {"color": "#B3122A", "count": 5, "area": "slot", "life": [0.3, 0.7], "size": [1.2, 2.6], "speed": [20, 70], "outward": true, "dir": [-60, 60], "gravity": 120, "fadein": 0, "fadeout": 0.6}
  ],
  "onlaunch": [
    {"image": "drop", "count": 12, "area": "slot", "life": [0.6, 1.1], "size": [5, 9], "speed": [60, 200], "outward": true, "dir": [-60, 60], "gravity": 900, "fadein": 0, "fadeout": 0.3}
  ],
  "sounds": {"open": "open.wav", "move": "move.wav", "launch": "launch.wav", "close": "close.wav"},
  "screen": {"effect": "bats", "color": "#2A0A14", "color2": "#4A1020", "density": 1.2, "speed": 0.9, "size": 1.0}
}
