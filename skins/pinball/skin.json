{
  "format": 1,
  "id": "pinball",
  "name": "Pinball",
  "author": "Radial Taskbar",
  "version": "1.0",
  "about": "A playfield under glass: pop bumpers carry the apps and flash, a dot display sits in the middle",
  "tags": ["game", "retro", "bright"],
  "preview": "preview.jpg",
  "style": {"shape": "orb", "material": "solid", "base": "#0A1440", "accent": "#FF4A2A", "accent2": "#FFD23A", "text": "#FF9A2A", "border": "#FF4A2A", "opacity": 0.98, "corner": 14, "font": "VT323", "open": "zoom", "speed": 1.15, "hoverGrow": 3, "iconZoom": 1.12, "glow": 0, "tilt": 0.35, "pointer": false, "burst": false, "shadow": 0.5, "dim": 0.4},
  "wheel": {"hub": 90, "thickness": 92, "gap": 5, "ringgap": 10, "rim": 32, "icon": 42, "crowd": 1.45, "area": 1.1, "hubkeep": 0.76},
  "colors": {"text": "#FF9A2A", "sub": "#C86A1A"},
  "fonts": {"title": {"file": "VT323-Regular.ttf", "family": "VT323"}},
  "images": {
    "arrow": "arrow.png",
    "ball": "ball.png",
    "bumpers": {"file": "bumpers.png", "cols": 4},
    "display": {"file": "display.jpg", "mask": "display-mask.png"},
    "field": {"file": "field.jpg", "mask": "field-mask.png"},
    "flash": {"file": "flash.jpg", "light": true},
    "halo": {"file": "halo.jpg", "light": true}
  },
  "back": [
    {"shape": "circle", "x": 0.0, "y": 0.03, "size": 1.08, "fill": {"type": "radial", "stops": [[0, "black/65"], [0.86, "black/55"], [1, "black/0"]]}, "opacity": "sat(open)*0.95"},
    {"image": "field", "size": 1.0, "intro": {"time": 0.35, "ease": "out", "scale": 0.94}}
  ],
  "slot": {
    "intro": {"time": 0.42, "ease": "back", "delay": 0.06, "scale": 0.3, "stagger": 0.02, "order": "both"},
    "under": [
      {"image": "flash", "size": "1.7*(1+0.4*launch)", "opacity": "0.25*hot+0.9*launch+0.25*step(0.5,fract(time*2+seed))*hot"},
      {"image": "bumpers", "size": "0.96*(1+0.06*hot-0.10*press+0.15*launch)", "frame": "(i+ring)%4"}
    ],
    "icon": {"size": 0.48, "zoom": 1.2, "shadow": {"x": 0, "y": 1, "blur": 2, "color": "black/50"}},
    "over": [
      {"shape": "circle", "y": 0.92, "size": 0.15, "fill": "#FF4A2A", "when": "running", "opacity": "active ? 1 : 0.75", "glow": 4, "glowcolor": "#FFD23A"},
      {"shape": "circle", "y": 0.92, "size": 0.0825, "fill": "#FFD23A", "when": "running", "opacity": "active ? 1 : 0.35+0.35*wave(time*0.5+seed)"},
      {"shape": "circle", "x": 0.64, "y": -0.64, "size": 0.25, "fill": "#FFD23A", "when": "numbers && number<10 && !kid"},
      {"text": "{number}", "x": 0.64, "y": -0.65, "em": 0.3, "color": "#0A1440", "font": "title", "weight": 700, "when": "numbers && number<10 && !kid"},
      {"shape": "poly", "points": [[-0.12, -0.6980000000000001], [0, -0.8], [0.12, -0.6980000000000001]], "stroke": "#FF9A2A", "width": 2.2, "caps": true, "when": "group"}
    ],
    "marks": false,
    "chevron": false,
    "badge": false
  },
  "over": [
    {"image": "arrow", "size": [0.06, 0.084], "in": "hub", "angle": "sel", "radius": 1.1, "rotate": "sel", "opacity": "on"}
  ],
  "hub": [
    {"image": "display", "size": 1.0, "intro": {"time": 0.35, "ease": "back", "scale": 0.6}},
    {"text": "{title}", "y": -0.05, "box": [1.26, 0.6], "px": 24, "color": "text", "font": "title", "weight": 700, "wrap": true, "shadow": {"x": 0, "y": 0, "blur": 6, "color": "#FF6A1A/80"}},
    {"text": "{sub}", "y": 0.28, "box": [1.1969999999999998, 0.2], "px": 16, "color": "sub", "font": "title", "weight": 700, "shadow": {"x": 0, "y": 0, "blur": 6, "color": "#FF6A1A/80"}},
    {"text": "{hh}:{mm}", "y": -0.08, "box": [1.26, 0.55], "px": 46, "color": "text", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 0, "blur": 6, "color": "#FF6A1A/80"}},
    {"text": "{date}", "y": 0.21, "box": [1.1969999999999998, 0.2], "px": 17, "color": "sub", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 0, "blur": 6, "color": "#FF6A1A/80"}}
  ],
  "draw": {"clock": false, "shadow": false, "text": "text"},
  "tabs": {"inset": 13, "text": "#FFD23A", "fill": "#FFFFFF/12", "on": "#FF4A2A/85"},
  "panel": {"fill": {"type": "linear", "stops": [[0, "#16248A"], [1, "#08103E"]]}, "stroke": "#D8DCE2", "width": 3, "corner": 14, "text": "#FFD23A"},
  "tag": {"fill": {"type": "linear", "stops": [[0, "#16248A"], [1, "#08103E"]]}, "stroke": "#D8DCE2", "width": 2, "corner": 13, "text": "#FFD23A"},
  "tile": {"fill": {"type": "linear", "stops": [[0, "#F2F4F8"], [1, "#D0D6E0"]]}, "stroke": "#8A96B0", "width": 2.4, "corner": 12, "text": "#0A1440"},
  "onhover": [
    {"color": "#FFF2C0", "count": 6, "area": "slot", "life": [0.15, 0.3], "size": [1.5, 2.5], "speed": [100, 220], "outward": true, "dir": [-90, 90], "drag": 2, "fadein": 0, "fadeout": 0.6}
  ],
  "onlaunch": [
    {"image": "ball", "count": 1, "area": "slot", "life": [0.5, 0.5], "size": [14, 14], "speed": [700, 700], "outward": true, "dir": [0, 0], "drag": 0.5, "fadein": 0, "fadeout": 0.2},
    {"color": "#FFD23A", "count": 24, "area": "slot", "life": [0.3, 0.6], "size": [1.5, 3], "speed": [100, 340], "outward": true, "dir": [-90, 90], "drag": 2, "fadein": 0, "fadeout": 0.5}
  ],
  "sounds": {"open": "open.wav", "move": "move.wav", "launch": "launch.wav", "close": "close.wav"}
}
