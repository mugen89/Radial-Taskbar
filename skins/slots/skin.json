{
  "format": 1,
  "id": "slots",
  "name": "Slot Machine",
  "author": "Radial Taskbar",
  "version": "1.0",
  "about": "A red and chrome cabinet with chasing bulbs; every app sits in a reel window and coins burst on a win",
  "tags": ["casino", "bright", "game"],
  "preview": "preview.jpg",
  "style": {"shape": "orb", "material": "solid", "base": "#2A0A0E", "accent": "#FFD23A", "accent2": "#FF3A3A", "text": "#FFE9A0", "border": "#FFD23A", "opacity": 0.98, "corner": 14, "font": "Impact", "open": "bloom", "speed": 1.1, "hoverGrow": 3, "iconZoom": 1.12, "glow": 0, "tilt": 0.35, "pointer": false, "burst": false, "shadow": 0.5, "dim": 0.42},
  "wheel": {"hub": 90, "thickness": 92, "gap": 5, "ringgap": 10, "rim": 32, "icon": 42, "crowd": 1.45, "area": 1.1, "hubkeep": 0.76},
  "colors": {"text": "#FFE9A0", "sub": "#E8C27A"},
  "fonts": {"title": "Impact, Bahnschrift"},
  "images": {
    "arrow": "arrow.png",
    "bulbs": {"file": "bulbs.jpg", "cols": 2, "light": true},
    "cabinet": {"file": "cabinet.jpg", "mask": "cabinet-mask.png"},
    "coin": "coin.png",
    "halo": {"file": "halo.jpg", "light": true},
    "jackpot": {"file": "jackpot.jpg", "mask": "jackpot-mask.png"},
    "reels": {"file": "reels.png", "cols": 4}
  },
  "back": [
    {"shape": "circle", "x": 0.0, "y": 0.03, "size": 1.1, "fill": {"type": "radial", "stops": [[0, "black/65"], [0.86, "black/55"], [1, "black/0"]]}, "opacity": "sat(open)*0.95"},
    {"image": "cabinet", "size": 1.0, "intro": {"time": 0.35, "ease": "back", "scale": 0.9}},
    {"image": "bulbs", "size": 1.0, "frame": "floor(time*5)%2"}
  ],
  "slot": {
    "intro": {"time": 0.42, "ease": "back", "delay": 0.06, "scale": 0.3, "stagger": 0.02, "order": "both"},
    "under": [
      {"image": "halo", "size": 1.6, "opacity": "hot*0.6", "when": "hot>0.02", "scale": "(1.6*hot)/1.6"},
      {"shape": "circle", "x": 0.0, "y": 0.06, "size": 0.95, "fill": {"type": "radial", "stops": [[0, "black/40"], [0.86, "black/34"], [1, "black/0"]]}, "opacity": "sat(open)*0.95"},
      {"image": "reels", "size": "0.96*(1+0.05*hot-0.04*press)", "frame": "floor(i+ring+time*20*hot)%4"}
    ],
    "icon": {"size": 0.56, "zoom": 1.16, "shadow": {"x": 0, "y": 1, "blur": 2, "color": "black/40"}},
    "over": [
      {"shape": "circle", "y": 0.92, "size": 0.15, "fill": "#FFD23A", "when": "running", "opacity": "active ? 1 : 0.75", "glow": 4, "glowcolor": "#FF3A3A"},
      {"shape": "circle", "y": 0.92, "size": 0.0825, "fill": "#FF3A3A", "when": "running", "opacity": "active ? 1 : 0.35+0.35*wave(time*0.5+seed)"},
      {"shape": "circle", "x": 0.64, "y": -0.64, "size": 0.25, "fill": "#FFD23A", "when": "numbers && number<10 && !kid"},
      {"text": "{number}", "x": 0.64, "y": -0.65, "em": 0.3, "color": "#2A0A0E", "font": "title", "weight": 700, "when": "numbers && number<10 && !kid"},
      {"shape": "poly", "points": [[-0.12, -0.6980000000000001], [0, -0.8], [0.12, -0.6980000000000001]], "stroke": "#FFE9A0", "width": 2.2, "caps": true, "when": "group"}
    ],
    "marks": false,
    "chevron": false,
    "badge": false
  },
  "over": [
    {"image": "arrow", "size": [0.06, 0.084], "in": "hub", "angle": "sel", "radius": 1.1, "rotate": "sel", "opacity": "on"}
  ],
  "hub": [
    {"image": "jackpot", "size": 1.0, "intro": {"time": 0.4, "ease": "back", "scale": 0.6}},
    {"text": "{title}", "y": -0.05, "box": [1.26, 0.6], "px": 18, "color": "text", "font": "title", "weight": 700, "wrap": true, "shadow": {"x": 0, "y": 1, "blur": 4, "color": "black/90"}},
    {"text": "{sub}", "y": 0.28, "box": [1.1969999999999998, 0.2], "px": 11.5, "color": "sub", "font": "title", "weight": 700, "shadow": {"x": 0, "y": 1, "blur": 4, "color": "black/90"}},
    {"text": "{hh}:{mm}", "y": -0.08, "box": [1.26, 0.55], "px": 34, "color": "text", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 1, "blur": 4, "color": "black/90"}},
    {"text": "{date}", "y": 0.21, "box": [1.1969999999999998, 0.2], "px": 12, "color": "sub", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 1, "blur": 4, "color": "black/90"}}
  ],
  "draw": {"clock": false, "shadow": false, "text": "text"},
  "tabs": {"inset": 13, "text": "text", "fill": "#FFE9A0/14", "on": "#FFD23A/85"},
  "panel": {"fill": {"type": "linear", "stops": [[0, "#5A0A14"], [1, "#2A0A0E"]]}, "stroke": "#E8B83A", "width": 3, "corner": 14, "text": "text"},
  "tag": {"fill": {"type": "linear", "stops": [[0, "#5A0A14"], [1, "#2A0A0E"]]}, "stroke": "#E8B83A", "width": 2, "corner": 13, "text": "text"},
  "tile": {"fill": {"type": "linear", "stops": [[0, "#FAF6EC"], [1, "#E8DCC0"]]}, "stroke": "#B8902A", "width": 2.4, "corner": 12, "text": "#2A0A0E"},
  "onlaunch": [
    {"image": "coin", "count": 24, "area": "slot", "life": [0.6, 1.1], "size": [7, 11], "speed": [150, 380], "outward": true, "dir": [-70, 70], "gravity": 900, "spin": [-500, 500], "fadein": 0, "fadeout": 0.3}
  ],
  "sounds": {"open": "open.wav", "move": "move.wav", "launch": "launch.wav", "close": "close.wav"}
}
