{
  "format": 1,
  "id": "billiards",
  "name": "Billiards",
  "author": "Radial Taskbar",
  "version": "1.0",
  "about": "Blue cloth in a cherry-wood rail with pockets; polished balls carry the apps, the cue ball sits in the middle",
  "tags": ["game", "pub", "blue"],
  "preview": "preview.jpg",
  "style": {"shape": "orb", "material": "solid", "base": "#0A2A3A", "accent": "#D9B45A", "accent2": "#FFFFFF", "text": "#1A1A1E", "border": "#D9B45A", "opacity": 0.98, "corner": 14, "font": "Bahnschrift", "open": "bloom", "speed": 1, "hoverGrow": 3, "iconZoom": 1.12, "glow": 0, "tilt": 0.3, "pointer": false, "burst": false, "shadow": 0.5, "dim": 0.38},
  "wheel": {"hub": 90, "thickness": 92, "gap": 5, "ringgap": 10, "rim": 32, "icon": 42, "crowd": 1.45, "area": 1.1, "hubkeep": 0.76},
  "colors": {"text": "#1A1A1E", "sub": "#4A4A4E"},
  "fonts": {"title": "Bahnschrift, Segoe UI"},
  "images": {
    "balls": {"file": "balls.png", "cols": 8},
    "cue": {"file": "cue.jpg", "mask": "cue-mask.png"},
    "halo": {"file": "halo.jpg", "light": true},
    "stick": "stick.png",
    "table": {"file": "table.jpg", "mask": "table-mask.png"}
  },
  "back": [
    {"shape": "circle", "x": 0.0, "y": 0.04, "size": 1.1, "fill": {"type": "radial", "stops": [[0, "black/65"], [0.86, "black/55"], [1, "black/0"]]}, "opacity": "sat(open)*0.95"},
    {"image": "table", "size": 1.0, "intro": {"time": 0.35, "ease": "out", "scale": 0.94}}
  ],
  "slot": {
    "intro": {"time": 0.42, "ease": "back", "delay": 0.06, "scale": 0.3, "stagger": 0.02, "order": "both"},
    "under": [
      {"image": "halo", "size": 1.6, "opacity": "hot*0.45", "when": "hot>0.02", "scale": "(1.6*hot)/1.6"},
      {"shape": "circle", "x": 0.0, "y": 0.07, "size": 0.95, "fill": {"type": "radial", "stops": [[0, "black/50"], [0.86, "black/43"], [1, "black/0"]]}, "opacity": "sat(open)*0.95"},
      {"image": "balls", "size": "0.94*(1+0.05*hot-0.04*press)", "frame": "(i+ring)%8", "x": "0.04*sin(time*14+seed*9)*hot", "rotate": "seed*40-20"}
    ],
    "icon": {"size": 0.42, "zoom": 1.2, "shadow": {"x": 0, "y": 1, "blur": 1, "color": "black/30"}},
    "over": [
      {"shape": "circle", "y": 0.92, "size": 0.15, "fill": "#D9B45A", "when": "running", "opacity": "active ? 1 : 0.75", "glow": 4, "glowcolor": "#FFFFFF"},
      {"shape": "circle", "y": 0.92, "size": 0.0825, "fill": "#FFFFFF", "when": "running", "opacity": "active ? 1 : 0.35+0.35*wave(time*0.5+seed)"},
      {"shape": "circle", "x": 0.64, "y": -0.64, "size": 0.25, "fill": "#141414", "when": "numbers && number<10 && !kid"},
      {"text": "{number}", "x": 0.64, "y": -0.65, "em": 0.3, "color": "#F6F2E8", "font": "title", "weight": 700, "when": "numbers && number<10 && !kid"},
      {"shape": "poly", "points": [[-0.12, -0.6980000000000001], [0, -0.8], [0.12, -0.6980000000000001]], "stroke": "#1A1A1E", "width": 2.2, "caps": true, "when": "group"}
    ],
    "marks": false,
    "chevron": false,
    "badge": false
  },
  "over": [
    {"image": "stick", "size": [0.05, 0.16], "in": "hub", "angle": "sel", "radius": 1.22, "rotate": "sel+180", "opacity": "on"}
  ],
  "hub": [
    {"shape": "circle", "x": 0.0, "y": 0.06, "size": 1.0, "fill": {"type": "radial", "stops": [[0, "black/45"], [0.86, "black/38"], [1, "black/0"]]}, "opacity": "sat(open)*0.95"},
    {"image": "cue", "size": 1.0, "intro": {"time": 0.4, "ease": "back", "scale": 0.6}},
    {"text": "{title}", "y": -0.05, "box": [1.26, 0.6], "px": 17, "color": "text", "font": "title", "weight": 700, "wrap": true, "shadow": {"x": 0, "y": 0, "blur": 2, "color": "#F6F2E8"}},
    {"text": "{sub}", "y": 0.28, "box": [1.1969999999999998, 0.2], "px": 11.5, "color": "sub", "font": "title", "weight": 700, "shadow": {"x": 0, "y": 0, "blur": 2, "color": "#F6F2E8"}},
    {"text": "{hh}:{mm}", "y": -0.08, "box": [1.26, 0.55], "px": 31, "color": "text", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 0, "blur": 2, "color": "#F6F2E8"}},
    {"text": "{date}", "y": 0.21, "box": [1.1969999999999998, 0.2], "px": 12, "color": "sub", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 0, "blur": 2, "color": "#F6F2E8"}}
  ],
  "draw": {"clock": false, "shadow": false, "text": "text"},
  "tabs": {"inset": 13, "text": "#F6F2E8", "fill": "#FFFFFF/12", "on": "#D9B45A/85"},
  "panel": {"fill": {"type": "linear", "stops": [[0, "#1E6AA8"], [1, "#0E3E6E"]]}, "stroke": "#9A3A22", "width": 3, "corner": 14, "text": "#F6F2E8"},
  "tag": {"fill": {"type": "linear", "stops": [[0, "#1E6AA8"], [1, "#0E3E6E"]]}, "stroke": "#9A3A22", "width": 2, "corner": 13, "text": "#F6F2E8"},
  "tile": {"fill": {"type": "linear", "stops": [[0, "#F6F2E8"], [1, "#DCD6C8"]]}, "stroke": "#6A2A12", "width": 2.4, "corner": 12, "text": "#1A1A1E"},
  "onlaunch": [
    {"color": "#F6F2E8", "count": 14, "area": "slot", "life": [0.3, 0.6], "size": [1.5, 3], "speed": [100, 300], "outward": true, "dir": [-80, 80], "drag": 2.2, "fadein": 0, "fadeout": 0.5}
  ],
  "sounds": {"open": "open.wav", "move": "move.wav", "launch": "launch.wav", "close": "close.wav"}
}
