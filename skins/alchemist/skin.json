{
  "format": 1,
  "id": "alchemist",
  "name": "Alchemist",
  "author": "Radial Taskbar",
  "version": "1.0",
  "license": "Font Metamorphous: SIL Open Font License, see OFL.txt",
  "about": "A bench of bubbling flasks that fill up with the colour of what you point at",
  "tags": ["fantasy", "glass", "laboratory"],
  "preview": "preview.jpg",
  "style": {"shape": "orb", "material": "solid", "base": "#1C120A", "accent": "#4CFFB0", "accent2": "#E8A24A", "text": "#F4E6C8", "border": "#B9803F", "opacity": 0.97, "corner": 9, "font": "Metamorphous", "open": "bloom", "speed": 1, "hoverGrow": 3, "iconZoom": 1.12, "glow": 0.5, "tilt": 0.4, "pointer": false, "burst": false, "shadow": 0.7, "dim": 0.42},
  "wheel": {"hub": 94, "thickness": 102, "gap": 5, "ringgap": 12, "rim": 36, "icon": 40, "crowd": 1.52, "area": 1.12, "hubkeep": 0.7},
  "colors": {"pale": "#F4E6C8", "brew": "#8CFFD0", "amber": "#E8A24A"},
  "fonts": {"title": {"file": "Metamorphous-Regular.ttf", "family": "Metamorphous"}},
  "images": {
    "bench": {"file": "bench.jpg", "mask": "bench-mask.png"},
    "brew": {"file": "brew.jpg", "light": true},
    "bubble": {"file": "bubble.jpg", "light": true},
    "cauldron": {"file": "cauldron.jpg", "mask": "cauldron-mask.png"},
    "flaskback": {"file": "flaskback.jpg", "mask": "flaskback-mask.png"},
    "flaskfront": "flaskfront.png",
    "halo": {"file": "halo.jpg", "light": true},
    "liquid": {"file": "liquid.png", "cols": 4, "rows": 2},
    "puff": {"file": "puff.png", "cols": 2}
  },
  "back": [
    {"shape": "circle", "x": 0.0, "y": 0.025, "size": 1.09, "fill": {"type": "radial", "stops": [[0, "black/66"], [0.86, "black/56"], [1, "black/0"]]}, "opacity": "sat(open)*0.95"},
    {"image": "bench", "size": 1, "intro": {"time": 0.28, "ease": "out", "scale": 0.88}}
  ],
  "ring": [
    {"shape": "line", "in": "px", "points": [["sin(rad(a+j*span))*(ringin-14)", "-cos(rad(a+j*span))*(ringin-14)"], ["sin(rad(a+j*span))*(ringin+14)", "-cos(rad(a+j*span))*(ringin+14)"]], "copies": "n", "stroke": {"type": "linear", "stops": [[0, "#F0B48C"], [1, "#7A3E22"]]}, "width": 6},
    {"shape": "arc", "in": "px", "from": 0, "r": "ringin-13", "to": 360, "stroke": {"type": "linear", "stops": [[0, "#F0B48C"], [0.5, "#7A3E22"], [1, "#D98F62"]]}, "width": 6},
    {"shape": "circle", "in": "px", "copies": "n", "angle": "a+j*span", "radius": "ringin-12+26*fract(time*0.7+rnd(j)*5)", "size": 3.4, "fill": "brew", "opacity": "0.8*motion", "glow": 4, "glowcolor": "accent"}
  ],
  "slot": {
    "intro": {"time": 0.34, "ease": "back", "delay": 0.06, "scale": 0.3, "y": 0.5, "stagger": 0.022, "order": "both"},
    "under": [
      {"image": "halo", "size": 1.9, "opacity": "0.45*hot+launch*1.5", "tint": "item"},
      {"image": "flaskback", "size": "1.18*(1+0.04*hot)", "rotate": "3*sin(time*6+seed*6)*hot"},
      {"image": "liquid", "size": "1.18*(1+0.04*hot)", "frame": "floor(2.2+5.3*sat(hot)+0.4*sin(time*2+seed*6))", "tint": "item", "opacity": 0.9, "rotate": "3*sin(time*6+seed*6)*hot"},
      {"image": "halo", "size": 1.1, "y": 0.2, "opacity": "0.35*sat(hot)", "tint": "item"}
    ],
    "icon": {"size": 0.8, "y": 0.16, "zoom": 1.16, "rotate": "3*sin(time*6+seed*6)*hot", "shadow": {"y": 1, "blur": 3, "color": "black/60"}},
    "over": [
      {"image": "bubble", "size": "0.10+0.07*rnd(j+i*7)", "copies": 5, "x": "-0.34+0.68*rnd(j*3+i)+0.04*sin(time*4+j)", "y": "0.70-1.0*fract(time*(0.35+0.25*rnd(j+i))+rnd(j*5+i))", "opacity": "(0.25+0.75*sat(hot))*sin(3.14159*fract(time*(0.35+0.25*rnd(j+i))+rnd(j*5+i)))"},
      {"image": "flaskfront", "size": "1.18*(1+0.04*hot)", "rotate": "3*sin(time*6+seed*6)*hot"},
      {"shape": "circle", "y": 0.98, "size": 0.15, "fill": "#E8A24A", "when": "running", "opacity": "active ? 1 : 0.75", "glow": 4, "glowcolor": "#FFF0C8"},
      {"shape": "circle", "y": 0.98, "size": 0.0825, "fill": "#FFF0C8", "when": "running", "opacity": "active ? 1 : 0.35+0.35*wave(time*0.5+seed)"},
      {"shape": "circle", "x": 0.66, "y": -0.4, "size": 0.25, "fill": "#1C120A", "when": "numbers && number<10 && !kid", "stroke": "#B9803F", "width": 1.2},
      {"text": "{number}", "x": 0.66, "y": -0.41000000000000003, "em": 0.3, "color": "pale", "font": "title", "weight": 700, "when": "numbers && number<10 && !kid"},
      {"shape": "poly", "points": [[-0.12, -0.9580000000000001], [0, -1.06], [0.12, -0.9580000000000001]], "stroke": "amber", "width": 2.2, "caps": true, "when": "group"}
    ],
    "marks": false,
    "chevron": false,
    "badge": false
  },
  "over": [
    {"shape": "circle", "x": 0.0, "y": 0.05, "size": 1.2, "fill": {"type": "radial", "stops": [[0, "black/70"], [0.8, "black/60"], [1, "black/0"]]}, "opacity": "sat(open)*0.95", "in": "hub"},
    {"image": "halo", "size": 0.42, "in": "hub", "angle": "sel", "radius": 0.94, "opacity": "on*(0.8+0.2*noise(time*8))", "tint": "#4CFFB0"},
    {"shape": "poly", "in": "hub", "angle": "sel", "radius": 1.09, "turns": true, "points": [[-0.075, 0.05], [0, -0.075], [0.075, 0.05]], "closed": true, "fill": "#8CFFD0", "opacity": "on", "glow": 5, "glowcolor": "accent"}
  ],
  "hub": [
    {"image": "cauldron", "size": 1.02, "intro": {"time": 0.34, "ease": "back", "scale": 0.4}},
    {"image": "brew", "size": 0.78, "rotate": "time*26", "opacity": "0.20+0.10*on+launch"},
    {"image": "brew", "size": 0.74, "rotate": "-time*17+70", "opacity": "0.13"},
    {"shape": "circle", "size": 0.78, "fill": {"type": "radial", "stops": [[0, "#03140E/78"], [0.7, "#03140E/45"], [1, "#03140E/0"]]}},
    {"image": "bubble", "size": "0.06+0.08*rnd(j+3)", "copies": 8, "angle": "rnd(j)*360", "radius": "0.62*sqrt(rnd(j+20))", "opacity": "0.8*sin(3.14159*fract(time*0.5+rnd(j+40)))", "scale": "0.3+0.7*fract(time*0.5+rnd(j+40))"},
    {"text": "{title}", "y": -0.05, "box": [1.24, 0.56], "px": 17, "color": "#F4FFF8", "font": "title", "weight": 400, "wrap": true, "shadow": {"x": 0, "y": 1, "blur": 4, "color": "#02140E"}},
    {"text": "{sub}", "y": 0.28, "box": [1.178, 0.2], "px": 10.5, "color": "brew", "font": "title", "weight": 400, "shadow": {"x": 0, "y": 1, "blur": 4, "color": "#02140E"}},
    {"text": "{hh}:{mm}", "y": -0.08, "box": [1.24, 0.55], "px": 30, "color": "#F4FFF8", "font": "title", "weight": 400, "opacity": "idle", "shadow": {"x": 0, "y": 1, "blur": 4, "color": "#02140E"}},
    {"text": "{date}", "y": 0.21, "box": [1.178, 0.2], "px": 11.5, "color": "brew", "font": "title", "weight": 400, "opacity": "idle", "shadow": {"x": 0, "y": 1, "blur": 4, "color": "#02140E"}}
  ],
  "draw": {"clock": false, "shadow": false, "text": "#E6FFF2"},
  "tabs": {"inset": 18, "text": "#E6FFF2", "fill": "#4CFFB0/14", "on": "#1F9A6A"},
  "panel": {"fill": {"type": "linear", "stops": [[0, "#3A2514"], [1, "#1A0F07"]]}, "stroke": {"type": "linear", "stops": [[0, "#F0B48C"], [0.5, "#7A3E22"], [1, "#D98F62"]]}, "width": 3, "corner": 10, "text": "pale"},
  "tag": {"fill": {"type": "linear", "stops": [[0, "#2A1A0E"], [1, "#140B05"]]}, "stroke": "#C47A4C", "width": 1.6, "corner": 8, "text": "pale"},
  "tile": {"fill": {"type": "linear", "stops": [[0, "#4A3018"], [1, "#22140A"]]}, "stroke": "#B9803F", "width": 2, "corner": 8, "text": "pale"},
  "particles": [
    {"image": "puff", "color": "#4CFFB0", "rate": 1.4, "max": 10, "area": "hub", "life": [1.4, 2.4], "size": [14, 26], "grow": 2.2, "speed": [10, 26], "dir": [-25, 25], "gravity": -26, "spin": [-20, 20], "opacity": 0.16, "fadein": 0.3, "fadeout": 0.6}
  ],
  "onlaunch": [
    {"image": "puff", "count": 16, "area": "slot", "life": [0.5, 1.0], "size": [16, 34], "grow": 2.2, "speed": [60, 220], "outward": true, "dir": [-120, 120], "drag": 2.6, "gravity": -60, "spin": [-60, 60], "opacity": 0.6, "fadein": 0.02, "fadeout": 0.7},
    {"color": "#8CFFD0", "light": true, "count": 34, "area": "slot", "life": [0.3, 0.8], "size": [1.5, 3.5], "speed": [90, 420], "outward": true, "dir": [-120, 120], "gravity": 200, "drag": 2, "fadein": 0, "fadeout": 0.6}
  ],
  "sounds": {"open": "open.wav", "move": "move.wav", "launch": "launch.wav", "close": "close.wav"}
}
