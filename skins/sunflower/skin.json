{
  "format": 1,
  "id": "sunflower",
  "name": "Sunflower",
  "author": "Radial Taskbar",
  "version": "1.0",
  "about": "Seeds in a golden spiral and petals that open with the wheel; little flowers carry the apps",
  "tags": ["nature", "bright", "summer"],
  "preview": "preview.jpg",
  "style": {"shape": "orb", "material": "solid", "base": "#2A1A08", "accent": "#F2C21E", "accent2": "#FFE08A", "text": "#FFF4D8", "border": "#F2C21E", "opacity": 0.98, "corner": 14, "font": "Candara", "open": "bloom", "speed": 1, "hoverGrow": 3, "iconZoom": 1.12, "glow": 0, "tilt": 0.3, "pointer": false, "burst": false, "shadow": 0.5, "dim": 0.3},
  "wheel": {"hub": 90, "thickness": 92, "gap": 5, "ringgap": 10, "rim": 32, "icon": 42, "crowd": 1.45, "area": 1.1, "hubkeep": 0.76},
  "colors": {"text": "#FFF4D8", "sub": "#E8D08A"},
  "fonts": {"title": "Candara, Segoe UI"},
  "images": {
    "flowers": {"file": "flowers.png", "cols": 2},
    "halo": {"file": "halo.jpg", "light": true},
    "head": {"file": "head.jpg", "mask": "head-mask.png"},
    "middle": {"file": "middle.jpg", "mask": "middle-mask.png"},
    "petal": "petal.png"
  },
  "back": [
    {"shape": "circle", "x": 0.0, "y": 0.04, "size": 1.1, "fill": {"type": "radial", "stops": [[0, "black/55"], [0.86, "black/47"], [1, "black/0"]]}, "opacity": "sat(open)*0.95"},
    {"image": "head", "size": 1.04, "scale": "0.72+0.28*outback(sat(open))", "rotate": "(1-sat(open))*-40+time*0.5", "intro": {"time": 0.5, "ease": "out", "scale": 0.8}}
  ],
  "slot": {
    "intro": {"time": 0.42, "ease": "back", "delay": 0.06, "scale": 0.3, "stagger": 0.02, "order": "both"},
    "under": [
      {"image": "halo", "size": 1.5, "opacity": "hot*0.5", "when": "hot>0.02", "scale": "(1.5*hot)/1.5"},
      {"image": "flowers", "size": "1.08*(1+0.06*hot-0.04*press)", "frame": "(i+ring)%2", "rotate": "time*4*hot+seed*90"}
    ],
    "icon": {"size": 0.48, "zoom": 1.2, "shadow": {"x": 0, "y": 1, "blur": 2, "color": "black/50"}},
    "over": [
      {"shape": "circle", "y": 0.92, "size": 0.15, "fill": "#F2C21E", "when": "running", "opacity": "active ? 1 : 0.75", "glow": 4, "glowcolor": "#FFE08A"},
      {"shape": "circle", "y": 0.92, "size": 0.0825, "fill": "#FFE08A", "when": "running", "opacity": "active ? 1 : 0.35+0.35*wave(time*0.5+seed)"},
      {"shape": "circle", "x": 0.64, "y": -0.64, "size": 0.25, "fill": "#F2C21E", "when": "numbers && number<10 && !kid"},
      {"text": "{number}", "x": 0.64, "y": -0.65, "em": 0.3, "color": "#2A1A08", "font": "title", "weight": 700, "when": "numbers && number<10 && !kid"},
      {"shape": "poly", "points": [[-0.12, -0.6980000000000001], [0, -0.8], [0.12, -0.6980000000000001]], "stroke": "#FFF4D8", "width": 2.2, "caps": true, "when": "group"}
    ],
    "marks": false,
    "chevron": false,
    "badge": false
  },
  "over": [
    {"image": "petal", "size": [0.05, 0.08], "in": "hub", "angle": "sel", "radius": 1.1, "rotate": "sel", "opacity": "on"}
  ],
  "hub": [
    {"image": "middle", "size": 1.0, "rotate": "time*-1", "intro": {"time": 0.5, "ease": "back", "scale": 0.6}},
    {"text": "{title}", "y": -0.05, "box": [1.26, 0.6], "px": 17, "color": "text", "font": "title", "weight": 700, "wrap": true, "shadow": {"x": 0, "y": 1, "blur": 4, "color": "black/90"}},
    {"text": "{sub}", "y": 0.28, "box": [1.1969999999999998, 0.2], "px": 11.5, "color": "sub", "font": "title", "weight": 700, "shadow": {"x": 0, "y": 1, "blur": 4, "color": "black/90"}},
    {"text": "{hh}:{mm}", "y": -0.08, "box": [1.26, 0.55], "px": 31, "color": "text", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 1, "blur": 4, "color": "black/90"}},
    {"text": "{date}", "y": 0.21, "box": [1.1969999999999998, 0.2], "px": 12, "color": "sub", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 1, "blur": 4, "color": "black/90"}}
  ],
  "draw": {"clock": false, "shadow": false, "text": "text"},
  "tabs": {"inset": 13, "text": "text", "fill": "#FFF4D8/14", "on": "#F2C21E/85"},
  "panel": {"fill": {"type": "linear", "stops": [[0, "#4A2E10"], [1, "#2A1A08"]]}, "stroke": "#F2C21E", "width": 3, "corner": 14, "text": "text"},
  "tag": {"fill": {"type": "linear", "stops": [[0, "#4A2E10"], [1, "#2A1A08"]]}, "stroke": "#F2C21E", "width": 2, "corner": 13, "text": "text"},
  "tile": {"fill": {"type": "linear", "stops": [[0, "#FFF4D8"], [1, "#F2DCA0"]]}, "stroke": "#B8801A", "width": 2.4, "corner": 12, "text": "#2A1A08"},
  "onlaunch": [
    {"image": "petal", "count": 22, "area": "slot", "life": [0.7, 1.3], "size": [6, 11], "speed": [80, 260], "outward": true, "dir": [-100, 100], "gravity": 160, "drag": 1.6, "spin": [-260, 260], "sway": 20, "swayhz": 1, "fadein": 0, "fadeout": 0.5}
  ],
  "sounds": {"open": "open.wav", "move": "move.wav", "launch": "launch.wav", "close": "close.wav"},
  "screen": {"effect": "petals", "color": "#F2C21E", "color2": "#FFE08A", "density": 0.6, "speed": 0.7, "size": 1.0}
}
