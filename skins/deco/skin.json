{
  "format": 1,
  "id": "deco",
  "name": "Art Deco",
  "author": "Radial Taskbar",
  "version": "1.0",
  "about": "Black lacquer with brass sunbursts and stepped arcs; apps sit in brass octagons",
  "tags": ["elegant", "gold", "dark"],
  "preview": "preview.jpg",
  "style": {"shape": "orb", "material": "solid", "base": "#0C0C0E", "accent": "#C9A050", "accent2": "#E8D8A8", "text": "#E8D8A8", "border": "#C9A050", "opacity": 0.98, "corner": 14, "font": "Bahnschrift Condensed", "open": "unfold", "speed": 0.9, "hoverGrow": 3, "iconZoom": 1.12, "glow": 0, "tilt": 0.3, "pointer": false, "burst": false, "shadow": 0.5, "dim": 0.45},
  "wheel": {"hub": 90, "thickness": 92, "gap": 5, "ringgap": 10, "rim": 32, "icon": 42, "crowd": 1.45, "area": 1.1, "hubkeep": 0.76},
  "colors": {"text": "#E8D8A8", "sub": "#B8A070"},
  "fonts": {"title": "Bahnschrift Condensed, Bahnschrift"},
  "images": {
    "halo": {"file": "halo.jpg", "light": true},
    "lacquer": {"file": "lacquer.jpg", "mask": "lacquer-mask.png"},
    "octagons": {"file": "octagons.png", "cols": 2},
    "spire": "spire.png",
    "sunburst": {"file": "sunburst.jpg", "mask": "sunburst-mask.png"}
  },
  "back": [
    {"shape": "circle", "x": 0.0, "y": 0.03, "size": 1.08, "fill": {"type": "radial", "stops": [[0, "black/70"], [0.86, "black/60"], [1, "black/0"]]}, "opacity": "sat(open)*0.95"},
    {"image": "lacquer", "size": 1.0, "intro": {"time": 0.45, "ease": "out", "scale": 0.94}}
  ],
  "slot": {
    "intro": {"time": 0.42, "ease": "back", "delay": 0.06, "scale": 0.3, "stagger": 0.02, "order": "both"},
    "under": [
      {"image": "halo", "size": 1.5, "opacity": "hot*0.5", "when": "hot>0.02", "scale": "(1.5*hot)/1.5"},
      {"image": "octagons", "size": "1.0*(1+0.04*hot-0.03*press)", "frame": "hot>0.5 ? 1 : 0"}
    ],
    "icon": {"size": 0.56, "zoom": 1.14, "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/60"}},
    "over": [
      {"shape": "circle", "y": 0.92, "size": 0.15, "fill": "#C9A050", "when": "running", "opacity": "active ? 1 : 0.75", "glow": 4, "glowcolor": "#E8D8A8"},
      {"shape": "circle", "y": 0.92, "size": 0.0825, "fill": "#E8D8A8", "when": "running", "opacity": "active ? 1 : 0.35+0.35*wave(time*0.5+seed)"},
      {"shape": "circle", "x": 0.64, "y": -0.64, "size": 0.25, "fill": "#C9A050", "when": "numbers && number<10 && !kid"},
      {"text": "{number}", "x": 0.64, "y": -0.65, "em": 0.3, "color": "#0C0C0E", "font": "title", "weight": 700, "when": "numbers && number<10 && !kid"},
      {"shape": "poly", "points": [[-0.12, -0.6980000000000001], [0, -0.8], [0.12, -0.6980000000000001]], "stroke": "#E8D8A8", "width": 2.2, "caps": true, "when": "group"}
    ],
    "marks": false,
    "chevron": false,
    "badge": false
  },
  "over": [
    {"image": "spire", "size": [0.05, 0.075], "in": "hub", "angle": "sel", "radius": 1.1, "rotate": "sel", "opacity": "on"}
  ],
  "hub": [
    {"image": "sunburst", "size": 1.0, "rotate": "(1-open)*-45", "intro": {"time": 0.5, "ease": "back", "scale": 0.7}},
    {"text": "{title}", "y": -0.05, "box": [1.26, 0.6], "px": 19, "color": "text", "font": "title", "weight": 700, "wrap": true, "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/70"}},
    {"text": "{sub}", "y": 0.28, "box": [1.1969999999999998, 0.2], "px": 11.5, "color": "sub", "font": "title", "weight": 700, "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/70"}},
    {"text": "{hh}:{mm}", "y": -0.08, "box": [1.26, 0.55], "px": 36, "color": "text", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/70"}},
    {"text": "{date}", "y": 0.21, "box": [1.1969999999999998, 0.2], "px": 13, "color": "sub", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/70"}}
  ],
  "draw": {"clock": false, "shadow": false, "text": "text"},
  "tabs": {"inset": 13, "text": "text", "fill": "#E8D8A8/14", "on": "#C9A050/85"},
  "panel": {"fill": {"type": "linear", "stops": [[0, "#1A1A1C"], [1, "#0C0C0E"]]}, "stroke": "#C9A050", "width": 3, "corner": 14, "text": "text"},
  "tag": {"fill": {"type": "linear", "stops": [[0, "#1A1A1C"], [1, "#0C0C0E"]]}, "stroke": "#C9A050", "width": 2, "corner": 13, "text": "text"},
  "tile": {"fill": {"type": "linear", "stops": [[0, "#E8DCC0"], [1, "#C8B88A"]]}, "stroke": "#8A6A2A", "width": 2.4, "corner": 12, "text": "#0C0C0E"},
  "onlaunch": [
    {"color": "#E8D8A8", "count": 18, "area": "slot", "life": [0.4, 0.8], "size": [1.2, 2.6], "speed": [60, 220], "outward": true, "dir": [-60, 60], "drag": 2, "stretch": 2, "fadein": 0, "fadeout": 0.5}
  ],
  "sounds": {"open": "open.wav", "move": "move.wav", "launch": "launch.wav", "close": "close.wav"}
}
