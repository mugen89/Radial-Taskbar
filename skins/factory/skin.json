{
  "format": 1,
  "id": "factory",
  "name": "Factory",
  "author": "Radial Taskbar",
  "version": "1.0",
  "about": "A conveyor belt runs round a steel floor with hazard stripes; apps ride on crates, a big gear turns in the middle",
  "tags": ["industrial", "metal", "orange"],
  "preview": "preview.jpg",
  "style": {"shape": "orb", "material": "solid", "base": "#22262B", "accent": "#F28C28", "accent2": "#FFD23A", "text": "#F4F4F0", "border": "#F28C28", "opacity": 0.98, "corner": 14, "font": "Bahnschrift", "open": "spin", "speed": 1, "hoverGrow": 3, "iconZoom": 1.12, "glow": 0, "tilt": 0.3, "pointer": false, "burst": false, "shadow": 0.5, "dim": 0.38},
  "wheel": {"hub": 90, "thickness": 92, "gap": 5, "ringgap": 10, "rim": 32, "icon": 42, "crowd": 1.45, "area": 1.1, "hubkeep": 0.76},
  "colors": {"text": "#F4F4F0", "sub": "#C8CDD2"},
  "fonts": {"title": "Bahnschrift, Segoe UI"},
  "images": {
    "belt": {"file": "belt.jpg", "mask": "belt-mask.png"},
    "chevron": "chevron.png",
    "crates": {"file": "crates.png", "cols": 4},
    "floor": {"file": "floor.jpg", "mask": "floor-mask.png"},
    "gear": {"file": "gear.jpg", "mask": "gear-mask.png"},
    "halo": {"file": "halo.jpg", "light": true}
  },
  "back": [
    {"shape": "circle", "x": 0.0, "y": 0.03, "size": 1.1, "fill": {"type": "radial", "stops": [[0, "black/65"], [0.86, "black/55"], [1, "black/0"]]}, "opacity": "sat(open)*0.95"},
    {"image": "floor", "size": 1.0, "intro": {"time": 0.35, "ease": "out", "scale": 0.92}},
    {"image": "belt", "size": 1.0, "rotate": "time*-4+(1-open)*-60"}
  ],
  "slot": {
    "intro": {"time": 0.42, "ease": "back", "delay": 0.06, "scale": 0.3, "stagger": 0.02, "order": "both"},
    "under": [
      {"image": "halo", "size": 1.6, "opacity": "hot*0.6", "when": "hot>0.02", "scale": "(1.6*hot)/1.6"},
      {"image": "crates", "size": "0.92*(1+0.05*hot-0.04*press)", "frame": "(i+ring)%4", "rotate": "seed*12-6"}
    ],
    "icon": {"size": 0.7, "zoom": 1.14, "shadow": {"x": 1, "y": 2, "blur": 2, "color": "black/55"}},
    "over": [
      {"shape": "circle", "y": 0.92, "size": 0.15, "fill": "#F28C28", "when": "running", "opacity": "active ? 1 : 0.75", "glow": 4, "glowcolor": "#FFD23A"},
      {"shape": "circle", "y": 0.92, "size": 0.0825, "fill": "#FFD23A", "when": "running", "opacity": "active ? 1 : 0.35+0.35*wave(time*0.5+seed)"},
      {"shape": "circle", "x": 0.64, "y": -0.64, "size": 0.25, "fill": "#FFD23A", "when": "numbers && number<10 && !kid"},
      {"text": "{number}", "x": 0.64, "y": -0.65, "em": 0.3, "color": "#22262B", "font": "title", "weight": 700, "when": "numbers && number<10 && !kid"},
      {"shape": "poly", "points": [[-0.12, -0.6980000000000001], [0, -0.8], [0.12, -0.6980000000000001]], "stroke": "#F4F4F0", "width": 2.2, "caps": true, "when": "group"}
    ],
    "marks": false,
    "chevron": false,
    "badge": false
  },
  "over": [
    {"image": "chevron", "size": [0.075, 0.09], "in": "hub", "angle": "sel", "radius": 1.12, "rotate": "sel", "opacity": "on"}
  ],
  "hub": [
    {"image": "gear", "size": 1.0, "rotate": "time*8+(1-open)*-120", "intro": {"time": 0.4, "ease": "back", "scale": 0.6}},
    {"shape": "circle", "size": 0.78, "fill": "#22262B"},
    {"text": "{title}", "y": -0.05, "box": [1.26, 0.6], "px": 17, "color": "text", "font": "title", "weight": 700, "wrap": true, "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/70"}},
    {"text": "{sub}", "y": 0.28, "box": [1.178, 0.2], "px": 11.5, "color": "sub", "font": "title", "weight": 700, "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/70"}},
    {"text": "{hh}:{mm}", "y": -0.08, "box": [1.24, 0.55], "px": 31, "color": "text", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/70"}},
    {"text": "{date}", "y": 0.21, "box": [1.178, 0.2], "px": 12, "color": "sub", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/70"}}
  ],
  "draw": {"clock": false, "shadow": false, "text": "text"},
  "tabs": {"inset": 13, "text": "text", "fill": "#F4F4F0/14", "on": "#F28C28/85"},
  "panel": {"fill": {"type": "linear", "stops": [[0, "#33383E"], [1, "#1E2226"]]}, "stroke": "#F28C28", "width": 3, "corner": 14, "text": "text"},
  "tag": {"fill": {"type": "linear", "stops": [[0, "#33383E"], [1, "#1E2226"]]}, "stroke": "#F28C28", "width": 2, "corner": 13, "text": "text"},
  "tile": {"fill": {"type": "linear", "stops": [[0, "#E8EAEC"], [1, "#C8CDD2"]]}, "stroke": "#6A6E74", "width": 2.4, "corner": 12, "text": "#22262B"},
  "onhover": [
    {"color": "#FFC45A", "count": 6, "area": "slot", "life": [0.2, 0.4], "size": [1, 2], "speed": [60, 160], "outward": true, "dir": [-40, 40], "gravity": 600, "stretch": 2, "fadein": 0, "fadeout": 0.5}
  ],
  "onlaunch": [
    {"color": "#FFC45A", "count": 34, "area": "slot", "life": [0.3, 0.7], "size": [1.5, 3], "speed": [180, 520], "outward": true, "dir": [-60, 60], "gravity": 900, "stretch": 2.5, "fadein": 0, "fadeout": 0.4}
  ],
  "sounds": {"open": "open.wav", "move": "move.wav", "launch": "launch.wav", "close": "close.wav"}
}
