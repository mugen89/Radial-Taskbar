{
  "format": 1,
  "id": "mosaic",
  "name": "Mosaic",
  "author": "Radial Taskbar",
  "version": "1.0",
  "about": "An antique floor of small stone tiles; an app's tile turns over to show glass and gold beneath",
  "tags": ["ancient", "warm", "stone"],
  "preview": "preview.jpg",
  "style": {"shape": "orb", "material": "solid", "base": "#3A2A1E", "accent": "#C8642A", "accent2": "#2A8AA8", "text": "#2A1E14", "border": "#C8642A", "opacity": 0.98, "corner": 14, "font": "Cinzel", "open": "bloom", "speed": 0.9, "hoverGrow": 3, "iconZoom": 1.12, "glow": 0, "tilt": 0.3, "pointer": false, "burst": false, "shadow": 0.5, "dim": 0.3},
  "wheel": {"hub": 90, "thickness": 92, "gap": 5, "ringgap": 10, "rim": 32, "icon": 42, "crowd": 1.45, "area": 1.1, "hubkeep": 0.76},
  "colors": {"text": "#2A1E14", "sub": "#5A4A3A"},
  "fonts": {"title": {"file": "Cinzel[wght].ttf", "family": "Cinzel"}},
  "images": {
    "flips": {"file": "flips.png", "cols": 2},
    "floor": {"file": "floor.jpg", "mask": "floor-mask.png"},
    "halo": {"file": "halo.jpg", "light": true},
    "rosette": {"file": "rosette.jpg", "mask": "rosette-mask.png"},
    "tessera": "tessera.png"
  },
  "back": [
    {"shape": "circle", "x": 0.0, "y": 0.03, "size": 1.08, "fill": {"type": "radial", "stops": [[0, "black/60"], [0.86, "black/51"], [1, "black/0"]]}, "opacity": "sat(open)*0.95"},
    {"image": "floor", "size": 1.0, "intro": {"time": 0.45, "ease": "out", "scale": 0.94}}
  ],
  "slot": {
    "intro": {"time": 0.42, "ease": "back", "delay": 0.06, "scale": 0.3, "stagger": 0.02, "order": "both"},
    "under": [
      {"image": "halo", "size": 1.5, "opacity": "hot*0.5", "when": "hot>0.02", "scale": "(1.5*hot)/1.5"},
      {"shape": "circle", "x": 0.0, "y": 0.06, "size": 0.92, "fill": {"type": "radial", "stops": [[0, "black/40"], [0.86, "black/34"], [1, "black/0"]]}, "opacity": "sat(open)*0.95"},
      {"image": "flips", "size": "0.96*(1+0.05*hot-0.03*press)", "frame": "hot>0.5 ? 1 : 0", "rotate": "a", "scale": ["max(0.04,abs(cos(sat(hot)*3.14159)))", "1"]}
    ],
    "icon": {"size": 0.56, "zoom": 1.14, "shadow": {"x": 0, "y": 1, "blur": 2, "color": "black/50"}},
    "over": [
      {"shape": "circle", "y": 0.92, "size": 0.15, "fill": "#C8642A", "when": "running", "opacity": "active ? 1 : 0.75", "glow": 4, "glowcolor": "#2A8AA8"},
      {"shape": "circle", "y": 0.92, "size": 0.0825, "fill": "#2A8AA8", "when": "running", "opacity": "active ? 1 : 0.35+0.35*wave(time*0.5+seed)"},
      {"shape": "circle", "x": 0.64, "y": -0.64, "size": 0.25, "fill": "#8A3A22", "when": "numbers && number<10 && !kid"},
      {"text": "{number}", "x": 0.64, "y": -0.65, "em": 0.3, "color": "#F2E8D4", "font": "title", "weight": 700, "when": "numbers && number<10 && !kid"},
      {"shape": "poly", "points": [[-0.12, -0.6980000000000001], [0, -0.8], [0.12, -0.6980000000000001]], "stroke": "#2A1E14", "width": 2.2, "caps": true, "when": "group"}
    ],
    "marks": false,
    "chevron": false,
    "badge": false
  },
  "over": [
    {"image": "tessera", "size": [0.06, 0.06], "in": "hub", "angle": "sel", "radius": 1.1, "rotate": "sel", "opacity": "on"}
  ],
  "hub": [
    {"image": "rosette", "size": 1.0, "intro": {"time": 0.45, "ease": "back", "scale": 0.7}},
    {"text": "{title}", "y": -0.05, "box": [1.26, 0.6], "px": 16, "color": "text", "font": "title", "weight": 700, "wrap": true, "shadow": {"x": 0, "y": 0, "blur": 2, "color": "#F2E8D4"}},
    {"text": "{sub}", "y": 0.28, "box": [1.1969999999999998, 0.2], "px": 11.5, "color": "sub", "font": "title", "weight": 700, "shadow": {"x": 0, "y": 0, "blur": 2, "color": "#F2E8D4"}},
    {"text": "{hh}:{mm}", "y": -0.08, "box": [1.26, 0.55], "px": 29, "color": "text", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 0, "blur": 2, "color": "#F2E8D4"}},
    {"text": "{date}", "y": 0.21, "box": [1.1969999999999998, 0.2], "px": 12, "color": "sub", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 0, "blur": 2, "color": "#F2E8D4"}}
  ],
  "draw": {"clock": false, "shadow": false, "text": "text"},
  "tabs": {"inset": 13, "text": "#F2E8D4", "fill": "#00000033", "on": "#C8642A/85"},
  "panel": {"fill": {"type": "linear", "stops": [[0, "#F2E8D4"], [1, "#E0D2B8"]]}, "stroke": "#8A3A22", "width": 3, "corner": 14, "text": "#2A1E14"},
  "tag": {"fill": {"type": "linear", "stops": [[0, "#F2E8D4"], [1, "#E0D2B8"]]}, "stroke": "#8A3A22", "width": 2, "corner": 13, "text": "#2A1E14"},
  "tile": {"fill": {"type": "linear", "stops": [[0, "#F2E8D4"], [1, "#E0D2B8"]]}, "stroke": "#8A6A4A", "width": 2.4, "corner": 12, "text": "#2A1E14"},
  "onlaunch": [
    {"image": "tessera", "count": 16, "area": "slot", "life": [0.5, 0.9], "size": [4, 8], "speed": [100, 280], "outward": true, "dir": [-80, 80], "gravity": 700, "spin": [-400, 400], "fadein": 0, "fadeout": 0.3}
  ],
  "sounds": {"open": "open.wav", "move": "move.wav", "launch": "launch.wav", "close": "close.wav"}
}
