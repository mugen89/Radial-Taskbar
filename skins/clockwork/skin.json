{
  "format": 1,
  "id": "clockwork",
  "name": "Clockwork",
  "author": "Radial Taskbar",
  "version": "1.0",
  "about": "Walnut, brass and porcelain, with a clock that keeps time",
  "tags": ["steampunk", "brass", "clock"],

  "style": {
    "shape": "orb", "material": "solid", "base": "#2A1A10", "accent": "#FFB347", "accent2": "#E2703A", "text": "#F6E7CC", "border": "#D9A95A",
    "opacity": 0.96, "corner": 10, "font": "Palatino Linotype", "open": "bloom", "speed": 1, "hoverGrow": 5, "iconZoom": 1.12, "glow": 0.5,
    "tilt": 0.45, "pointer": false, "burst": false, "shadow": 0.7, "dim": 0.34
  },
  "wheel": { "hub": 96, "thickness": 92, "gap": 5, "ringgap": 36, "rim": 32, "icon": 46, "crowd": 1.42, "area": [1.34, 1.30, 1.34, 1.30], "hubkeep": 0.72 },
  "colors": { "ink": "#2B1B0E", "cream": "#F4E6C8", "lamp": "#FFB347" },
  "fonts": { "title": "Palatino Linotype, Book Antiqua, Georgia" },

  "images": {
    "plate": { "file": "plate.jpg", "mask": "plate-mask.png" },
    "gear": { "file": "gear.jpg", "mask": "gear-mask.png" },
    "gear2": { "file": "gear2.jpg", "mask": "gear2-mask.png" },
    "gear3": { "file": "gear3.jpg", "mask": "gear3-mask.png" },
    "socket": { "file": "socket.jpg", "mask": "socket-mask.png" },
    "dial": { "file": "dial.jpg", "mask": "dial-mask.png" },
    "pointer": { "file": "pointer.jpg", "mask": "pointer-mask.png" },
    "cartouche": { "file": "cartouche.jpg", "mask": "cartouche-mask.png" },
    "glass": "glass.png",
    "lamp": { "file": "lamp.png", "light": true },
    "halo": { "file": "halo.png", "light": true },
    "jewel": "jewel.png", "jewel_on": "jewel_on.png",
    "hour": "hour.png", "minute": "minute.png", "second": "second.png", "pin": "pin.png",
    "steam": "steam.png",
    "spark": { "file": "spark.png", "light": true }
  },

  // gears behind the wheel; teeth mesh because the turning speeds follow the tooth counts (30 : 20 : 44)
  "back": [
    { "shape": "circle", "x": -0.80, "y": -0.70, "size": 0.40, "fill": { "type": "radial", "stops": [[0, "black/55"], [0.75, "black/45"], [1, "black/0"]] }, "opacity": "open" },
    { "shape": "circle", "x": 0.86, "y": 0.66, "size": 0.40, "fill": { "type": "radial", "stops": [[0, "black/55"], [0.75, "black/45"], [1, "black/0"]] }, "opacity": "open" },
    { "image": "gear3", "x": 0.80, "y": 0.64, "size": 0.40, "rotate": "time*-9", "intro": { "time": 0.7, "ease": "out", "rotate": 260, "scale": 0.5, "x": -0.35, "y": -0.28 } },
    { "image": "gear", "x": -0.78, "y": -0.70, "size": 0.36, "rotate": "time*13.2", "intro": { "time": 0.7, "ease": "out", "rotate": -300, "scale": 0.5, "x": 0.35, "y": 0.30 } },
    { "image": "gear2", "x": -0.98, "y": -0.16, "size": 0.25, "rotate": "time*-19.8+4", "intro": { "delay": 0.04, "time": 0.7, "ease": "out", "rotate": 320, "scale": 0.5, "x": 0.4, "y": 0.1 } },
    { "image": "gear2", "x": 0.60, "y": -0.94, "size": 0.22, "rotate": "time*22", "intro": { "delay": 0.06, "time": 0.7, "ease": "out", "rotate": -320, "scale": 0.5, "x": -0.2, "y": 0.4 } }
  ],

  "ring": [
    { "shape": "circle", "y": 0.02, "size": 1.10, "fill": { "type": "radial", "stops": [[0, "black/70"], [0.88, "black/62"], [1, "black/0"]] }, "opacity": "open*0.9" },
    { "image": "plate", "size": 1, "rotate": "(1-open)*-50", "intro": { "time": 0.34, "ease": "out", "scale": 0.82 } }
  ],

  "slot": {
    "intro": { "time": 0.36, "ease": "back", "scale": 0.1, "rotate": -120, "radius": -0.25, "stagger": 0.022, "order": "both" },
    "under": [
      { "shape": "circle", "y": 0.06, "size": 1.10, "fill": { "type": "radial", "stops": [[0, "black/60"], [0.86, "black/55"], [1, "black/0"]] } },
      { "image": "halo", "size": "1.7", "opacity": "0.75*hot" },
      { "image": "socket", "size": "1+0.03*hot-0.03*press", "rotate": "hot*24" , "detail": 1.06 },
      { "image": "lamp", "size": 1, "opacity": "hot*(0.8+0.2*noise(time*9+i))+launch" }
    ],
    "icon": { "size": 1.06, "zoom": 1.14, "shadow": { "y": 2, "blur": 3, "color": "black/60" } },
    "over": [
      { "image": "glass", "size": 0.80, "opacity": "0.85-0.25*hot" },
      { "image": "jewel", "in": "cell", "size": 0.17, "y": 0.90, "when": "running" },
      { "image": "jewel_on", "in": "cell", "size": 0.17, "y": 0.90, "when": "running", "opacity": "active ? 1 : 0.55+0.25*wave(time*0.5+seed)" },
      { "image": "halo", "size": 0.42, "y": 0.90, "when": "active", "opacity": 0.5, "tint": "#FF3040" },
      { "shape": "circle", "in": "cell", "x": 0.68, "y": -0.68, "size": 0.21, "fill": "#F2E6CB", "stroke": "#8A6427", "width": 1.2, "when": "numbers && number<10 && !kid" },
      { "text": "{number}", "in": "cell", "x": 0.68, "y": -0.69, "em": 0.27, "color": "ink", "font": "title", "weight": 700, "when": "numbers && number<10 && !kid" },
      { "text": "❖", "in": "cell", "y": -0.89, "em": 0.22, "color": "cream", "when": "group" }
    ],
    "marks": false, "chevron": false, "badge": false
  },

  "over": [
    { "shape": "circle", "in": "hub", "y": 0.04, "size": 1.18, "fill": { "type": "radial", "stops": [[0, "black/80"], [0.78, "black/60"], [1, "black/0"]] }, "opacity": "open" },
    { "image": "pointer", "in": "hub", "size": 1.15, "rotate": "sel", "opacity": "open", "intro": { "time": 0.4, "ease": "out", "rotate": -180, "scale": 0.7 } }
  ],

  "hub": [
    { "image": "dial", "size": 0.93, "intro": { "time": 0.34, "ease": "back", "scale": 0.4 } },
    { "image": "hour", "size": [0.155, 0.93], "rotate": "hour*30", "opacity": "0.22+0.78*idle", "intro": { "time": 0.5, "ease": "back", "rotate": -200 } },
    { "image": "minute", "size": [0.155, 0.93], "rotate": "minute*6", "opacity": "0.22+0.78*idle", "intro": { "time": 0.5, "ease": "back", "rotate": 240 } },
    { "image": "second", "size": [0.155, 0.93], "rotate": "tick*6", "opacity": "0.22+0.78*idle" },
    { "image": "pin", "size": 0.07, "opacity": "idle" },
    { "image": "cartouche", "size": 0.80, "opacity": "1-idle", "scale": "0.9+0.1*(1-idle)" },
    { "text": "{title}", "y": -0.035, "box": [1.18, 0.34], "px": 16, "color": "ink", "font": "title", "weight": 700, "wrap": true },
    { "text": "{sub}", "y": 0.150, "box": [1.18, 0.12], "px": 9.5, "color": "ink", "font": "title", "italic": true, "opacity": 0.8 }
  ],

  "draw": { "clock": false, "shadow": false, "text": "ink" },
  "tabs": { "inset": 13, "text": "ink", "fill": "#B4914F/80", "on": "#8E3B16" },

  "panel": { "fill": { "type": "linear", "stops": [[0, "#3A2415"], [1, "#22130A"]] }, "stroke": { "type": "linear", "stops": [[0, "#F0C97A"], [0.5, "#8A6427"], [1, "#D9A95A"]] }, "width": 2, "corner": 10, "text": "cream" },

  "onlaunch": [
    { "image": "steam", "count": 14, "area": "slot", "life": [0.35, 0.7], "size": [16, 34], "grow": 2.6, "speed": [60, 190], "outward": true, "dir": [-50, 50], "drag": 3, "spin": [-60, 60], "opacity": 0.8, "fadein": 0.05, "fadeout": 0.8 },
    { "image": "spark", "light": true, "count": 22, "area": "slot", "life": [0.2, 0.5], "size": [4, 10], "speed": [120, 420], "outward": true, "dir": [-70, 70], "gravity": 500, "drag": 2, "fadeout": 0.6 }
  ],
  "particles": [
    { "image": "steam", "rate": "2.2", "max": 10, "area": "rim", "outward": true, "life": [1.2, 2.2], "size": [10, 20], "grow": 3, "speed": [8, 26], "dir": [-30, 30], "gravity": -30, "spin": [-30, 30], "opacity": 0.35, "fadein": 0.2, "fadeout": 0.7 }
  ],
  "sounds": { "open": "open.wav", "move": "move.wav", "launch": "launch.wav", "close": "close.wav" }
}
