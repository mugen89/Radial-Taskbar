{
  "format": 1,
  "id": "hologram",
  "name": "Hologram",
  "author": "Radial Taskbar",
  "version": "1.0",
  "license": "Font Rajdhani: SIL Open Font License, see OFL.txt",
  "about": "Thin figures of light above a small projector, with scan lines and glitches",
  "tags": ["sci-fi", "light", "blue"],
  "preview": "preview.jpg",
  "style": {"shape": "orb", "material": "solid", "base": "#04141E", "accent": "#4FE3FF", "accent2": "#FF4FD8", "text": "#D6F8FF", "border": "#2FA9C9", "opacity": 0.92, "corner": 6, "font": "Rajdhani", "open": "zoom", "speed": 1.1, "hoverGrow": 3, "iconZoom": 1.12, "glow": 0.8, "tilt": 0.8, "pointer": false, "burst": false, "shadow": 0.3, "dim": 0.46},
  "wheel": {"hub": 86, "thickness": 92, "gap": 6, "ringgap": 10, "rim": 26, "icon": 44, "crowd": 1.5, "area": 1.16, "hubkeep": 0.86},
  "colors": {"c": "#4FE3FF", "m": "#FF4FD8", "pale": "#D6F8FF"},
  "fonts": {"title": {"file": "Rajdhani-SemiBold.ttf", "family": "Rajdhani"}},
  "images": {
    "beam": {"file": "beam.jpg", "light": true},
    "cone": {"file": "cone.jpg", "light": true},
    "flash": {"file": "flash.jpg", "light": true},
    "floor": {"file": "floor.jpg", "light": true},
    "halo": {"file": "halo.jpg", "light": true},
    "lines": {"file": "lines.png", "sharp": true},
    "projector": {"file": "projector.jpg", "mask": "projector-mask.png"}
  },
  "back": [
    {"shape": "circle", "size": 1.12, "fill": {"type": "radial", "stops": [[0, "#021019/92"], [0.62, "#021019/78"], [0.9, "#021019/45"], [1, "#021019/0"]]}, "opacity": "sat(open)"},
    {"image": "projector", "size": 0.4, "intro": {"time": 0.22, "ease": "out", "scale": 0.6}},
    {"image": "floor", "size": 1.05, "rotate": "time*1.5", "opacity": "0.26*sat(open)", "depth": -0.5},
    {"image": "cone", "size": 1.04, "rotate": "time*5", "opacity": "(0.36+0.08*noise(time*12))*sat(open)", "scale": "0.4+0.6*outcubic(sat(time*3))"},
    {"image": "cone", "size": 1.04, "rotate": "-time*8+40", "opacity": "0.18*sat(open)", "scale": "0.4+0.6*outcubic(sat(time*2.6))"}
  ],
  "ring": [
    {"shape": "arc", "in": "px", "from": 0, "r": "ringout+5", "to": "360*outcubic(sat(time*2.4))", "stroke": "c/75", "width": 1.4, "glow": 5, "glowcolor": "c", "depth": 0.5},
    {"shape": "arc", "in": "px", "from": "j*120+time*14", "r": "ringout+12", "to": "j*120+46+time*14", "copies": 3, "stroke": "c", "width": 2.6, "opacity": 0.8, "depth": 0.8, "glow": 5, "glowcolor": "c"},
    {"shape": "arc", "in": "px", "from": "j*90-time*22", "r": "ringin-6", "to": "j*90+24-time*22", "copies": 4, "stroke": "m/85", "width": 2, "opacity": 0.8, "depth": 0.3},
    {"shape": "ticks", "in": "px", "inner": "ringout+7", "outer": "ringout+10", "count": 120, "major": 10, "stroke": "c/45", "width": 1, "depth": 0.5}
  ],
  "slot": {
    "intro": {"time": 0.22, "ease": "out", "delay": 0.06, "scale": 0.3, "y": 0.5, "stagger": 0.02, "order": "ring"},
    "under": [
      {"image": "beam", "size": [1.05, 1.5], "y": 0.35, "opacity": "sat(hot)*0.75*(0.86+0.14*noise(time*17+i*9))"},
      {"image": "halo", "size": 1.7, "opacity": "0.10+0.40*hot+launch*2"},
      {"shape": "circle", "size": 0.96, "fill": "#05202E/55"},
      {"shape": "arc", "r": 0.96, "from": 0, "to": 360, "stroke": "c", "width": 1.4, "opacity": "(0.45+0.55*sat(hot))*(0.86+0.14*noise(time*17+i*9))", "glow": 4, "glowcolor": "c"},
      {"shape": "arc", "r": 1.06, "from": "j*120+time*(20+60*hot)", "to": "j*120+34+time*(20+60*hot)", "copies": 3, "stroke": "c", "width": 2, "opacity": "0.35+0.65*sat(hot)"}
    ],
    "icon": {"size": 1.1, "zoom": 1.14, "tone": "duo", "hot": "original", "ink": "#04384C", "paper": "#8DF1FF", "x": "0.10*(step(0.965,noise(time*9+0))*(noise(time*60+0)-0.5)*motion)", "opacity": "0.92*(0.86+0.14*noise(time*17+i*9))"},
    "over": [
      {"shape": "circle", "size": 0.94, "fill": {"image": "lines", "tile": true, "zoom": 0.018, "v": "time*0.35"}, "opacity": 0.75},
      {"image": "flash", "size": [1.1, 0.5], "y": "-1.0+2.0*fract(time*0.5+i*0.13)", "opacity": "0.22+0.4*hot"},
      {"shape": "rect", "x": "0.5*(rnd(floor(time*24)+j)-0.5)", "y": "-0.8+1.6*rnd(floor(time*30)+j*3)", "size": ["0.5+0.5*rnd(floor(time*28)+j*7)", 0.035], "copies": 7, "fill": "c", "opacity": "launch*0.9"},
      {"shape": "circle", "y": 0.96, "size": 0.1, "fill": "c", "when": "running", "opacity": "active ? 1 : 0.6", "glow": 6, "glowcolor": "c"},
      {"shape": "arc", "r": 0.18, "y": 0.96, "from": 0, "to": 360, "stroke": "c", "width": 1.2, "when": "active", "scale": "1+0.4*fract(time)", "opacity": "1-fract(time)"},
      {"shape": "circle", "x": 0.7, "y": -0.7, "size": 0.25, "fill": "#04141E", "when": "numbers && number<10 && !kid", "stroke": "#4FE3FF", "width": 1.2},
      {"text": "{number}", "x": 0.7, "y": -0.71, "em": 0.34, "color": "c", "font": "title", "weight": 700, "when": "numbers && number<10 && !kid"},
      {"shape": "poly", "points": [[-0.12, -0.878], [0, -0.98], [0.12, -0.878]], "stroke": "c", "width": 2.2, "caps": true, "when": "group"}
    ],
    "marks": false,
    "chevron": false,
    "badge": false
  },
  "over": [
    {"shape": "line", "in": "px", "points": [["sin(rad(sel))*(hub+2)", "-cos(rad(sel))*(hub+2)"], ["sin(rad(sel))*(hub+16)", "-cos(rad(sel))*(hub+16)"]], "stroke": "c", "width": 2.4, "opacity": "on", "glow": 6, "glowcolor": "c", "caps": true}
  ],
  "hub": [
    {"shape": "circle", "size": 0.97, "fill": "#031019/60"},
    {"shape": "arc", "r": 0.97, "from": 0, "to": 360, "stroke": "c/70", "width": 1.4, "glow": 5, "glowcolor": "c"},
    {"shape": "arc", "r": 0.9, "from": "sel-24", "to": "sel+24", "stroke": "c", "width": 3, "opacity": "on", "glow": 6, "glowcolor": "c"},
    {"shape": "arc", "r": 0.9, "from": "time*30", "to": "time*30+70", "stroke": "m/80", "width": 1.6},
    {"shape": "arc", "r": 0.84, "from": "j*30", "to": "j*30+9", "copies": 12, "stroke": "c/35", "width": 1.4},
    {"text": "{title}", "y": -0.05, "box": [1.4, 0.66], "px": 19, "color": "pale", "font": "title", "weight": 600, "wrap": true, "shadow": {"x": 0, "y": 0, "blur": 6, "color": "#4FE3FF"}, "x": "0.05*(step(0.965,noise(time*9+50))*(noise(time*60+50)-0.5)*motion)"},
    {"text": "{sub}", "y": 0.28, "box": [1.3299999999999998, 0.2], "px": 13, "color": "c", "font": "title", "weight": 600, "shadow": {"x": 0, "y": 0, "blur": 6, "color": "#4FE3FF"}, "x": "0.05*(step(0.965,noise(time*9+50))*(noise(time*60+50)-0.5)*motion)"},
    {"text": "{hh}:{mm}", "y": -0.08, "box": [1.4, 0.55], "px": 36, "color": "pale", "font": "title", "weight": 600, "opacity": "idle", "shadow": {"x": 0, "y": 0, "blur": 6, "color": "#4FE3FF"}, "x": "0.05*(step(0.965,noise(time*9+50))*(noise(time*60+50)-0.5)*motion)"},
    {"text": "{date}", "y": 0.21, "box": [1.3299999999999998, 0.2], "px": 13, "color": "c", "font": "title", "weight": 600, "opacity": "idle", "shadow": {"x": 0, "y": 0, "blur": 6, "color": "#4FE3FF"}, "x": "0.05*(step(0.965,noise(time*9+50))*(noise(time*60+50)-0.5)*motion)"},
    {"shape": "circle", "size": 0.96, "fill": {"image": "lines", "tile": true, "zoom": 0.014, "v": "time*0.3"}, "opacity": 0.5}
  ],
  "fan": [
    {"shape": "ring", "in": "px", "inner": "ringin-2", "outer": "ringout+3", "from": "a-span/2-2", "to": "a+span/2+2", "fill": "#04141E/85", "stroke": "c", "width": 1.4, "glow": 4, "glowcolor": "c"}
  ],
  "draw": {"clock": false, "shadow": false, "text": "pale", "fan": false},
  "tabs": {"inset": 13, "text": "pale", "fill": "#4FE3FF/12", "on": "#4FE3FF/45"},
  "panel": {"fill": "#04141E/90", "stroke": "c", "width": 1.4, "corner": 10, "cutcorner": true, "text": "pale"},
  "tag": {"fill": "#04141E/92", "stroke": "c", "width": 1.3, "corner": 7, "cutcorner": true, "text": "pale"},
  "tile": {"fill": {"type": "linear", "stops": [[0, "#0A3244/92"], [1, "#04141E/92"]]}, "stroke": "c", "width": 1.3, "corner": 8, "cutcorner": true, "text": "pale"},
  "particles": [
    {"color": "#4FE3FF", "light": true, "rate": 9, "max": 40, "area": "wheel", "life": [0.8, 1.8], "size": [1, 2.2], "speed": [14, 40], "dir": [-8, 8], "gravity": -30, "fadein": 0.2, "fadeout": 0.5, "opacity": 0.8}
  ],
  "onlaunch": [
    {"color": "#4FE3FF", "light": true, "count": 40, "area": "slot", "life": [0.25, 0.6], "size": [1.5, 3], "speed": [120, 520], "outward": true, "dir": [-90, 90], "drag": 3, "stretch": 1, "fadein": 0, "fadeout": 0.6},
    {"color": "#FF4FD8", "light": true, "count": 14, "area": "slot", "life": [0.25, 0.5], "size": [1.5, 3], "speed": [80, 360], "outward": true, "dir": [-90, 90], "drag": 3, "stretch": 1, "fadein": 0, "fadeout": 0.6}
  ],
  "sounds": {"open": "open.wav", "move": "move.wav", "launch": "launch.wav", "close": "close.wav"}
}
