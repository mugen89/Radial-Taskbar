{
  "format": 1,
  "id": "stickers",
  "name": "Sticker Album",
  "author": "Radial Taskbar",
  "version": "1.0",
  "about": "A scrapbook page with washi tape; every app is a die-cut sticker with a corner curling up",
  "tags": ["playful", "paper", "bright"],
  "preview": "preview.jpg",
  "style": {"shape": "orb", "material": "solid", "base": "#F2E6D0", "accent": "#FF6A4A", "accent2": "#4AA8E8", "text": "#2A2A3A", "border": "#FF6A4A", "opacity": 0.98, "corner": 14, "font": "Segoe UI Black", "open": "bloom", "speed": 1.05, "hoverGrow": 3, "iconZoom": 1.12, "glow": 0, "tilt": 0.3, "pointer": false, "burst": false, "shadow": 0.5, "dim": 0.22},
  "wheel": {"hub": 90, "thickness": 92, "gap": 5, "ringgap": 10, "rim": 32, "icon": 42, "crowd": 1.45, "area": 1.1, "hubkeep": 0.76},
  "colors": {"text": "#2A2A3A", "sub": "#5A5A6A"},
  "fonts": {"title": "Segoe UI Black, Segoe UI"},
  "images": {
    "badge": {"file": "badge.jpg", "mask": "badge-mask.png"},
    "halo": {"file": "halo.jpg", "light": true},
    "page": {"file": "page.jpg", "mask": "page-mask.png"},
    "stars": {"file": "stars.png", "cols": 4},
    "stickers": {"file": "stickers.png", "cols": 4}
  },
  "back": [
    {"shape": "circle", "x": 0.0, "y": 0.03, "size": 1.06, "fill": {"type": "radial", "stops": [[0, "black/45"], [0.86, "black/38"], [1, "black/0"]]}, "opacity": "sat(open)*0.95"},
    {"image": "page", "size": 1.0, "intro": {"time": 0.4, "ease": "out", "scale": 0.95}}
  ],
  "slot": {
    "intro": {"time": 0.42, "ease": "back", "delay": 0.06, "scale": 0.3, "stagger": 0.02, "order": "both"},
    "under": [
      {"image": "halo", "size": 1.5, "opacity": "hot*0.5", "when": "hot>0.02", "scale": "(1.5*hot)/1.5"},
      {"image": "stickers", "size": "1.08*(1+0.06*hot-0.04*press)", "frame": "(i+ring)%4", "rotate": "seed*30-15"}
    ],
    "icon": {"size": 0.48, "zoom": 1.18, "tone": "sticker", "shadow": {"x": 0, "y": 1, "blur": 2, "color": "black/25"}},
    "over": [
      {"shape": "circle", "y": 0.92, "size": 0.15, "fill": "#FF6A4A", "when": "running", "opacity": "active ? 1 : 0.75", "glow": 4, "glowcolor": "#4AA8E8"},
      {"shape": "circle", "y": 0.92, "size": 0.0825, "fill": "#4AA8E8", "when": "running", "opacity": "active ? 1 : 0.35+0.35*wave(time*0.5+seed)"},
      {"shape": "circle", "x": 0.64, "y": -0.64, "size": 0.25, "fill": "#4AA8E8", "when": "numbers && number<10 && !kid"},
      {"text": "{number}", "x": 0.64, "y": -0.65, "em": 0.3, "color": "#FFFFFF", "font": "title", "weight": 700, "when": "numbers && number<10 && !kid"},
      {"shape": "poly", "points": [[-0.12, -0.6980000000000001], [0, -0.8], [0.12, -0.6980000000000001]], "stroke": "#2A2A3A", "width": 2.2, "caps": true, "when": "group"}
    ],
    "marks": false,
    "chevron": false,
    "badge": false
  },
  "over": [
    {"image": "stars", "size": [0.07, 0.07], "in": "hub", "frame": "floor(time*1.5)%4", "angle": "sel", "radius": 1.1, "rotate": "sel", "opacity": "on"}
  ],
  "hub": [
    {"shape": "circle", "x": 0.0, "y": 0.05, "size": 1.0, "fill": {"type": "radial", "stops": [[0, "black/30"], [0.86, "black/25"], [1, "black/0"]]}, "opacity": "sat(open)*0.95"},
    {"image": "badge", "size": 1.0, "rotate": "-4", "intro": {"time": 0.4, "ease": "back", "scale": 0.6}},
    {"text": "{title}", "y": -0.05, "box": [1.26, 0.6], "px": 17, "color": "text", "font": "title", "weight": 700, "wrap": true, "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/70"}},
    {"text": "{sub}", "y": 0.28, "box": [1.1969999999999998, 0.2], "px": 11.5, "color": "sub", "font": "title", "weight": 700, "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/70"}},
    {"text": "{hh}:{mm}", "y": -0.08, "box": [1.26, 0.55], "px": 31, "color": "text", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/70"}},
    {"text": "{date}", "y": 0.21, "box": [1.1969999999999998, 0.2], "px": 12, "color": "sub", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/70"}}
  ],
  "draw": {"clock": false, "shadow": false, "text": "text"},
  "tabs": {"inset": 13, "text": "#2A2A3A", "fill": "#FFFFFF/55", "on": "#FF6A4A/85"},
  "panel": {"fill": {"type": "linear", "stops": [[0, "#FFFFFF"], [1, "#F2EEE6"]]}, "stroke": "#FF6A4A", "width": 3, "corner": 14, "text": "#2A2A3A"},
  "tag": {"fill": {"type": "linear", "stops": [[0, "#FFFFFF"], [1, "#F2EEE6"]]}, "stroke": "#FF6A4A", "width": 2, "corner": 13, "text": "#2A2A3A"},
  "tile": {"fill": {"type": "linear", "stops": [[0, "#FFFFFF"], [1, "#F2EEE6"]]}, "stroke": "#C8C0B0", "width": 2.4, "corner": 12, "text": "#2A2A3A"},
  "onlaunch": [
    {"image": "stars", "count": 16, "area": "slot", "life": [0.6, 1.1], "size": [7, 12], "speed": [120, 320], "outward": true, "dir": [-100, 100], "gravity": 500, "spin": [-400, 400], "fadein": 0, "fadeout": 0.3}
  ],
  "sounds": {"open": "open.wav", "move": "move.wav", "launch": "launch.wav", "close": "close.wav"}
}
