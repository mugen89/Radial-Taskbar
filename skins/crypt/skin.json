{
  "format": 1,
  "id": "crypt",
  "name": "Crypt",
  "author": "Radial Taskbar",
  "version": "1.0",
  "about": "Worn flagstones under wrought iron; violet soul flames burn over stone plaques and the gate swings open",
  "tags": ["gothic", "dark", "violet"],
  "preview": "preview.jpg",
  "style": {"shape": "orb", "material": "solid", "base": "#14101C", "accent": "#A66BFF", "accent2": "#D9C2FF", "text": "#EEE6FA", "border": "#A66BFF", "opacity": 0.98, "corner": 14, "font": "Metamorphous", "open": "fade", "speed": 0.85, "hoverGrow": 3, "iconZoom": 1.12, "glow": 0, "tilt": 0.3, "pointer": false, "burst": false, "shadow": 0.5, "dim": 0.58},
  "wheel": {"hub": 90, "thickness": 92, "gap": 5, "ringgap": 10, "rim": 32, "icon": 42, "crowd": 1.45, "area": 1.1, "hubkeep": 0.76},
  "colors": {"text": "#EEE6FA", "sub": "#B8A8D8"},
  "fonts": {"title": {"file": "Metamorphous-Regular.ttf", "family": "Metamorphous"}},
  "images": {
    "aura": {"file": "aura.jpg", "light": true},
    "flame": {"file": "flame.jpg", "light": true, "cols": 4},
    "floor": {"file": "floor.jpg", "mask": "floor-mask.png"},
    "gateL": "gateL.png",
    "gateR": "gateR.png",
    "halo": {"file": "halo.jpg", "light": true},
    "plaques": {"file": "plaques.png", "cols": 2},
    "well": {"file": "well.jpg", "mask": "well-mask.png"}
  },
  "back": [
    {"shape": "circle", "x": 0.0, "y": 0.03, "size": 1.1, "fill": {"type": "radial", "stops": [[0, "black/70"], [0.86, "black/60"], [1, "black/0"]]}, "opacity": "sat(open)*0.95"},
    {"image": "floor", "size": 1.0, "intro": {"time": 0.4, "ease": "out", "scale": 0.92}}
  ],
  "slot": {
    "intro": {"time": 0.42, "ease": "back", "delay": 0.06, "scale": 0.3, "stagger": 0.02, "order": "both"},
    "under": [
      {"image": "aura", "size": 2.08, "opacity": "0.35+0.4*hot", "scale": "(1.8*(1+0.10*sin(time*11+seed*9)+0.06*sin(time*17+seed*3)))/2.08"},
      {"image": "plaques", "size": "0.98*(1+0.05*hot-0.04*press)", "frame": "hot>0.5 ? 1 : 0", "rotate": "a"},
      {"image": "flame", "size": [0.34, 0.61], "y": -0.88, "pivot": [0.5, 0.75], "frame": "floor(time*14+seed*12)%12", "opacity": "0.75+0.25*hot", "scale": "(1+0.10*sin(time*11+seed*9)+0.06*sin(time*17+seed*3))"}
    ],
    "icon": {"size": 0.58, "zoom": 1.16, "shadow": {"x": 0, "y": 0, "blur": 5, "color": "#A66BFF/60"}},
    "over": [
      {"shape": "circle", "y": 0.92, "size": 0.15, "fill": "#A66BFF", "when": "running", "opacity": "active ? 1 : 0.75", "glow": 4, "glowcolor": "#D9C2FF"},
      {"shape": "circle", "y": 0.92, "size": 0.0825, "fill": "#D9C2FF", "when": "running", "opacity": "active ? 1 : 0.35+0.35*wave(time*0.5+seed)"},
      {"shape": "circle", "x": 0.64, "y": -0.64, "size": 0.25, "fill": "#A66BFF", "when": "numbers && number<10 && !kid"},
      {"text": "{number}", "x": 0.64, "y": -0.65, "em": 0.3, "color": "#14101C", "font": "title", "weight": 700, "when": "numbers && number<10 && !kid"},
      {"shape": "poly", "points": [[-0.12, -0.6980000000000001], [0, -0.8], [0.12, -0.6980000000000001]], "stroke": "#EEE6FA", "width": 2.2, "caps": true, "when": "group"}
    ],
    "marks": false,
    "chevron": false,
    "badge": false
  },
  "hub": [
    {"image": "well", "size": 1.0, "intro": {"time": 0.4, "ease": "back", "scale": 0.6}},
    {"text": "{title}", "y": -0.05, "box": [1.26, 0.6], "px": 17, "color": "text", "font": "title", "weight": 700, "wrap": true, "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/70"}},
    {"text": "{sub}", "y": 0.28, "box": [1.178, 0.2], "px": 11.5, "color": "sub", "font": "title", "weight": 700, "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/70"}},
    {"text": "{hh}:{mm}", "y": -0.08, "box": [1.24, 0.55], "px": 31, "color": "text", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/70"}},
    {"text": "{date}", "y": 0.21, "box": [1.178, 0.2], "px": 12, "color": "sub", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/70"}}
  ],
  "front": [
    {"image": "gateL", "size": [0.5, 1.0], "in": "hub", "x": "-0.25-0.9*open", "opacity": "1-sat(open*1.4)"},
    {"image": "gateR", "size": [0.5, 1.0], "in": "hub", "x": "0.25+0.9*open", "opacity": "1-sat(open*1.4)"}
  ],
  "draw": {"clock": false, "shadow": false, "text": "text"},
  "tabs": {"inset": 13, "text": "text", "fill": "#EEE6FA/14", "on": "#A66BFF/85"},
  "panel": {"fill": {"type": "linear", "stops": [[0, "#241C30"], [1, "#14101C"]]}, "stroke": "#7A6A8A", "width": 3, "corner": 14, "text": "text"},
  "tag": {"fill": {"type": "linear", "stops": [[0, "#241C30"], [1, "#14101C"]]}, "stroke": "#7A6A8A", "width": 2, "corner": 13, "text": "text"},
  "tile": {"fill": {"type": "linear", "stops": [[0, "#3A3442"], [1, "#24202C"]]}, "stroke": "#7A6A8A", "width": 2.4, "corner": 12, "text": "#EEE6FA"},
  "onlaunch": [
    {"color": "#C8A0FF", "count": 24, "area": "slot", "life": [0.6, 1.2], "size": [2, 4], "speed": [40, 160], "outward": true, "dir": [-60, 60], "gravity": -160, "drag": 1.2, "fadein": 0, "fadeout": 0.5}
  ],
  "sounds": {"open": "open.wav", "move": "move.wav", "launch": "launch.wav", "close": "close.wav"},
  "screen": {"effect": "fireflies", "color": "#8A5ADF", "color2": "#E8D8FF", "density": 0.8, "speed": 0.5, "size": 1.1}
}
