{
  "format": 1,
  "id": "vault",
  "name": "Vault",
  "author": "Radial Taskbar",
  "version": "1.0",
  "about": "A vault door of brushed steel with heavy bolts; the combination dial in the middle turns to your choice",
  "tags": ["metal", "heavy", "cool"],
  "preview": "preview.jpg",
  "style": {"shape": "orb", "material": "solid", "base": "#1E2228", "accent": "#C9CED6", "accent2": "#F2C84A", "text": "#F2F4F6", "border": "#C9CED6", "opacity": 0.98, "corner": 14, "font": "Bahnschrift", "open": "spin", "speed": 0.85, "hoverGrow": 3, "iconZoom": 1.12, "glow": 0, "tilt": 0.3, "pointer": false, "burst": false, "shadow": 0.5, "dim": 0.42},
  "wheel": {"hub": 90, "thickness": 92, "gap": 5, "ringgap": 10, "rim": 32, "icon": 42, "crowd": 1.45, "area": 1.1, "hubkeep": 0.76},
  "colors": {"text": "#F2F4F6", "sub": "#B8BEC6"},
  "fonts": {"title": "Bahnschrift, Segoe UI"},
  "images": {
    "bolts": {"file": "bolts.png", "cols": 2},
    "dial": {"file": "dial.jpg", "mask": "dial-mask.png"},
    "door": {"file": "door.jpg", "mask": "door-mask.png"},
    "halo": {"file": "halo.jpg", "light": true},
    "notch": "notch.png"
  },
  "back": [
    {"shape": "circle", "x": 0.0, "y": 0.03, "size": 1.1, "fill": {"type": "radial", "stops": [[0, "black/70"], [0.86, "black/60"], [1, "black/0"]]}, "opacity": "sat(open)*0.95"},
    {"image": "door", "size": 1.0, "intro": {"time": 0.45, "ease": "out", "scale": 0.92}}
  ],
  "slot": {
    "intro": {"time": 0.42, "ease": "back", "delay": 0.06, "scale": 0.3, "stagger": 0.02, "order": "both"},
    "under": [
      {"image": "halo", "size": 1.6, "opacity": "hot*0.6", "when": "hot>0.02", "scale": "(1.6*hot)/1.6"},
      {"image": "bolts", "size": "1.0*(1+0.05*hot-0.04*press)", "frame": "hot>0.5 ? 1 : 0", "rotate": "a"}
    ],
    "icon": {"size": 0.58, "zoom": 1.16, "shadow": {"x": 0, "y": 1, "blur": 2, "color": "black/60"}},
    "over": [
      {"shape": "circle", "y": 0.92, "size": 0.15, "fill": "#C9CED6", "when": "running", "opacity": "active ? 1 : 0.75", "glow": 4, "glowcolor": "#F2C84A"},
      {"shape": "circle", "y": 0.92, "size": 0.0825, "fill": "#F2C84A", "when": "running", "opacity": "active ? 1 : 0.35+0.35*wave(time*0.5+seed)"},
      {"shape": "circle", "x": 0.64, "y": -0.64, "size": 0.25, "fill": "#F2C84A", "when": "numbers && number<10 && !kid"},
      {"text": "{number}", "x": 0.64, "y": -0.65, "em": 0.3, "color": "#1E2228", "font": "title", "weight": 700, "when": "numbers && number<10 && !kid"},
      {"shape": "poly", "points": [[-0.12, -0.6980000000000001], [0, -0.8], [0.12, -0.6980000000000001]], "stroke": "#F2F4F6", "width": 2.2, "caps": true, "when": "group"}
    ],
    "marks": false,
    "chevron": false,
    "badge": false
  },
  "over": [
    {"image": "notch", "size": [0.05, 0.07], "in": "hub", "y": -1.04, "opacity": "0.9"}
  ],
  "hub": [
    {"image": "dial", "size": 1.0, "rotate": "sel*0.6+(1-open)*-200", "intro": {"time": 0.5, "ease": "back", "scale": 0.6}},
    {"text": "{title}", "y": -0.05, "box": [1.26, 0.6], "px": 17, "color": "text", "font": "title", "weight": 700, "wrap": true, "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/70"}},
    {"text": "{sub}", "y": 0.28, "box": [1.1969999999999998, 0.2], "px": 11.5, "color": "sub", "font": "title", "weight": 700, "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/70"}},
    {"text": "{hh}:{mm}", "y": -0.08, "box": [1.26, 0.55], "px": 31, "color": "text", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/70"}},
    {"text": "{date}", "y": 0.21, "box": [1.1969999999999998, 0.2], "px": 12, "color": "sub", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/70"}}
  ],
  "draw": {"clock": false, "shadow": false, "text": "text"},
  "tabs": {"inset": 13, "text": "text", "fill": "#F2F4F6/14", "on": "#C9CED6/85"},
  "panel": {"fill": {"type": "linear", "stops": [[0, "#2E3238"], [1, "#1A1E22"]]}, "stroke": "#8A9098", "width": 3, "corner": 14, "text": "text"},
  "tag": {"fill": {"type": "linear", "stops": [[0, "#2E3238"], [1, "#1A1E22"]]}, "stroke": "#8A9098", "width": 2, "corner": 13, "text": "text"},
  "tile": {"fill": {"type": "linear", "stops": [[0, "#E8ECF0"], [1, "#C8CED6"]]}, "stroke": "#6A7078", "width": 2.4, "corner": 12, "text": "#1E2228"},
  "onlaunch": [
    {"color": "#F2C84A", "count": 20, "area": "slot", "life": [0.3, 0.7], "size": [1.5, 3], "speed": [120, 360], "outward": true, "dir": [-70, 70], "gravity": 700, "stretch": 2, "fadein": 0, "fadeout": 0.4}
  ],
  "sounds": {"open": "open.wav", "move": "move.wav", "launch": "launch.wav", "close": "close.wav"}
}
