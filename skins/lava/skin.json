{
  "format": 1,
  "id": "lava",
  "name": "Lava",
  "author": "Radial Taskbar",
  "version": "1.0",
  "about": "Cracked black crust over glowing rock; apps rest on basalt veined with fire while embers rise",
  "tags": ["fire", "dark", "hot"],
  "preview": "preview.jpg",
  "style": {"shape": "orb", "material": "solid", "base": "#140806", "accent": "#FF5A1A", "accent2": "#FFC24A", "text": "#FFE6C8", "border": "#FF5A1A", "opacity": 0.98, "corner": 14, "font": "Bahnschrift", "open": "bloom", "speed": 1, "hoverGrow": 3, "iconZoom": 1.12, "glow": 0, "tilt": 0.35, "pointer": false, "burst": false, "shadow": 0.5, "dim": 0.55},
  "wheel": {"hub": 90, "thickness": 92, "gap": 5, "ringgap": 10, "rim": 32, "icon": 42, "crowd": 1.45, "area": 1.1, "hubkeep": 0.76},
  "colors": {"text": "#FFE6C8", "sub": "#E8A878"},
  "fonts": {"title": "Bahnschrift, Segoe UI"},
  "images": {
    "arrow": "arrow.png",
    "core": {"file": "core.jpg", "mask": "core-mask.png"},
    "crust": {"file": "crust.jpg", "mask": "crust-mask.png"},
    "halo": {"file": "halo.jpg", "light": true},
    "heat": {"file": "heat.jpg", "light": true},
    "stones": {"file": "stones.png", "cols": 4}
  },
  "back": [
    {"shape": "circle", "x": 0.0, "y": 0.03, "size": 1.1, "fill": {"type": "radial", "stops": [[0, "black/70"], [0.86, "black/60"], [1, "black/0"]]}, "opacity": "sat(open)*0.95"},
    {"image": "heat", "size": 1.6, "opacity": "0.25+0.1*sin(time*1.3)"},
    {"image": "crust", "size": 1.0, "intro": {"time": 0.45, "ease": "out", "scale": 0.92}}
  ],
  "slot": {
    "intro": {"time": 0.42, "ease": "back", "delay": 0.06, "scale": 0.3, "stagger": 0.02, "order": "both"},
    "under": [
      {"image": "heat", "size": 1.65, "opacity": "0.3+0.5*hot", "scale": "(1.5*(1+0.1*sin(time*3+seed*6)))/1.65"},
      {"image": "stones", "size": "1.0*(1+0.05*hot-0.04*press)", "frame": "(i+ring)%4", "rotate": "seed*360"}
    ],
    "icon": {"size": 0.56, "zoom": 1.16, "shadow": {"x": 0, "y": 1, "blur": 4, "color": "#FF5A1A/50"}},
    "over": [
      {"shape": "circle", "y": 0.92, "size": 0.15, "fill": "#FF5A1A", "when": "running", "opacity": "active ? 1 : 0.75", "glow": 4, "glowcolor": "#FFC24A"},
      {"shape": "circle", "y": 0.92, "size": 0.0825, "fill": "#FFC24A", "when": "running", "opacity": "active ? 1 : 0.35+0.35*wave(time*0.5+seed)"},
      {"shape": "circle", "x": 0.64, "y": -0.64, "size": 0.25, "fill": "#FFC24A", "when": "numbers && number<10 && !kid"},
      {"text": "{number}", "x": 0.64, "y": -0.65, "em": 0.3, "color": "#140806", "font": "title", "weight": 700, "when": "numbers && number<10 && !kid"},
      {"shape": "poly", "points": [[-0.12, -0.6980000000000001], [0, -0.8], [0.12, -0.6980000000000001]], "stroke": "#FFE6C8", "width": 2.2, "caps": true, "when": "group"}
    ],
    "marks": false,
    "chevron": false,
    "badge": false
  },
  "over": [
    {"image": "arrow", "size": [0.06, 0.084], "in": "hub", "angle": "sel", "radius": 1.1, "rotate": "sel", "opacity": "on"}
  ],
  "hub": [
    {"image": "core", "size": 1.0, "intro": {"time": 0.45, "ease": "back", "scale": 0.6}},
    {"text": "{title}", "y": -0.05, "box": [1.26, 0.6], "px": 17, "color": "text", "font": "title", "weight": 700, "wrap": true, "shadow": {"x": 0, "y": 1, "blur": 4, "color": "black/90"}},
    {"text": "{sub}", "y": 0.28, "box": [1.1969999999999998, 0.2], "px": 11.5, "color": "sub", "font": "title", "weight": 700, "shadow": {"x": 0, "y": 1, "blur": 4, "color": "black/90"}},
    {"text": "{hh}:{mm}", "y": -0.08, "box": [1.26, 0.55], "px": 31, "color": "text", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 1, "blur": 4, "color": "black/90"}},
    {"text": "{date}", "y": 0.21, "box": [1.1969999999999998, 0.2], "px": 12, "color": "sub", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 1, "blur": 4, "color": "black/90"}}
  ],
  "draw": {"clock": false, "shadow": false, "text": "text"},
  "tabs": {"inset": 13, "text": "text", "fill": "#FFE6C8/14", "on": "#FF5A1A/85"},
  "panel": {"fill": {"type": "linear", "stops": [[0, "#2A140C"], [1, "#140806"]]}, "stroke": "#FF5A1A", "width": 3, "corner": 14, "text": "text"},
  "tag": {"fill": {"type": "linear", "stops": [[0, "#2A140C"], [1, "#140806"]]}, "stroke": "#FF5A1A", "width": 2, "corner": 13, "text": "text"},
  "tile": {"fill": {"type": "linear", "stops": [[0, "#2E2420"], [1, "#1A1410"]]}, "stroke": "#FF8A3A", "width": 2.4, "corner": 12, "text": "#FFE6C8"},
  "onlaunch": [
    {"color": "#FFB04A", "count": 30, "area": "slot", "life": [0.5, 1.0], "size": [1.5, 3.5], "speed": [80, 300], "outward": true, "dir": [-80, 80], "gravity": -150, "drag": 1.4, "fadein": 0, "fadeout": 0.5}
  ],
  "sounds": {"open": "open.wav", "move": "move.wav", "launch": "launch.wav", "close": "close.wav"},
  "screen": {"effect": "embers", "color": "#FF5A1A", "color2": "#FFC24A", "density": 1.2, "speed": 1.0, "size": 1.0}
}
