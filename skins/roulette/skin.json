{
  "format": 1,
  "id": "roulette",
  "name": "Roulette",
  "author": "Radial Taskbar",
  "version": "1.0",
  "about": "Walnut, brass and felt; the ball rolls to your choice",
  "tags": ["casino", "game", "wood"],
  "preview": "preview.jpg",
  "style": {"shape": "wedge", "material": "solid", "base": "#1B0E08", "accent": "#FFCE6A", "accent2": "#B3141C", "text": "#FBEFD3", "border": "#C99A45", "opacity": 0.97, "corner": 5, "font": "Georgia", "open": "spin", "speed": 1.05, "hoverGrow": 3, "iconZoom": 1.12, "glow": 0.4, "tilt": 0.4, "pointer": false, "burst": false, "shadow": 0.7, "dim": 0.34},
  "wheel": {"hub": 96, "thickness": 92, "gap": 5, "ringgap": 10, "rim": 62, "icon": 46, "crowd": 1.45, "area": 1.1, "hubkeep": 0.62, "shadow": 0.6},
  "colors": {"ivory": "#FBF3E0", "gold": "#E9C97A", "red": "#B3141C"},
  "fonts": {"title": "Georgia, Cambria"},
  "images": {
    "ball": "ball.png",
    "bowl": {"file": "bowl.jpg", "mask": "bowl-mask.png"},
    "cap": {"file": "cap.jpg", "mask": "cap-mask.png"},
    "chip": {"file": "chip.png", "cols": 8},
    "fret": "fret.png",
    "halo": {"file": "halo.jpg", "light": true},
    "rotor": {"file": "rotor.jpg", "mask": "rotor-mask.png"},
    "turret": {"file": "turret.jpg", "mask": "turret-mask.png"}
  },
  "back": [
    {"shape": "circle", "x": 0.0, "y": 0.025, "size": 1.08, "fill": {"type": "radial", "stops": [[0, "black/72"], [0.86, "black/61"], [1, "black/0"]]}, "opacity": "sat(open)*0.95"},
    {"image": "bowl", "size": 1, "intro": {"time": 0.3, "ease": "out", "scale": 0.85}}
  ],
  "ring": [
    {"image": "rotor", "size": "2*(ringout+9)", "in": "px", "rotate": "(1-open)*-200+time*1.2"}
  ],
  "slot": {
    "intro": {"time": 0.4, "ease": "out", "delay": 0.03, "angle": -120, "scale": 0.8, "stagger": 0.0, "order": "ring"},
    "under": [
      {"shape": "slot", "inset": 1.2, "fill": {"type": "linear", "from": [-0.5, -1], "to": [0.5, 1], "stops": [[0, "#C2161F"], [1, "#5A060C"]]}, "when": "(n%2==0 && i%2==0) || (n%2==1 && i>0 && i%2==1)"},
      {"shape": "slot", "inset": 1.2, "fill": {"type": "linear", "from": [-0.5, -1], "to": [0.5, 1], "stops": [[0, "#2C2C33"], [1, "#050506"]]}, "when": "(n%2==0 && i%2==1) || (n%2==1 && i>0 && i%2==0)"},
      {"shape": "slot", "inset": 1.2, "fill": {"type": "linear", "from": [-0.5, -1], "to": [0.5, 1], "stops": [[0, "#12803F"], [1, "#06331A"]]}, "when": "n%2==1 && i==0"},
      {"shape": "slot", "inset": 1.2, "fill": {"type": "radial", "from": [0, 0], "radius": 1.1, "stops": [[0, "#FFE7A6/55"], [1, "#FFE7A6/0"]]}, "opacity": "hot+launch*2"},
      {"shape": "slot", "inset": 1.2, "stroke": {"type": "linear", "stops": [[0, "#FFE9B0"], [1, "#A8772A"]]}, "width": "1+1.6*hot", "opacity": "0.5+0.5*hot"},
      {"text": "{number}", "radius": 0.84, "angle": "a", "turns": true, "em": 0.3, "color": "ivory", "font": "title", "weight": 700, "opacity": 0.85, "when": "!kid"},
      {"image": "halo", "size": 1.5, "opacity": "0.5*hot+launch"}
    ],
    "icon": {"size": 0.96, "zoom": 1.14, "shadow": {"y": 2, "blur": 3, "color": "black/65"}},
    "over": [
      {"shape": "circle", "y": 0.8, "size": 0.14, "fill": "#E9C97A", "stroke": "#6B4612", "width": 1, "when": "running"},
      {"shape": "circle", "y": 0.8, "size": 0.08, "fill": "#FFFFFF", "when": "active", "glow": 5, "glowcolor": "#FFD27A"},
      {"shape": "poly", "points": [[-0.12, -0.518], [0, -0.62], [0.12, -0.518]], "stroke": "#E9C97A", "width": 2.2, "caps": true, "when": "group"}
    ],
    "marks": false,
    "chevron": false,
    "badge": false
  },
  "over": [
    {"image": "fret", "size": [10, 92], "in": "px", "when": "0"},
    {"shape": "circle", "x": 0.0, "y": 0.04, "size": 1.26, "fill": {"type": "radial", "stops": [[0, "black/70"], [0.78, "black/60"], [1, "black/0"]]}, "opacity": "sat(open)*0.95", "in": "hub"},
    {"image": "turret", "size": 1.22, "in": "hub", "rotate": "sel*0.6+time*8+(1-open)*-260", "intro": {"time": 0.4, "ease": "out", "scale": 0.6}},
    {"shape": "circle", "in": "px", "angle": "sel", "radius": "radius-40", "x": 3, "y": 5, "size": 24, "fill": {"type": "radial", "stops": [[0, "black/70"], [0.6, "black/45"], [1, "black/0"]]}, "opacity": "on"},
    {"image": "ball", "size": 21, "in": "px", "angle": "sel", "radius": "radius-40-22*outbounce(sat(launch*2))+3*noise(time*14)*on", "rotate": "sel*6", "opacity": "on", "scale": "0.6+0.4*on"}
  ],
  "hub": [
    {"image": "cap", "size": 0.8, "intro": {"time": 0.34, "ease": "back", "scale": 0.4}},
    {"text": "{title}", "y": -0.04, "box": [0.98, 0.42], "px": 16, "color": "ivory", "font": "title", "weight": 700, "wrap": true},
    {"text": "{sub}", "y": 0.24, "box": [0.9309999999999999, 0.2], "px": 10, "color": "gold", "font": "title", "weight": 700},
    {"text": "{hh}:{mm}", "y": -0.07, "box": [0.98, 0.55], "px": 26, "color": "ivory", "font": "title", "weight": 700, "opacity": "idle"},
    {"text": "{date}", "y": 0.19, "box": [0.9309999999999999, 0.2], "px": 10.5, "color": "gold", "font": "title", "weight": 700, "opacity": "idle"}
  ],
  "pinbutton": {"in": "hub", "x": -0.17, "y": 0.47, "size": 10.5},
  "settingsbutton": {"in": "hub", "x": 0.17, "y": 0.47, "size": 10.5},
  "draw": {"clock": false, "shadow": false, "text": "ivory"},
  "tabs": {"inset": 24, "text": "ivory", "fill": "#0D4B2E/90", "on": "#B3141C"},
  "panel": {"fill": {"type": "linear", "stops": [[0, "#12593A"], [1, "#0A3A24"]]}, "stroke": {"type": "linear", "stops": [[0, "#F0C97A"], [0.5, "#8A6427"], [1, "#D9A95A"]]}, "width": 3, "corner": 12, "text": "ivory"},
  "tag": {"fill": {"type": "linear", "stops": [[0, "#2E170C"], [1, "#180B05"]]}, "stroke": "#C99A45", "width": 1.6, "corner": 9, "text": "ivory"},
  "tile": {"fill": {"type": "linear", "stops": [[0, "#FFFDF6"], [1, "#EFE7D4"]]}, "stroke": "#B3141C", "width": 2, "corner": 9, "text": "#2A1208"},
  "onlaunch": [
    {"image": "chip", "count": 16, "area": "slot", "life": [0.5, 0.9], "size": [12, 20], "speed": [160, 460], "outward": true, "dir": [-70, 70], "gravity": 700, "drag": 1.6, "spin": [-400, 400], "fadein": 0, "fadeout": 0.3},
    {"color": "#FFE7A6", "light": true, "count": 22, "area": "slot", "life": [0.25, 0.55], "size": [2, 4], "speed": [120, 420], "outward": true, "dir": [-80, 80], "drag": 2.5, "fadeout": 0.6}
  ],
  "sounds": {"open": "open.wav", "move": "move.wav", "launch": "launch.wav", "close": "close.wav"}
}
