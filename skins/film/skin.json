{
  "format": 1,
  "id": "film",
  "name": "Film Reel",
  "author": "Radial Taskbar",
  "version": "1.0",
  "about": "A metal reel turns behind a strip of film; every app is a frame, and the picture flickers with dust",
  "tags": ["cinema", "vintage", "warm"],
  "preview": "preview.jpg",
  "style": {"shape": "orb", "material": "solid", "base": "#1A1612", "accent": "#E8C27A", "accent2": "#F4E6C4", "text": "#F4E6C4", "border": "#E8C27A", "opacity": 0.98, "corner": 14, "font": "Georgia", "open": "fade", "speed": 0.9, "hoverGrow": 3, "iconZoom": 1.12, "glow": 0, "tilt": 0.25, "pointer": false, "burst": false, "shadow": 0.5, "dim": 0.55},
  "wheel": {"hub": 90, "thickness": 92, "gap": 5, "ringgap": 10, "rim": 32, "icon": 42, "crowd": 1.45, "area": 1.1, "hubkeep": 0.76},
  "colors": {"text": "#F4E6C4", "sub": "#C8B48A"},
  "fonts": {"title": "Georgia"},
  "images": {
    "dust": {"file": "dust.png", "cols": 4},
    "frames": {"file": "frames.png", "cols": 2},
    "halo": {"file": "halo.jpg", "light": true},
    "lamp": {"file": "lamp.jpg", "mask": "lamp-mask.png"},
    "lamplight": {"file": "lamplight.jpg", "light": true},
    "pointer": "pointer.png",
    "reel": "reel.png",
    "strip": "strip.png"
  },
  "back": [
    {"shape": "circle", "x": 0.0, "y": 0.03, "size": 1.08, "fill": {"type": "radial", "stops": [[0, "black/70"], [0.86, "black/60"], [1, "black/0"]]}, "opacity": "sat(open)*0.95"},
    {"image": "reel", "size": 1.0, "rotate": "time*18+(1-open)*-90", "intro": {"time": 0.4, "ease": "out", "scale": 0.92}},
    {"image": "strip", "size": 1.0, "rotate": "time*-3"}
  ],
  "slot": {
    "intro": {"time": 0.42, "ease": "back", "delay": 0.06, "scale": 0.3, "stagger": 0.02, "order": "both"},
    "under": [
      {"image": "halo", "size": 1.6, "opacity": "hot*0.6", "when": "hot>0.02", "scale": "(1.6*hot)/1.6"},
      {"image": "frames", "size": "0.98*(1+0.05*hot-0.04*press)", "frame": "hot>0.5 ? 1 : 0", "rotate": "a"}
    ],
    "icon": {"size": 0.56, "zoom": 1.16, "tone": "original", "shadow": {"x": 0, "y": 1, "blur": 2, "color": "black/50"}},
    "over": [
      {"shape": "circle", "y": 0.92, "size": 0.15, "fill": "#E8C27A", "when": "running", "opacity": "active ? 1 : 0.75", "glow": 4, "glowcolor": "#F4E6C4"},
      {"shape": "circle", "y": 0.92, "size": 0.0825, "fill": "#F4E6C4", "when": "running", "opacity": "active ? 1 : 0.35+0.35*wave(time*0.5+seed)"},
      {"shape": "circle", "x": 0.64, "y": -0.64, "size": 0.25, "fill": "#E8C27A", "when": "numbers && number<10 && !kid"},
      {"text": "{number}", "x": 0.64, "y": -0.65, "em": 0.3, "color": "#1A1612", "font": "title", "weight": 700, "when": "numbers && number<10 && !kid"},
      {"shape": "poly", "points": [[-0.12, -0.6980000000000001], [0, -0.8], [0.12, -0.6980000000000001]], "stroke": "#F4E6C4", "width": 2.2, "caps": true, "when": "group"}
    ],
    "marks": false,
    "chevron": false,
    "badge": false
  },
  "over": [
    {"image": "pointer", "size": [0.05, 0.065], "in": "hub", "angle": "sel", "radius": 1.1, "rotate": "sel", "opacity": "on"}
  ],
  "hub": [
    {"image": "lamp", "size": 1.0, "intro": {"time": 0.4, "ease": "back", "scale": 0.6}},
    {"image": "lamplight", "size": 1.25, "opacity": "0.16+0.05*noise(time*20)"},
    {"text": "{title}", "y": -0.05, "box": [1.26, 0.6], "px": 17, "color": "text", "font": "title", "weight": 700, "wrap": true, "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/70"}},
    {"text": "{sub}", "y": 0.28, "box": [1.1969999999999998, 0.2], "px": 11.5, "color": "sub", "font": "title", "weight": 700, "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/70"}},
    {"text": "{hh}:{mm}", "y": -0.08, "box": [1.26, 0.55], "px": 31, "color": "text", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/70"}},
    {"text": "{date}", "y": 0.21, "box": [1.1969999999999998, 0.2], "px": 12, "color": "sub", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/70"}}
  ],
  "front": [
    {"image": "dust", "size": 1.0, "frame": "floor(time*12)%4", "opacity": "0.55", "rotate": "floor(time*12)*37"}
  ],
  "draw": {"clock": false, "shadow": false, "text": "text"},
  "tabs": {"inset": 13, "text": "text", "fill": "#F4E6C4/14", "on": "#E8C27A/85"},
  "panel": {"fill": {"type": "linear", "stops": [[0, "#2A221A"], [1, "#1A1612"]]}, "stroke": "#8A7A5A", "width": 3, "corner": 14, "text": "text"},
  "tag": {"fill": {"type": "linear", "stops": [[0, "#2A221A"], [1, "#1A1612"]]}, "stroke": "#8A7A5A", "width": 2, "corner": 13, "text": "text"},
  "tile": {"fill": {"type": "linear", "stops": [[0, "#F2E2BA"], [1, "#D8C498"]]}, "stroke": "#6A5A3A", "width": 2.4, "corner": 12, "text": "#1A1612"},
  "onlaunch": [
    {"color": "#FFE8B0", "count": 1, "area": "slot", "life": [0.2, 0.2], "size": [70, 70], "grow": 1.5, "speed": [0, 0], "opacity": 0.45, "fadein": 0, "fadeout": 1}
  ],
  "sounds": {"open": "open.wav", "move": "move.wav", "launch": "launch.wav", "close": "close.wav"}
}
