{
  "format": 1,
  "id": "coffee",
  "name": "Coffee",
  "author": "Radial Taskbar",
  "version": "1.0",
  "about": "A cosy cup in the middle, small cups of espresso, latte and cappuccino round it, and steam",
  "tags": ["cosy", "warm", "cafe"],
  "preview": "preview.jpg",
  "style": {"shape": "orb", "material": "solid", "base": "#3B2416", "accent": "#C88A4A", "accent2": "#F2D6A8", "text": "#FFF4E2", "border": "#C88A4A", "opacity": 0.98, "corner": 14, "font": "Constantia", "open": "bloom", "speed": 1, "hoverGrow": 3, "iconZoom": 1.12, "glow": 0, "tilt": 0.3, "pointer": false, "burst": false, "shadow": 0.5, "dim": 0.28},
  "wheel": {"hub": 90, "thickness": 92, "gap": 5, "ringgap": 10, "rim": 32, "icon": 42, "crowd": 1.45, "area": 1.1, "hubkeep": 0.76},
  "colors": {"text": "#FFF4E2", "sub": "#EBD3AE"},
  "fonts": {"title": "Constantia, Georgia"},
  "images": {
    "bean": "bean.png",
    "bigcup": {"file": "bigcup.jpg", "mask": "bigcup-mask.png"},
    "cups": {"file": "cups.png", "cols": 4},
    "halo": {"file": "halo.jpg", "light": true},
    "saucer": {"file": "saucer.jpg", "mask": "saucer-mask.png"},
    "steam": "steam.png"
  },
  "back": [
    {"shape": "circle", "x": 0.0, "y": 0.04, "size": 1.1, "fill": {"type": "radial", "stops": [[0, "black/55"], [0.86, "black/47"], [1, "black/0"]]}, "opacity": "sat(open)*0.95"},
    {"image": "saucer", "size": 1.0, "intro": {"time": 0.38, "ease": "out", "scale": 0.9}}
  ],
  "slot": {
    "intro": {"time": 0.42, "ease": "back", "delay": 0.06, "scale": 0.3, "stagger": 0.02, "order": "both"},
    "under": [
      {"image": "halo", "size": 1.5, "opacity": "hot*0.6", "when": "hot>0.02", "scale": "(1.5*hot)/1.5"},
      {"shape": "circle", "x": 0.0, "y": 0.08, "size": 1.02, "fill": {"type": "radial", "stops": [[0, "black/45"], [0.86, "black/38"], [1, "black/0"]]}, "opacity": "sat(open)*0.95"},
      {"image": "cups", "size": "1.02*(1+0.05*hot-0.04*press)", "frame": "(i+ring)%4", "rotate": "seed*40-20"}
    ],
    "icon": {"size": 0.56, "zoom": 1.18, "shadow": {"x": 0, "y": 1, "blur": 2, "color": "black/45"}},
    "over": [
      {"shape": "circle", "y": 0.92, "size": 0.15, "fill": "#C88A4A", "when": "running", "opacity": "active ? 1 : 0.75", "glow": 4, "glowcolor": "#F2D6A8"},
      {"shape": "circle", "y": 0.92, "size": 0.0825, "fill": "#F2D6A8", "when": "running", "opacity": "active ? 1 : 0.35+0.35*wave(time*0.5+seed)"},
      {"shape": "circle", "x": 0.64, "y": -0.64, "size": 0.25, "fill": "#C88A4A", "when": "numbers && number<10 && !kid"},
      {"text": "{number}", "x": 0.64, "y": -0.65, "em": 0.3, "color": "#FFF4E2", "font": "title", "weight": 700, "when": "numbers && number<10 && !kid"},
      {"shape": "poly", "points": [[-0.12, -0.6980000000000001], [0, -0.8], [0.12, -0.6980000000000001]], "stroke": "#FFF4E2", "width": 2.2, "caps": true, "when": "group"}
    ],
    "marks": false,
    "chevron": false,
    "badge": false
  },
  "over": [
    {"image": "bean", "size": [0.1, 0.135], "in": "hub", "angle": "sel", "radius": 1.12, "rotate": "sel", "opacity": "on"}
  ],
  "hub": [
    {"shape": "circle", "x": 0.0, "y": 0.06, "size": 1.02, "fill": {"type": "radial", "stops": [[0, "black/50"], [0.86, "black/43"], [1, "black/0"]]}, "opacity": "sat(open)*0.95"},
    {"image": "bigcup", "size": 1.0, "intro": {"time": 0.4, "ease": "back", "scale": 0.6}},
    {"text": "{title}", "y": -0.1, "box": [1.26, 0.6], "px": 17, "color": "text", "font": "title", "weight": 700, "wrap": true, "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/70"}},
    {"text": "{sub}", "y": 0.2, "box": [1.178, 0.2], "px": 11.5, "color": "sub", "font": "title", "weight": 700, "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/70"}},
    {"text": "{hh}:{mm}", "y": -0.12, "box": [1.24, 0.55], "px": 31, "color": "text", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/70"}},
    {"text": "{date}", "y": 0.14, "box": [1.178, 0.2], "px": 12, "color": "sub", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/70"}}
  ],
  "draw": {"clock": false, "shadow": false, "text": "text"},
  "tabs": {"inset": 13, "text": "text", "fill": "#FFF4E2/14", "on": "#C88A4A/85"},
  "panel": {"fill": {"type": "linear", "stops": [[0, "#5A3A24"], [1, "#3B2416"]]}, "stroke": "#C88A4A", "width": 3, "corner": 14, "text": "text"},
  "tag": {"fill": {"type": "linear", "stops": [[0, "#5A3A24"], [1, "#3B2416"]]}, "stroke": "#C88A4A", "width": 2, "corner": 13, "text": "text"},
  "tile": {"fill": {"type": "linear", "stops": [[0, "#F7EFE2"], [1, "#E8D9C2"]]}, "stroke": "#B07A48", "width": 2.4, "corner": 12, "text": "#3B2416"},
  "particles": [
    {"image": "steam", "rate": 1.6, "max": 6, "area": "hub", "life": [1.6, 2.6], "size": [26, 44], "grow": 1.8, "speed": [14, 28], "dir": [-12, 12], "sway": 10, "swayhz": 0.5, "opacity": 0.35, "fadein": 0.3, "fadeout": 0.5}
  ],
  "onlaunch": [
    {"image": "bean", "count": 14, "area": "slot", "life": [0.6, 1.0], "size": [7, 11], "speed": [120, 320], "outward": true, "dir": [-90, 90], "gravity": 700, "spin": [-400, 400], "fadein": 0, "fadeout": 0.3}
  ],
  "sounds": {"open": "open.wav", "move": "move.wav", "launch": "launch.wav", "close": "close.wav"}
}
