{
  "format": 1,
  "id": "cyber",
  "name": "Cyber Alley",
  "author": "Radial Taskbar",
  "version": "1.0",
  "about": "A wet street at night: neon smears across the puddles, apps hang on holographic signs, rain streaks down",
  "tags": ["neon", "city", "dark"],
  "preview": "preview.jpg",
  "style": {"shape": "hex", "material": "solid", "base": "#0A0A14", "accent": "#FF3EA5", "accent2": "#3EE8FF", "text": "#F2F6FF", "border": "#FF3EA5", "opacity": 0.98, "corner": 14, "font": "Bahnschrift", "open": "zoom", "speed": 1, "hoverGrow": 3, "iconZoom": 1.12, "glow": 0, "tilt": 0.35, "pointer": false, "burst": false, "shadow": 0.5, "dim": 0.66},
  "wheel": {"hub": 90, "thickness": 92, "gap": 5, "ringgap": 10, "rim": 32, "icon": 42, "crowd": 1.45, "area": 1.1, "hubkeep": 0.76},
  "colors": {"text": "#F2F6FF", "sub": "#B8C2E0"},
  "fonts": {"title": "Bahnschrift, Segoe UI"},
  "images": {
    "cursorlight": "cursorlight.png",
    "halo": {"file": "halo.jpg", "light": true},
    "hub": {"file": "hub.jpg", "mask": "hub-mask.png"},
    "ringlight": {"file": "ringlight.jpg", "light": true},
    "signs": {"file": "signs.png", "cols": 2},
    "street": {"file": "street.jpg", "mask": "street-mask.png"}
  },
  "back": [
    {"shape": "circle", "x": 0.0, "y": 0.03, "size": 1.08, "fill": {"type": "radial", "stops": [[0, "black/70"], [0.86, "black/60"], [1, "black/0"]]}, "opacity": "sat(open)*0.95"},
    {"image": "street", "size": 1.0, "intro": {"time": 0.35, "ease": "out", "scale": 0.94}},
    {"image": "ringlight", "size": 1.4, "opacity": "0.35+0.15*noise(time*6)"}
  ],
  "slot": {
    "intro": {"time": 0.42, "ease": "back", "delay": 0.06, "scale": 0.3, "stagger": 0.02, "order": "both"},
    "under": [
      {"image": "halo", "size": 1.6, "opacity": "hot*0.6", "when": "hot>0.02", "scale": "(1.6*hot)/1.6"},
      {"image": "signs", "size": "1.02*(1+0.05*hot-0.04*press)", "frame": "(i+ring)%2", "opacity": "0.85+0.15*step(0.08,noise(time*9+seed*40))"}
    ],
    "icon": {"size": 0.62, "zoom": 1.16, "shadow": {"x": 0, "y": 0, "blur": 6, "color": "#FF3EA5/50"}},
    "over": [
      {"shape": "circle", "y": 0.92, "size": 0.15, "fill": "#FF3EA5", "when": "running", "opacity": "active ? 1 : 0.75", "glow": 4, "glowcolor": "#3EE8FF"},
      {"shape": "circle", "y": 0.92, "size": 0.0825, "fill": "#3EE8FF", "when": "running", "opacity": "active ? 1 : 0.35+0.35*wave(time*0.5+seed)"},
      {"shape": "circle", "x": 0.64, "y": -0.64, "size": 0.25, "fill": "#3EE8FF", "when": "numbers && number<10 && !kid"},
      {"text": "{number}", "x": 0.64, "y": -0.65, "em": 0.3, "color": "#0A0A14", "font": "title", "weight": 700, "when": "numbers && number<10 && !kid"},
      {"shape": "poly", "points": [[-0.12, -0.6980000000000001], [0, -0.8], [0.12, -0.6980000000000001]], "stroke": "#F2F6FF", "width": 2.2, "caps": true, "when": "group"}
    ],
    "marks": false,
    "chevron": false,
    "badge": false
  },
  "over": [
    {"image": "cursorlight", "size": [0.08, 0.08], "in": "hub", "angle": "sel", "radius": 1.1, "rotate": "sel", "opacity": "on"}
  ],
  "hub": [
    {"image": "hub", "size": 1.0, "intro": {"time": 0.35, "ease": "back", "scale": 0.6}},
    {"text": "{title}", "y": -0.05, "box": [1.26, 0.6], "px": 17, "color": "text", "font": "title", "weight": 700, "wrap": true, "shadow": {"x": 0, "y": 0, "blur": 6, "color": "#3EE8FF/70"}},
    {"text": "{sub}", "y": 0.28, "box": [1.1969999999999998, 0.2], "px": 11.5, "color": "sub", "font": "title", "weight": 700, "shadow": {"x": 0, "y": 0, "blur": 6, "color": "#3EE8FF/70"}},
    {"text": "{hh}:{mm}", "y": -0.08, "box": [1.26, 0.55], "px": 31, "color": "text", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 0, "blur": 6, "color": "#3EE8FF/70"}},
    {"text": "{date}", "y": 0.21, "box": [1.1969999999999998, 0.2], "px": 12, "color": "sub", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 0, "blur": 6, "color": "#3EE8FF/70"}}
  ],
  "draw": {"clock": false, "shadow": false, "text": "text"},
  "tabs": {"inset": 13, "text": "text", "fill": "#F2F6FF/14", "on": "#FF3EA5/85"},
  "panel": {"fill": {"type": "linear", "stops": [[0, "#1A1028"], [1, "#0A0A14"]]}, "stroke": "#FF3EA5", "width": 3, "corner": 14, "text": "text"},
  "tag": {"fill": {"type": "linear", "stops": [[0, "#1A1028"], [1, "#0A0A14"]]}, "stroke": "#FF3EA5", "width": 2, "corner": 13, "text": "text"},
  "tile": {"fill": {"type": "linear", "stops": [[0, "#1E1430"], [1, "#0E0A18"]]}, "stroke": "#3EE8FF", "width": 2.4, "corner": 12, "text": "#F2F6FF"},
  "particles": [
    {"color": "#9FD8FF", "rate": 26, "max": 50, "area": "stage", "life": [0.35, 0.6], "size": [0.8, 1.3], "speed": [700, 950], "dir": [176, 184], "stretch": 7, "opacity": 0.45, "fadein": 0.05, "fadeout": 0.2}
  ],
  "onlaunch": [
    {"color": "#3EE8FF", "count": 20, "area": "slot", "life": [0.3, 0.7], "size": [1.5, 3], "speed": [100, 380], "outward": true, "dir": [-80, 80], "drag": 2, "fadein": 0, "fadeout": 0.5},
    {"color": "#FF3EA5", "count": 16, "area": "slot", "life": [0.3, 0.7], "size": [1.5, 3], "speed": [100, 380], "outward": true, "dir": [-80, 80], "drag": 2, "fadein": 0, "fadeout": 0.5}
  ],
  "sounds": {"open": "open.wav", "move": "move.wav", "launch": "launch.wav", "close": "close.wav"}
}
