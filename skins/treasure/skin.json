{
  "format": 1,
  "id": "treasure",
  "name": "Treasure Map",
  "author": "Radial Taskbar",
  "version": "1.0",
  "about": "Burnt parchment, islands and a compass; X marks your choice",
  "tags": ["map", "adventure", "paper"],
  "preview": "preview.jpg",
  "style": {"shape": "orb", "material": "solid", "base": "#E3C48A", "accent": "#B3200F", "accent2": "#3A2412", "text": "#3A2412", "border": "#7A5426", "opacity": 0.98, "corner": 8, "font": "Palatino Linotype", "open": "unfold", "speed": 1, "hoverGrow": 3, "iconZoom": 1.14, "glow": 0, "tilt": 0.3, "pointer": false, "burst": false, "shadow": 0.6, "dim": 0.32},
  "wheel": {"hub": 96, "thickness": 94, "gap": 5, "ringgap": 8, "rim": 34, "icon": 44, "crowd": 1.5, "area": 1.26, "hubkeep": 0.6},
  "colors": {"ink": "#3A2412", "rust": "#9E2A16", "paper": "#EBD3A0"},
  "fonts": {"title": "Palatino Linotype, Book Antiqua, Georgia", "hand": "Gabriola, Palatino Linotype"},
  "images": {
    "coin": {"file": "coin.png", "cols": 8},
    "compass": {"file": "compass.jpg", "mask": "compass-mask.png"},
    "cross": "cross.png",
    "islands": {"file": "islands.png", "cols": 4},
    "needle": "needle.png",
    "sheet": {"file": "sheet.jpg", "mask": "sheet-mask.png"},
    "ship": "ship.png"
  },
  "back": [
    {"shape": "circle", "x": 0.0, "y": 0.03, "size": 1.16, "fill": {"type": "radial", "stops": [[0, "black/62"], [0.84, "black/53"], [1, "black/0"]]}, "opacity": "sat(open)*0.95"},
    {"image": "sheet", "size": 1.12, "rotate": "(1-open)*-14", "intro": {"time": 0.32, "ease": "out", "scale": 0.8, "rotate": -10}},
    {"image": "ship", "size": 0.095, "angle": "time*5", "radius": 0.965, "rotate": "6*sin(time*1.3)", "y": "0.006*sin(time*2.1)", "opacity": "smooth(0.3,0.7,time)"}
  ],
  "slot": {
    "intro": {"time": 0.34, "ease": "back", "delay": 0.06, "scale": 0.2, "stagger": 0.02, "order": "random"},
    "under": [
      {"image": "islands", "size": 1.28, "frame": "(i+ring*2)%4", "rotate": "i*67", "opacity": 0.96},
      {"image": "cross", "size": 1.02, "opacity": "sat(hot*3)", "rotate": "seed*16-8", "scale": "(1.02*outback(sat(hot*1.2)))/1.02"}
    ],
    "icon": {"size": 1.04, "zoom": 1.18, "shadow": {"x": 0, "y": 2, "blur": 3, "color": "#2A1608/55"}},
    "over": [
      {"shape": "circle", "y": 0.86, "size": 0.15, "fill": "#9E2A16", "stroke": "#F0DCAD", "width": 1.4, "when": "running"},
      {"shape": "circle", "y": 0.86, "size": 0.07, "fill": "#FFE7B0", "when": "active"},
      {"shape": "circle", "x": 0.66, "y": -0.66, "size": 0.26, "fill": "#EFDDB2", "stroke": "#3A2412", "width": 1.3, "when": "numbers && number<10 && !kid"},
      {"text": "{number}", "x": 0.66, "y": -0.67, "em": 0.32, "color": "ink", "font": "title", "weight": 700, "when": "numbers && number<10 && !kid"},
      {"shape": "poly", "points": [[-0.14, -0.801], [0, -0.92], [0.14, -0.801]], "stroke": "#3A2412", "width": 2.2, "caps": true, "when": "group"}
    ],
    "marks": false,
    "chevron": false,
    "badge": false
  },
  "over": [
    {"shape": "rect", "in": "px", "copies": 9, "angle": "sel", "radius": "hub+5+j*(radius-hub-60)/m", "turns": true, "size": [3.6, 8], "corner": 1.6, "fill": "#A3200F", "opacity": "on*(0.45+0.55*step(0.45,fract(j/m*1.5-time*1.1)))*step(radius*0+hub+5+j*(radius-hub-60)/m, ringin+8)"},
    {"image": "needle", "size": [0.15, 0.195], "in": "hub", "angle": "sel", "radius": 1.07, "turns": true, "opacity": "on", "scale": "0.5+0.5*on"}
  ],
  "hub": [
    {"image": "compass", "size": 1.12, "rotate": "sel*0.12+2*sin(time*0.7)", "intro": {"time": 0.42, "ease": "back", "scale": 0.4, "rotate": -160}},
    {"text": "{title}", "y": -0.04, "box": [1.02, 0.44], "px": 16.5, "color": "ink", "font": "title", "weight": 700, "wrap": true},
    {"text": "{sub}", "y": 0.25, "box": [0.969, 0.2], "px": 10.5, "color": "rust", "font": "title", "weight": 700},
    {"text": "{hh}:{mm}", "y": -0.07, "box": [1.02, 0.55], "px": 27, "color": "ink", "font": "title", "weight": 700, "opacity": "idle"},
    {"text": "{date}", "y": 0.2, "box": [0.969, 0.2], "px": 11.5, "color": "rust", "font": "title", "weight": 700, "opacity": "idle"}
  ],
  "pinbutton": {"in": "hub", "x": -0.17, "y": 0.45, "size": 10.5},
  "settingsbutton": {"in": "hub", "x": 0.17, "y": 0.45, "size": 10.5},
  "draw": {"clock": false, "shadow": false, "text": "ink"},
  "tabs": {"inset": 26, "text": "ink", "fill": "#C9A263/80", "on": "#B3200F"},
  "panel": {"fill": {"type": "radial", "radius": 1.4, "stops": [[0, "#F0DCAD"], [0.7, "#E0C187"], [1, "#B98D4C"]]}, "stroke": "#5A3313", "width": 2.5, "corner": 8, "text": "ink"},
  "tag": {"fill": {"type": "linear", "stops": [[0, "#F0DCAD"], [1, "#D9B678"]]}, "stroke": "#5A3313", "width": 1.8, "corner": 5, "text": "ink"},
  "tile": {"fill": {"type": "linear", "stops": [[0, "#F0DCAD"], [1, "#D3AE6C"]]}, "stroke": "#5A3313", "width": 2, "corner": 5, "text": "ink"},
  "onhover": [
    {"color": "#8A5F2C", "count": 5, "area": "slot", "life": [0.3, 0.6], "size": [1.5, 3], "speed": [20, 70], "outward": true, "dir": [-70, 70], "drag": 2, "fadein": 0, "fadeout": 0.7}
  ],
  "onlaunch": [
    {"image": "coin", "count": 26, "area": "slot", "life": [0.6, 1.1], "size": [9, 17], "speed": [180, 520], "outward": true, "dir": [-70, 70], "gravity": 800, "drag": 1.4, "spin": [-300, 300], "fadein": 0, "fadeout": 0.25}
  ],
  "sounds": {"open": "open.wav", "move": "move.wav", "launch": "launch.wav", "close": "close.wav"}
}
