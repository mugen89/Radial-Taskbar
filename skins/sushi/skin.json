{
  "format": 1,
  "id": "sushi",
  "name": "Sushi Belt",
  "author": "Radial Taskbar",
  "version": "1.0",
  "about": "Plates ride round the counter and chopsticks reach for your choice",
  "tags": ["food", "playful", "wood"],
  "preview": "preview.jpg",
  "style": {"shape": "orb", "material": "solid", "base": "#5A3820", "accent": "#C8372D", "accent2": "#3E8A57", "text": "#FBF3E2", "border": "#E3B97C", "opacity": 0.98, "corner": 8, "font": "Yu Gothic UI", "open": "spin", "speed": 1, "hoverGrow": 2, "iconZoom": 1.14, "glow": 0, "tilt": 0.4, "pointer": false, "burst": false, "shadow": 0.55, "dim": 0.26},
  "wheel": {"hub": 92, "thickness": 96, "gap": 3, "ringgap": 14, "rim": 36, "icon": 42, "crowd": 1.48, "area": 1.4, "hubkeep": 0.6},
  "colors": {"ink": "#33201A", "red": "#C8372D", "cream": "#FBF3E2"},
  "fonts": {"title": "Yu Gothic UI Semibold, Segoe UI Semibold, Segoe UI"},
  "images": {
    "belt": {"file": "belt.jpg", "mask": "belt-mask.png"},
    "bitsheet": {"file": "bitsheet.png", "cols": 4},
    "board": {"file": "board.jpg", "mask": "board-mask.png"},
    "counter": {"file": "counter.jpg", "mask": "counter-mask.png"},
    "plates": {"file": "plates.jpg", "mask": "plates-mask.png", "cols": 4},
    "steam": {"file": "steam.jpg", "light": true},
    "sticks": "sticks.png"
  },
  "back": [
    {"shape": "circle", "x": 0.0, "y": 0.03, "size": 1.08, "fill": {"type": "radial", "stops": [[0, "black/60"], [0.86, "black/51"], [1, "black/0"]]}, "opacity": "sat(open)*0.95"},
    {"image": "counter", "size": 1, "intro": {"time": 0.28, "ease": "out", "scale": 0.9}}
  ],
  "ring": [
    {"image": "belt", "size": "2*(ringout+5)", "in": "px", "rotate": "time*4-(1-open)*60"},
    {"shape": "arc", "in": "px", "from": 0, "r": "ringout+5", "to": 360, "stroke": "#8A8F96", "width": 2.4},
    {"shape": "circle", "in": "px", "size": "2*(ringin-6)", "fill": "#C9975A", "when": "ring==0"},
    {"shape": "arc", "in": "px", "from": 0, "r": "ringin-5", "to": 360, "stroke": "#8A8F96", "width": 2.4}
  ],
  "slot": {
    "intro": {"time": 0.5, "ease": "out", "delay": 0.02, "angle": -70, "scale": 1, "opacity": 0, "stagger": 0.014, "order": "ring"},
    "under": [
      {"image": "plates", "size": "1.12*(1+0.05*hot-0.03*press)", "frame": "(i+ring)%4", "rotate": "time*4+i*20", "detail": 1.06}
    ],
    "icon": {"size": 1.0, "zoom": 1.16, "y": "-0.04*hot", "shadow": {"x": 1, "y": 3, "blur": 4, "color": "black/50"}},
    "over": [
      {"image": "steam", "size": 1.2, "y": "-0.5-0.35*fract(time*0.5)", "opacity": "0.40*hot*(1-fract(time*0.5))"},
      {"image": "steam", "size": 0.9, "x": 0.15, "y": "-0.4-0.4*fract(time*0.5+0.5)", "opacity": "0.40*hot*(1-fract(time*0.5+0.5))"},
      {"shape": "circle", "y": 0.86, "size": 0.16, "fill": "#C8372D", "when": "running", "opacity": "active ? 1 : 0.75", "glow": 4, "glowcolor": "#FFE0B0"},
      {"shape": "circle", "y": 0.86, "size": 0.08800000000000001, "fill": "#FFE0B0", "when": "running", "opacity": "active ? 1 : 0.35+0.35*wave(time*0.5+seed)"},
      {"shape": "circle", "x": 0.7, "y": -0.7, "size": 0.25, "fill": "#FBF3E2", "when": "numbers && number<10 && !kid", "stroke": "#C8372D", "width": 1.2},
      {"text": "{number}", "x": 0.7, "y": -0.71, "em": 0.3, "color": "ink", "font": "title", "weight": 700, "when": "numbers && number<10 && !kid"},
      {"shape": "poly", "points": [[-0.12, -0.738], [0, -0.84], [0.12, -0.738]], "stroke": "#33201A", "width": 2.2, "caps": true, "when": "group"}
    ],
    "marks": false,
    "chevron": false,
    "badge": false
  },
  "over": [
    {"shape": "circle", "x": 0.0, "y": 0.05, "size": 1.16, "fill": {"type": "radial", "stops": [[0, "black/55"], [0.8, "black/47"], [1, "black/0"]]}, "opacity": "sat(open)*0.95", "in": "hub"}
  ],
  "hub": [
    {"image": "board", "size": 1.0, "intro": {"time": 0.34, "ease": "back", "scale": 0.4}},
    {"text": "{title}", "y": -0.04, "box": [1.12, 0.46], "px": 16.5, "color": "ink", "font": "title", "weight": 700, "wrap": true},
    {"text": "{sub}", "y": 0.26, "box": [1.064, 0.2], "px": 11, "color": "red", "font": "title", "weight": 700},
    {"text": "{hh}:{mm}", "y": -0.07, "box": [1.12, 0.55], "px": 29, "color": "ink", "font": "title", "weight": 700, "opacity": "idle"},
    {"text": "{date}", "y": 0.21, "box": [1.064, 0.2], "px": 11.5, "color": "red", "font": "title", "weight": 700, "opacity": "idle"}
  ],
  "front": [
    {"image": "sticks", "size": [0.34, 0.068], "angle": "sel", "radius": "0.80+0.03*sin(time*5)-0.05*launch", "rotate": "sel-90+2*sin(time*5)", "pivot": [0, 0.5], "opacity": "on", "intro": {"time": 0.2, "ease": "back"}}
  ],
  "draw": {"clock": false, "shadow": false, "text": "ink"},
  "tabs": {"inset": 24, "text": "ink", "fill": "#E3C79A/80", "on": "#C8372D"},
  "panel": {"fill": {"type": "linear", "stops": [[0, "#6B4527"], [1, "#452A16"]]}, "stroke": {"type": "linear", "stops": [[0, "#EBC78E"], [1, "#B07C42"]]}, "width": 5, "corner": 8, "text": "cream"},
  "tag": {"fill": {"type": "linear", "stops": [[0, "#FBF6E9"], [1, "#EADFC6"]]}, "stroke": "#C8372D", "width": 1.8, "corner": 5, "text": "ink"},
  "tile": {"fill": {"type": "linear", "stops": [[0, "#FBF6E9"], [1, "#EADFC6"]]}, "stroke": "#5A3820", "width": 2.4, "corner": 7, "text": "ink"},
  "onlaunch": [
    {"image": "bitsheet", "count": 26, "area": "slot", "life": [0.5, 0.9], "size": [5, 10], "speed": [120, 420], "outward": true, "dir": [-90, 90], "gravity": 700, "drag": 1.6, "spin": [-300, 300], "fadein": 0, "fadeout": 0.3}
  ],
  "sounds": {"open": "open.wav", "move": "move.wav", "launch": "launch.wav", "close": "close.wav"}
}
