{
  "format": 1,
  "id": "lacquer",
  "name": "Lacquer Box",
  "author": "Radial Taskbar",
  "version": "1.0",
  "about": "Deep red and black lacquer sprinkled with gold dust; apps rest on black lacquer framed in gold",
  "tags": ["elegant", "red", "gold"],
  "preview": "preview.jpg",
  "style": {"shape": "orb", "material": "solid", "base": "#140606", "accent": "#D4AF5A", "accent2": "#B8202A", "text": "#F2E2B8", "border": "#D4AF5A", "opacity": 0.98, "corner": 14, "font": "Constantia", "open": "fade", "speed": 0.85, "hoverGrow": 3, "iconZoom": 1.12, "glow": 0, "tilt": 0.3, "pointer": false, "burst": false, "shadow": 0.5, "dim": 0.42},
  "wheel": {"hub": 90, "thickness": 92, "gap": 5, "ringgap": 10, "rim": 32, "icon": 42, "crowd": 1.45, "area": 1.1, "hubkeep": 0.76},
  "colors": {"text": "#F2E2B8", "sub": "#C8B07A"},
  "fonts": {"title": "Constantia, Georgia"},
  "images": {
    "box": {"file": "box.jpg", "mask": "box-mask.png"},
    "crest": {"file": "crest.jpg", "mask": "crest-mask.png"},
    "fleck": "fleck.png",
    "halo": {"file": "halo.jpg", "light": true},
    "trays": {"file": "trays.png", "cols": 2}
  },
  "back": [
    {"shape": "circle", "x": 0.0, "y": 0.03, "size": 1.08, "fill": {"type": "radial", "stops": [[0, "black/65"], [0.86, "black/55"], [1, "black/0"]]}, "opacity": "sat(open)*0.95"},
    {"image": "box", "size": 1.0, "intro": {"time": 0.5, "ease": "out", "scale": 0.94}}
  ],
  "slot": {
    "intro": {"time": 0.42, "ease": "back", "delay": 0.06, "scale": 0.3, "stagger": 0.02, "order": "both"},
    "under": [
      {"image": "halo", "size": 1.5, "opacity": "hot*0.5", "when": "hot>0.02", "scale": "(1.5*hot)/1.5"},
      {"image": "trays", "size": "0.94*(1+0.04*hot-0.03*press)", "frame": "(i+ring)%2", "rotate": "a"}
    ],
    "icon": {"size": 0.58, "zoom": 1.14, "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/60"}},
    "over": [
      {"shape": "circle", "y": 0.92, "size": 0.15, "fill": "#D4AF5A", "when": "running", "opacity": "active ? 1 : 0.75", "glow": 4, "glowcolor": "#B8202A"},
      {"shape": "circle", "y": 0.92, "size": 0.0825, "fill": "#B8202A", "when": "running", "opacity": "active ? 1 : 0.35+0.35*wave(time*0.5+seed)"},
      {"shape": "circle", "x": 0.64, "y": -0.64, "size": 0.25, "fill": "#D4AF5A", "when": "numbers && number<10 && !kid"},
      {"text": "{number}", "x": 0.64, "y": -0.65, "em": 0.3, "color": "#140606", "font": "title", "weight": 700, "when": "numbers && number<10 && !kid"},
      {"shape": "poly", "points": [[-0.12, -0.6980000000000001], [0, -0.8], [0.12, -0.6980000000000001]], "stroke": "#F2E2B8", "width": 2.2, "caps": true, "when": "group"}
    ],
    "marks": false,
    "chevron": false,
    "badge": false
  },
  "over": [
    {"image": "fleck", "size": 0.0832, "in": "hub", "angle": "sel", "radius": 1.1, "rotate": "time*30", "opacity": "on", "scale": "(0.07*(1+0.2*sin(time*4)))/0.0832"}
  ],
  "hub": [
    {"image": "crest", "size": 1.0, "intro": {"time": 0.5, "ease": "back", "scale": 0.7}},
    {"text": "{title}", "y": -0.05, "box": [1.26, 0.6], "px": 17, "color": "text", "font": "title", "weight": 700, "wrap": true, "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/80"}},
    {"text": "{sub}", "y": 0.28, "box": [1.1969999999999998, 0.2], "px": 11.5, "color": "sub", "font": "title", "weight": 700, "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/80"}},
    {"text": "{hh}:{mm}", "y": -0.08, "box": [1.26, 0.55], "px": 31, "color": "text", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/80"}},
    {"text": "{date}", "y": 0.21, "box": [1.1969999999999998, 0.2], "px": 12, "color": "sub", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/80"}}
  ],
  "draw": {"clock": false, "shadow": false, "text": "text"},
  "tabs": {"inset": 13, "text": "text", "fill": "#F2E2B8/14", "on": "#D4AF5A/85"},
  "panel": {"fill": {"type": "linear", "stops": [[0, "#2A0A0C"], [1, "#140606"]]}, "stroke": "#D4AF5A", "width": 3, "corner": 14, "text": "text"},
  "tag": {"fill": {"type": "linear", "stops": [[0, "#2A0A0C"], [1, "#140606"]]}, "stroke": "#D4AF5A", "width": 2, "corner": 13, "text": "text"},
  "tile": {"fill": {"type": "linear", "stops": [[0, "#F2E2B8"], [1, "#D8C08A"]]}, "stroke": "#8A6A2A", "width": 2.4, "corner": 12, "text": "#140606"},
  "onlaunch": [
    {"image": "fleck", "count": 20, "area": "slot", "life": [0.5, 1.0], "size": [3, 6], "speed": [40, 180], "outward": true, "dir": [-90, 90], "drag": 2, "spin": [-300, 300], "fadein": 0, "fadeout": 0.5}
  ],
  "sounds": {"open": "open.wav", "move": "move.wav", "launch": "launch.wav", "close": "close.wav"}
}
