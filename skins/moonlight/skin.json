{
  "format": 1,
  "id": "moonlight",
  "name": "Moonlight",
  "author": "Radial Taskbar",
  "version": "1.0",
  "about": "A night sky over a ring of trees; apps sit on the moon's phases while an owl blinks in the dark",
  "tags": ["night", "calm", "blue"],
  "preview": "preview.jpg",
  "style": {"shape": "orb", "material": "solid", "base": "#0A1430", "accent": "#E8E2C8", "accent2": "#9FB8E8", "text": "#F2EEDC", "border": "#E8E2C8", "opacity": 0.98, "corner": 14, "font": "Constantia", "open": "fade", "speed": 0.85, "hoverGrow": 3, "iconZoom": 1.12, "glow": 0, "tilt": 0.3, "pointer": false, "burst": false, "shadow": 0.5, "dim": 0.5},
  "wheel": {"hub": 90, "thickness": 92, "gap": 5, "ringgap": 10, "rim": 32, "icon": 42, "crowd": 1.45, "area": 1.1, "hubkeep": 0.76},
  "colors": {"text": "#F2EEDC", "sub": "#B8C4E0"},
  "fonts": {"title": "Constantia, Georgia"},
  "images": {
    "eyes": {"file": "eyes.jpg", "light": true},
    "halo": {"file": "halo.jpg", "light": true},
    "hub": {"file": "hub.jpg", "mask": "hub-mask.png"},
    "night": {"file": "night.jpg", "mask": "night-mask.png"},
    "phases": {"file": "phases.png", "cols": 8},
    "twinkle": "twinkle.png"
  },
  "back": [
    {"shape": "circle", "x": 0.0, "y": 0.03, "size": 1.08, "fill": {"type": "radial", "stops": [[0, "black/65"], [0.86, "black/55"], [1, "black/0"]]}, "opacity": "sat(open)*0.95"},
    {"image": "night", "size": 1.0, "intro": {"time": 0.5, "ease": "out", "scale": 0.92}},
    {"image": "eyes", "size": 0.1, "x": -0.62, "y": 0.64, "opacity": "0.9*step(0.05,fract(time*0.23))*sat(open)"},
    {"image": "eyes", "size": 0.08, "x": 0.7, "y": 0.52, "opacity": "0.8*step(0.04,fract(time*0.17+0.5))*sat(open)"}
  ],
  "slot": {
    "intro": {"time": 0.42, "ease": "back", "delay": 0.06, "scale": 0.3, "stagger": 0.02, "order": "both"},
    "under": [
      {"image": "halo", "size": 1.5, "opacity": "hot*0.5", "when": "hot>0.02", "scale": "(1.5*hot)/1.5"},
      {"image": "phases", "size": "0.98*(1+0.05*hot-0.04*press)", "frame": "(i+ring)%8"}
    ],
    "icon": {"size": 0.54, "zoom": 1.18, "shadow": {"x": 0, "y": 1, "blur": 4, "color": "#0A1430/80"}},
    "over": [
      {"shape": "circle", "y": 0.92, "size": 0.15, "fill": "#E8E2C8", "when": "running", "opacity": "active ? 1 : 0.75", "glow": 4, "glowcolor": "#9FB8E8"},
      {"shape": "circle", "y": 0.92, "size": 0.0825, "fill": "#9FB8E8", "when": "running", "opacity": "active ? 1 : 0.35+0.35*wave(time*0.5+seed)"},
      {"shape": "circle", "x": 0.64, "y": -0.64, "size": 0.25, "fill": "#E8E2C8", "when": "numbers && number<10 && !kid"},
      {"text": "{number}", "x": 0.64, "y": -0.65, "em": 0.3, "color": "#0A1430", "font": "title", "weight": 700, "when": "numbers && number<10 && !kid"},
      {"shape": "poly", "points": [[-0.12, -0.6980000000000001], [0, -0.8], [0.12, -0.6980000000000001]], "stroke": "#F2EEDC", "width": 2.2, "caps": true, "when": "group"}
    ],
    "marks": false,
    "chevron": false,
    "badge": false
  },
  "over": [
    {"image": "twinkle", "size": 0.108, "in": "hub", "angle": "sel", "radius": 1.1, "rotate": "time*30", "opacity": "on", "scale": "(0.09*(1+0.2*sin(time*5)))/0.108"}
  ],
  "hub": [
    {"image": "hub", "size": 1.0, "intro": {"time": 0.5, "ease": "back", "scale": 0.6}},
    {"text": "{title}", "y": -0.05, "box": [1.26, 0.6], "px": 17, "color": "text", "font": "title", "weight": 700, "wrap": true, "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/70"}},
    {"text": "{sub}", "y": 0.28, "box": [1.1969999999999998, 0.2], "px": 11.5, "color": "sub", "font": "title", "weight": 700, "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/70"}},
    {"text": "{hh}:{mm}", "y": -0.08, "box": [1.26, 0.55], "px": 31, "color": "text", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/70"}},
    {"text": "{date}", "y": 0.21, "box": [1.1969999999999998, 0.2], "px": 12, "color": "sub", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/70"}}
  ],
  "draw": {"clock": false, "shadow": false, "text": "text"},
  "tabs": {"inset": 13, "text": "text", "fill": "#F2EEDC/14", "on": "#E8E2C8/85"},
  "panel": {"fill": {"type": "linear", "stops": [[0, "#1A2A5A"], [1, "#0A1430"]]}, "stroke": "#9FB8E8", "width": 3, "corner": 14, "text": "text"},
  "tag": {"fill": {"type": "linear", "stops": [[0, "#1A2A5A"], [1, "#0A1430"]]}, "stroke": "#9FB8E8", "width": 2, "corner": 13, "text": "text"},
  "tile": {"fill": {"type": "linear", "stops": [[0, "#F2EEDC"], [1, "#D8D2BC"]]}, "stroke": "#6A7AA8", "width": 2.4, "corner": 12, "text": "#0A1430"},
  "onlaunch": [
    {"image": "twinkle", "count": 16, "area": "slot", "life": [0.5, 1.0], "size": [5, 10], "speed": [50, 200], "outward": true, "dir": [-100, 100], "drag": 1.5, "spin": [-200, 200], "fadein": 0, "fadeout": 0.5}
  ],
  "sounds": {"open": "open.wav", "move": "move.wav", "launch": "launch.wav", "close": "close.wav"},
  "screen": {"effect": "fireflies", "color": "#C8E070", "color2": "#FFF6B0", "density": 0.6, "speed": 0.5, "size": 0.8}
}
