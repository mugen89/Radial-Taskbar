{
  "format": 1,
  "id": "rain",
  "name": "Digital Rain",
  "author": "Radial Taskbar",
  "version": "1.0",
  "about": "Green signs pour down the screen behind a dark glass terminal wheel",
  "tags": ["code", "terminal", "dark"],
  "preview": "preview.jpg",
  "style": {"shape": "hex", "material": "solid", "base": "#020A05", "accent": "#3DFF7A", "accent2": "#D8FFE4", "text": "#D8FFE4", "border": "#3DFF7A", "opacity": 0.98, "corner": 14, "font": "Consolas", "open": "zoom", "speed": 1.1, "hoverGrow": 3, "iconZoom": 1.12, "glow": 0, "tilt": 0.2, "pointer": false, "burst": false, "shadow": 0.5, "dim": 0.86},
  "wheel": {"hub": 90, "thickness": 92, "gap": 5, "ringgap": 10, "rim": 32, "icon": 42, "crowd": 1.45, "area": 1.1, "hubkeep": 0.76},
  "colors": {"text": "#D8FFE4", "sub": "#7DFFA6"},
  "fonts": {"title": "Consolas"},
  "images": {
    "caret": "caret.png",
    "disc": {"file": "disc.jpg", "mask": "disc-mask.png"},
    "halo": {"file": "halo.jpg", "light": true},
    "hub": {"file": "hub.jpg", "mask": "hub-mask.png"},
    "pulse": {"file": "pulse.jpg", "light": true},
    "tiles": {"file": "tiles.png", "cols": 2}
  },
  "back": [
    {"shape": "circle", "x": 0.0, "y": 0.02, "size": 1.08, "fill": {"type": "radial", "stops": [[0, "black/70"], [0.86, "black/60"], [1, "black/0"]]}, "opacity": "sat(open)*0.95"},
    {"image": "disc", "size": 1, "rotate": "(1-open)*-25", "intro": {"time": 0.3, "ease": "out", "scale": 0.9}},
    {"image": "pulse", "size": 1.35, "opacity": "0.5*(1-fract(time*0.4))", "scale": "(1.05+0.3*fract(time*0.4))/1.35"}
  ],
  "slot": {
    "intro": {"time": 0.42, "ease": "back", "delay": 0.06, "scale": 0.3, "stagger": 0.02, "order": "both"},
    "under": [
      {"image": "halo", "size": 1.7, "opacity": "hot*0.9", "when": "hot>0.02", "scale": "(1.7*hot)/1.7"},
      {"image": "tiles", "size": "0.98*(1+0.05*hot-0.04*press)", "frame": "hot>0.5 ? 1 : 0"}
    ],
    "icon": {"size": 0.86, "zoom": 1.12, "tone": "original", "shadow": {"x": 0, "y": 0, "blur": 6, "color": "#3DFF7A/45"}},
    "over": [
      {"shape": "circle", "y": 0.92, "size": 0.15, "fill": "#3DFF7A", "when": "running", "opacity": "active ? 1 : 0.75", "glow": 4, "glowcolor": "#D8FFE4"},
      {"shape": "circle", "y": 0.92, "size": 0.0825, "fill": "#D8FFE4", "when": "running", "opacity": "active ? 1 : 0.35+0.35*wave(time*0.5+seed)"},
      {"shape": "circle", "x": 0.64, "y": -0.64, "size": 0.25, "fill": "#3DFF7A", "when": "numbers && number<10 && !kid"},
      {"text": "{number}", "x": 0.64, "y": -0.65, "em": 0.3, "color": "#021006", "font": "title", "weight": 700, "when": "numbers && number<10 && !kid"},
      {"shape": "poly", "points": [[-0.12, -0.6980000000000001], [0, -0.8], [0.12, -0.6980000000000001]], "stroke": "#D8FFE4", "width": 2.2, "caps": true, "when": "group"}
    ],
    "marks": false,
    "chevron": false,
    "badge": false
  },
  "over": [
    {"image": "caret", "size": 0.16, "in": "hub", "angle": "sel", "radius": 1.1, "rotate": "sel-90", "opacity": "on"}
  ],
  "hub": [
    {"image": "hub", "size": 1.0, "intro": {"time": 0.35, "ease": "back", "scale": 0.6}},
    {"text": "{title}", "y": -0.05, "box": [1.26, 0.6], "px": 17, "color": "text", "font": "title", "weight": 700, "wrap": true, "shadow": {"x": 0, "y": 0, "blur": 6, "color": "#3DFF7A/70"}},
    {"text": "{sub}", "y": 0.28, "box": [1.178, 0.2], "px": 11.5, "color": "sub", "font": "title", "weight": 700, "shadow": {"x": 0, "y": 0, "blur": 6, "color": "#3DFF7A/70"}},
    {"text": "{hh}:{mm}", "y": -0.08, "box": [1.24, 0.55], "px": 31, "color": "text", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 0, "blur": 6, "color": "#3DFF7A/70"}},
    {"text": "{date}", "y": 0.21, "box": [1.178, 0.2], "px": 12, "color": "sub", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 0, "blur": 6, "color": "#3DFF7A/70"}}
  ],
  "draw": {"clock": false, "shadow": false, "text": "text"},
  "tabs": {"inset": 13, "text": "text", "fill": "#D8FFE4/14", "on": "#3DFF7A/85"},
  "panel": {"fill": {"type": "linear", "stops": [[0, "#06180C"], [1, "#020803"]]}, "stroke": "#3DFF7A", "width": 3, "corner": 14, "text": "text"},
  "tag": {"fill": {"type": "linear", "stops": [[0, "#06180C"], [1, "#020803"]]}, "stroke": "#3DFF7A", "width": 2, "corner": 13, "text": "text"},
  "tile": {"fill": {"type": "linear", "stops": [[0, "#0A2413"], [1, "#04120A"]]}, "stroke": "#3DFF7A", "width": 2.4, "corner": 12, "text": "#D8FFE4"},
  "onhover": [
    {"color": "#3DFF7A", "count": 6, "area": "slot", "life": [0.2, 0.5], "size": [1, 2], "speed": [20, 90], "outward": true, "dir": [-70, 70], "drag": 3, "fadein": 0, "fadeout": 0.7}
  ],
  "onlaunch": [
    {"color": "#3DFF7A", "count": 40, "area": "slot", "life": [0.3, 0.8], "size": [1.5, 3.5], "speed": [80, 380], "outward": true, "dir": [-100, 100], "drag": 2.2, "fadein": 0, "fadeout": 0.6}
  ],
  "sounds": {"open": "open.wav", "move": "move.wav", "launch": "launch.wav", "close": "close.wav"},
  "screen": {"effect": "rain", "color": "#3DFF7A", "color2": "#D8FFE4", "density": 1.0, "speed": 1.0, "size": 1.0}
}
