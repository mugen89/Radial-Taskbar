{
  "format": 1,
  "id": "elven",
  "name": "Elven Grove",
  "author": "Radial Taskbar",
  "version": "1.0",
  "about": "A silver tree spreads over a moonlit grove; apps ride on its leaves while fireflies gather",
  "tags": ["fantasy", "nature", "calm"],
  "preview": "preview.jpg",
  "style": {"shape": "orb", "material": "solid", "base": "#0C1F1C", "accent": "#C9E6D8", "accent2": "#E8D58A", "text": "#EEF6F0", "border": "#C9E6D8", "opacity": 0.98, "corner": 14, "font": "Gabriola", "open": "bloom", "speed": 0.9, "hoverGrow": 3, "iconZoom": 1.12, "glow": 0, "tilt": 0.3, "pointer": false, "burst": false, "shadow": 0.5, "dim": 0.48},
  "wheel": {"hub": 90, "thickness": 92, "gap": 5, "ringgap": 10, "rim": 32, "icon": 42, "crowd": 1.45, "area": 1.1, "hubkeep": 0.76},
  "colors": {"text": "#EEF6F0", "sub": "#B8D0C4"},
  "fonts": {"title": "Gabriola, Constantia"},
  "images": {
    "firefly": "firefly.png",
    "grove": {"file": "grove.jpg", "mask": "grove-mask.png"},
    "halo": {"file": "halo.jpg", "light": true},
    "leaves": {"file": "leaves.png", "cols": 4},
    "moon": {"file": "moon.jpg", "mask": "moon-mask.png"}
  },
  "back": [
    {"shape": "circle", "x": 0.0, "y": 0.03, "size": 1.08, "fill": {"type": "radial", "stops": [[0, "black/60"], [0.86, "black/51"], [1, "black/0"]]}, "opacity": "sat(open)*0.95"},
    {"image": "grove", "size": 1.0, "rotate": "(1-open)*-12", "intro": {"time": 0.5, "ease": "out", "scale": 0.9}}
  ],
  "slot": {
    "intro": {"time": 0.42, "ease": "back", "delay": 0.06, "scale": 0.3, "stagger": 0.02, "order": "both"},
    "under": [
      {"image": "halo", "size": 1.6, "opacity": "hot*0.5", "when": "hot>0.02", "scale": "(1.6*hot)/1.6"},
      {"image": "leaves", "size": "1.08*(1+0.05*hot-0.04*press)", "frame": "(i+ring)%4", "rotate": "a+4*sin(time*1.6+seed*6)"}
    ],
    "icon": {"size": 0.56, "zoom": 1.18, "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/50"}},
    "over": [
      {"shape": "circle", "y": 0.92, "size": 0.15, "fill": "#C9E6D8", "when": "running", "opacity": "active ? 1 : 0.75", "glow": 4, "glowcolor": "#E8D58A"},
      {"shape": "circle", "y": 0.92, "size": 0.0825, "fill": "#E8D58A", "when": "running", "opacity": "active ? 1 : 0.35+0.35*wave(time*0.5+seed)"},
      {"shape": "circle", "x": 0.64, "y": -0.64, "size": 0.25, "fill": "#E8D58A", "when": "numbers && number<10 && !kid"},
      {"text": "{number}", "x": 0.64, "y": -0.65, "em": 0.3, "color": "#0C1F1C", "font": "title", "weight": 700, "when": "numbers && number<10 && !kid"},
      {"shape": "poly", "points": [[-0.12, -0.6980000000000001], [0, -0.8], [0.12, -0.6980000000000001]], "stroke": "#EEF6F0", "width": 2.2, "caps": true, "when": "group"}
    ],
    "marks": false,
    "chevron": false,
    "badge": false
  },
  "over": [
    {"image": "firefly", "size": 0.13, "in": "hub", "angle": "sel+8*sin(time*3)", "radius": "1.12+0.04*sin(time*2.3)", "opacity": "on", "scale": "(0.10*(1+0.3*sin(time*6)))/0.13"}
  ],
  "hub": [
    {"image": "moon", "size": 1.0, "intro": {"time": 0.5, "ease": "back", "scale": 0.6}},
    {"text": "{title}", "y": -0.05, "box": [1.26, 0.6], "px": 20, "color": "text", "font": "title", "weight": 700, "wrap": true, "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/70"}},
    {"text": "{sub}", "y": 0.28, "box": [1.178, 0.2], "px": 11.5, "color": "sub", "font": "title", "weight": 700, "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/70"}},
    {"text": "{hh}:{mm}", "y": -0.08, "box": [1.24, 0.55], "px": 34, "color": "text", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/70"}},
    {"text": "{date}", "y": 0.21, "box": [1.178, 0.2], "px": 14, "color": "sub", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 1, "blur": 3, "color": "black/70"}}
  ],
  "draw": {"clock": false, "shadow": false, "text": "text"},
  "tabs": {"inset": 13, "text": "text", "fill": "#EEF6F0/14", "on": "#C9E6D8/85"},
  "panel": {"fill": {"type": "linear", "stops": [[0, "#1A3430"], [1, "#0C1F1C"]]}, "stroke": "#C9E6D8", "width": 3, "corner": 14, "text": "text"},
  "tag": {"fill": {"type": "linear", "stops": [[0, "#1A3430"], [1, "#0C1F1C"]]}, "stroke": "#C9E6D8", "width": 2, "corner": 13, "text": "text"},
  "tile": {"fill": {"type": "linear", "stops": [[0, "#EEF6F0"], [1, "#CFE2D8"]]}, "stroke": "#8AB8A4", "width": 2.4, "corner": 12, "text": "#0C1F1C"},
  "onhover": [
    {"image": "firefly", "count": 6, "area": "slot", "life": [0.6, 1.2], "size": [3, 6], "speed": [10, 40], "dir": [-180, 180], "swirl": 90, "fadein": 0.2, "fadeout": 0.5}
  ],
  "onlaunch": [
    {"image": "firefly", "count": 22, "area": "slot", "life": [0.6, 1.3], "size": [3, 7], "speed": [60, 200], "outward": true, "dir": [-100, 100], "drag": 1.5, "fadein": 0, "fadeout": 0.5}
  ],
  "sounds": {"open": "open.wav", "move": "move.wav", "launch": "launch.wav", "close": "close.wav"},
  "screen": {"effect": "fireflies", "color": "#C8F070", "color2": "#FFF6B0", "density": 1.0, "speed": 0.7, "size": 1.0}
}
