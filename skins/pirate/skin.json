{
  "format": 1,
  "id": "pirate",
  "name": "Ship's Wheel",
  "author": "Radial Taskbar",
  "version": "1.0",
  "about": "A mahogany helm over the deep sea; apps ride on gold coins, a brass compass sits in the middle",
  "tags": ["sea", "adventure", "warm"],
  "preview": "preview.jpg",
  "style": {"shape": "orb", "material": "solid", "base": "#0E2A38", "accent": "#D9A441", "accent2": "#F2D58A", "text": "#3A2410", "border": "#D9A441", "opacity": 0.98, "corner": 14, "font": "Constantia", "open": "spin", "speed": 1, "hoverGrow": 3, "iconZoom": 1.12, "glow": 0, "tilt": 0.35, "pointer": false, "burst": false, "shadow": 0.5, "dim": 0.36},
  "wheel": {"hub": 90, "thickness": 92, "gap": 5, "ringgap": 10, "rim": 32, "icon": 42, "crowd": 1.45, "area": 1.1, "hubkeep": 0.76},
  "colors": {"text": "#3A2410", "sub": "#6A4A20"},
  "fonts": {"title": "Constantia, Georgia"},
  "images": {
    "coins": {"file": "coins.png", "cols": 2},
    "compass": {"file": "compass.jpg", "mask": "compass-mask.png"},
    "halo": {"file": "halo.jpg", "light": true},
    "helm": {"file": "helm.jpg", "mask": "helm-mask.png"},
    "needle": "needle.png",
    "sea": {"file": "sea.jpg", "mask": "sea-mask.png"}
  },
  "back": [
    {"shape": "circle", "x": 0.0, "y": 0.03, "size": 1.16, "fill": {"type": "radial", "stops": [[0, "black/60"], [0.86, "black/51"], [1, "black/0"]]}, "opacity": "sat(open)*0.95"},
    {"image": "sea", "size": 1.0, "intro": {"time": 0.35, "ease": "out", "scale": 0.94}},
    {"image": "helm", "size": 1.12, "rotate": "(1-open)*-200+2*sin(time*0.8)", "intro": {"time": 0.6, "ease": "out", "scale": 0.9}}
  ],
  "slot": {
    "intro": {"time": 0.42, "ease": "back", "delay": 0.06, "scale": 0.3, "stagger": 0.02, "order": "both"},
    "under": [
      {"image": "halo", "size": 1.6, "opacity": "hot*0.7", "when": "hot>0.02", "scale": "(1.6*hot)/1.6"},
      {"shape": "circle", "x": 0.0, "y": 0.06, "size": 1.0, "fill": {"type": "radial", "stops": [[0, "black/45"], [0.86, "black/38"], [1, "black/0"]]}, "opacity": "sat(open)*0.95"},
      {"image": "coins", "size": "0.98*(1+0.05*hot-0.04*press)", "frame": "ring>0 ? 1 : 0", "rotate": "seed*360"}
    ],
    "icon": {"size": 0.62, "zoom": 1.16, "shadow": {"x": 0, "y": 1, "blur": 2, "color": "black/50"}},
    "over": [
      {"shape": "circle", "y": 0.92, "size": 0.15, "fill": "#D9A441", "when": "running", "opacity": "active ? 1 : 0.75", "glow": 4, "glowcolor": "#F2D58A"},
      {"shape": "circle", "y": 0.92, "size": 0.0825, "fill": "#F2D58A", "when": "running", "opacity": "active ? 1 : 0.35+0.35*wave(time*0.5+seed)"},
      {"shape": "circle", "x": 0.64, "y": -0.64, "size": 0.25, "fill": "#D9A441", "when": "numbers && number<10 && !kid"},
      {"text": "{number}", "x": 0.64, "y": -0.65, "em": 0.3, "color": "#341A0C", "font": "title", "weight": 700, "when": "numbers && number<10 && !kid"},
      {"shape": "poly", "points": [[-0.12, -0.6980000000000001], [0, -0.8], [0.12, -0.6980000000000001]], "stroke": "#3A2410", "width": 2.2, "caps": true, "when": "group"}
    ],
    "marks": false,
    "chevron": false,
    "badge": false
  },
  "over": [
    {"image": "needle", "size": [0.05, 0.13], "in": "hub", "angle": "sel", "radius": 1.12, "rotate": "sel", "opacity": "on"}
  ],
  "hub": [
    {"image": "compass", "size": 1.0, "intro": {"time": 0.45, "ease": "back", "scale": 0.6}},
    {"text": "{title}", "y": -0.05, "box": [1.26, 0.6], "px": 17, "color": "text", "font": "title", "weight": 700, "wrap": true, "shadow": {"x": 0, "y": 0, "blur": 3, "color": "#F2E2BC"}},
    {"text": "{sub}", "y": 0.28, "box": [1.178, 0.2], "px": 11.5, "color": "sub", "font": "title", "weight": 700, "shadow": {"x": 0, "y": 0, "blur": 3, "color": "#F2E2BC"}},
    {"text": "{hh}:{mm}", "y": -0.08, "box": [1.24, 0.55], "px": 31, "color": "text", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 0, "blur": 3, "color": "#F2E2BC"}},
    {"text": "{date}", "y": 0.21, "box": [1.178, 0.2], "px": 12, "color": "sub", "font": "title", "weight": 700, "opacity": "idle", "shadow": {"x": 0, "y": 0, "blur": 3, "color": "#F2E2BC"}}
  ],
  "draw": {"clock": false, "shadow": false, "text": "text"},
  "tabs": {"inset": 13, "text": "#F6E6C4", "fill": "#FFFFFF/14", "on": "#D9A441/85"},
  "panel": {"fill": {"type": "linear", "stops": [[0, "#5A2E18"], [1, "#341A0C"]]}, "stroke": "#D9A441", "width": 3, "corner": 14, "text": "#F6E6C4"},
  "tag": {"fill": {"type": "linear", "stops": [[0, "#5A2E18"], [1, "#341A0C"]]}, "stroke": "#D9A441", "width": 2, "corner": 13, "text": "#F6E6C4"},
  "tile": {"fill": {"type": "linear", "stops": [[0, "#F2E2BC"], [1, "#D9C08A"]]}, "stroke": "#8A6430", "width": 2.4, "corner": 12, "text": "#3A2410"},
  "onlaunch": [
    {"color": "#FFD86A", "count": 24, "area": "slot", "life": [0.4, 0.9], "size": [1.5, 3.5], "speed": [80, 300], "outward": true, "dir": [-90, 90], "gravity": 300, "fadein": 0, "fadeout": 0.5}
  ],
  "sounds": {"open": "open.wav", "move": "move.wav", "launch": "launch.wav", "close": "close.wav"}
}
